<!-- 统计页 -->
<view class="stats-page">
  <view class="month-picker">
    <view class="month-arrow" bindtap="prevMonth">‹</view>
    <text class="month-text">{{displayMonth}}</text>
    <view class="month-arrow" bindtap="nextMonth">›</view>
  </view>

  <view class="seg-toggle">
    <view class="seg-item {{statsType === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="switchType">支出</view>
    <view class="seg-item {{statsType === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="switchType">收入</view>
  </view>

  <view class="donut-card">
    <view class="donut">
      <view class="donut-center">
        <text class="donut-label">{{statsType === 'expense' ? '总支出' : '总收入'}}</text>
        <text class="donut-total">¥{{totalAmount}}</text>
      </view>
    </view>

    <view class="legend">
      <view wx:for="{{legendData}}" wx:key="name" class="legend-item">
        <view class="legend-dot" style="background: {{item.color}}"></view>
        <text class="legend-name">{{item.name}}</text>
        <text class="legend-pct">{{item.percent}}%</text>
      </view>
      <view wx:if="{{legendData.length === 0}}" class="legend-empty">暂无数据</view>
    </view>
  </view>

  <view class="trend-card">
    <view class="trend-header">
      <text class="trend-title">近 6 个月{{statsType === 'expense' ? '支出' : '收入'}}</text>
    </view>
    <view class="trend-bars">
      <view wx:for="{{trendData}}" wx:key="monthKey" class="trend-col">
        <view class="trend-amount {{item.hasData ? '' : 'is-muted'}}">{{item.hasData ? '¥' + item.amount : ''}}</view>
        <view class="trend-bar-wrap">
          <view class="trend-bar {{item.isSelected ? 'is-selected' : ''}} {{item.hasData ? '' : 'is-empty'}}" style="height: {{item.hasData ? item.percent : 4}}%"></view>
        </view>
        <view class="trend-month {{item.isSelected ? 'is-selected' : ''}}">{{item.monthLabel}}</view>
      </view>
    </view>
  </view>

  <view class="ai-section">
    <view class="ai-header-row">
      <view class="ai-section-title">小橘的便签</view>
      <button class="ai-refresh-btn" size="mini" bindtap="refreshAIComments">✨ 催小橘更新</button>
    </view>
    <!-- <text wx:if="{{aiDebugText}}" class="ai-debug-text">{{aiDebugText}}</text> -->

    <view class="ai-card">
      <view class="ai-card-stamp ai-card-stamp--daily"><text class="ai-card-emoji">📅</text></view>
      <text class="ai-card-label">昨日回顾</text>
      <text class="ai-card-text {{dailyLoading ? 'is-loading' : ''}}">{{dailyLoading ? '小橘正在琢磨…' : dailyComment}}</text>
      <view class="ai-card-divider"></view>
      <text class="ai-card-disclaimer">以上内容由腾讯混元AI生成，仅供娱乐参考</text>
    </view>

    <view class="ai-card">
      <view class="ai-card-stamp ai-card-stamp--weekly"><text class="ai-card-emoji">📊</text></view>
      <text class="ai-card-label">上周回顾</text>
      <text class="ai-card-text {{weeklyLoading ? 'is-loading' : ''}}">{{weeklyLoading ? '小橘正在琢磨…' : weeklyComment}}</text>
      <view class="ai-card-divider"></view>
      <text class="ai-card-disclaimer">以上内容由腾讯混元AI生成，仅供娱乐参考</text>
    </view>

    <view class="ai-card">
      <view class="ai-card-stamp ai-card-stamp--monthly"><text class="ai-card-emoji">📈</text></view>
      <text class="ai-card-label">上月回顾</text>
      <text class="ai-card-text {{monthlyLoading ? 'is-loading' : ''}}">{{monthlyLoading ? '小橘正在琢磨…' : monthlyComment}}</text>
      <view class="ai-card-divider"></view>
      <text class="ai-card-disclaimer">以上内容由腾讯混元AI生成，仅供娱乐参考</text>
    </view>
  </view>
</view>
