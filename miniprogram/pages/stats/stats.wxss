.stats-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.month-picker {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  padding: 32rpx 0; background: var(--color-surface);
  border-radius: var(--radius-lg); margin-top: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(120,86,85,0.03);
}
.month-arrow { font-size: 36rpx; color: var(--color-text-secondary); padding: 8rpx; }
.month-text { font-size: 34rpx; font-weight: 600; color: var(--color-text); }
/* 环形图占位 */
.donut-card {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(120,86,85,0.06); padding: var(--space-lg); margin-top: 24rpx;
  display: flex; flex-direction: column; align-items: center;
}
.donut {
  width: 280rpx; height: 280rpx; border-radius: 50%;
  background: conic-gradient(#e8bcba 0% 45%, #f5dddc 45% 70%, #cee9da 70% 85%, #e9e1df 85% 100%);
  display: flex; align-items: center; justify-content: center; margin-bottom: 32rpx;
}
.donut-center {
  width: 200rpx; height: 200rpx; border-radius: 50%; background: white;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.donut-label { font-size: 22rpx; color: var(--color-text-secondary); }
.donut-total { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.legend { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 12rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { flex: 1; font-size: 26rpx; color: var(--color-text); }
.legend-pct { font-size: 26rpx; font-weight: 600; color: var(--color-text-secondary); }
.legend-empty { grid-column: 1/-1; text-align: center; color: var(--color-text-tertiary); padding: 40rpx 0; }

/* 收入/支出 segment toggle */
.seg-toggle {
  display: flex;
  margin-top: 16rpx;
  padding: 6rpx;
  background: var(--color-surface-low);
  border-radius: var(--radius-full);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  transition: background 0.18s ease, color 0.18s ease;
}
.seg-item.is-active {
  background: var(--color-surface);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(120, 86, 85, 0.08);
}

/* 6 个月趋势 */
.trend-card {
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(120, 86, 85, 0.06);
  padding: var(--space-lg) var(--space-md);
  margin-top: 24rpx;
}
.trend-header {
  padding: 0 8rpx 16rpx;
}
.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 260rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.trend-amount {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  height: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
}
.trend-amount.is-muted { color: transparent; }
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 4rpx 0;
}
.trend-bar {
  width: 70%;
  min-height: 4rpx;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  background: var(--color-primary-light, #f5dddc);
  transition: height 0.3s ease;
}
.trend-bar.is-selected {
  background: var(--color-primary);
}
.trend-bar.is-empty {
  background: var(--color-surface-low);
}
.trend-month {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.trend-month.is-selected {
  color: var(--color-primary);
  font-weight: 600;
}

/* 小橘的便签 — AI 评论区（Dusty Rose） */
.ai-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}
.ai-section-title {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 0 8rpx;
  letter-spacing: 2rpx;
  opacity: 0.7;
}

.ai-card {
  position: relative;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow:
    0 2rpx 8rpx rgba(168, 119, 117, 0.06),
    0 12rpx 32rpx rgba(168, 119, 117, 0.08);
}
.ai-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 3rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  opacity: 0.45;
}

.ai-card-stamp {
  width: fit-content;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.ai-card-stamp--daily   { background: rgba(232, 188, 186, 0.35); }
.ai-card-stamp--weekly  { background: rgba(245, 221, 220, 0.55); }
.ai-card-stamp--monthly { background: rgba(216, 193, 192, 0.45); }
.ai-card-emoji {
  font-size: 36rpx;
  line-height: 1;
  display: inline-block;
  vertical-align: middle;
}

.ai-card-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  letter-spacing: 1rpx;
  opacity: 0.7;
  margin-bottom: 16rpx;
}

.ai-card-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.75;
  letter-spacing: 0.5rpx;
  margin-bottom: 24rpx;
}
.ai-card-text.is-loading {
  font-style: italic;
  font-weight: 400;
  color: var(--color-text-tertiary);
  animation: juji-breathe 2.4s ease-in-out infinite alternate;
}
@keyframes juji-breathe {
  from { opacity: 0.5; }
  to   { opacity: 1; }
}

.ai-card-divider {
  margin: 0 8rpx 18rpx;
  height: 0;
  border-top: 2rpx dashed rgba(212, 195, 194, 0.5);
}
.ai-card-disclaimer {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.ai-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ai-refresh-btn {
  background: #f5dddc;
  color: #785655;
  border: none;
  border-radius: 999rpx;
  line-height: 1.5;
  padding: 0 20rpx;
  font-size: 22rpx;
}
.legend-item--hover { opacity: 0.7; }

.retry-banner {
  text-align: center; padding: 24rpx; margin-top: 16rpx;
  font-size: 26rpx; color: var(--color-text-tertiary);
  border-top: 2rpx dashed rgba(212,195,194,0.5);
}
.ai-debug-text {
  font-size: 22rpx;
  color: #7e6a69;
  padding: 0 8rpx;
  line-height: 1.4;
}
