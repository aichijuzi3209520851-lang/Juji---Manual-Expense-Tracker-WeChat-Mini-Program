.stats-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.month-picker {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  padding: 36rpx 0; background: var(--gradient-hero);
  border-radius: var(--radius-2xl); margin-top: 24rpx;
  box-shadow: var(--shadow-hero);
  position: relative; overflow: hidden;
}
.month-picker::before {
  content: '';
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 160rpx; height: 160rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.month-arrow { font-size: 40rpx; color: var(--color-on-primary); padding: 8rpx; opacity: 0.85; position: relative; z-index: 1; }
.month-text { font-size: 36rpx; font-weight: 700; color: var(--color-on-primary); position: relative; z-index: 1; letter-spacing: 2rpx; }
/* 环形图占位 */
.donut-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: var(--space-lg); margin-top: 24rpx;
  display: flex; flex-direction: column; align-items: center;
}
.donut-wrap {
  width: 300rpx; height: 300rpx; position: relative;
  margin-bottom: 36rpx;
}
.donut-canvas {
  width: 300rpx; height: 300rpx;
}
.donut-center {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  pointer-events: none;
}
.donut-label { font-size: var(--font-size-small); color: var(--color-text-secondary); }
.donut-total { font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); font-family: var(--font-numeric); color: var(--color-primary); }
.legend { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 12rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { flex: 1; font-size: var(--font-size-regular); color: var(--color-text); }
.legend-pct { font-size: var(--font-size-regular); font-weight: var(--font-weight-semibold); color: var(--color-text-secondary); }
.legend-empty { grid-column: 1/-1; text-align: center; color: var(--color-text-tertiary); padding: 40rpx 0; }

/* 收入/支出 segment toggle */
.seg-toggle {
  display: flex;
  margin-top: 20rpx;
  padding: 6rpx;
  background: var(--color-primary-container);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-soft);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--color-primary);
  border-radius: var(--radius-full);
  transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  opacity: 0.7;
}
.seg-item.is-active {
  background: var(--color-surface);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx var(--shadow-dark);
  opacity: 1;
}

/* 6 个月趋势 */
.trend-card {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card);
  padding: var(--space-lg) var(--space-md);
  margin-top: 24rpx;
}
.trend-header {
  padding: 0 8rpx 16rpx;
}
.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 260rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.trend-amount {
  font-size: var(--font-size-tiny);
  color: var(--color-text-tertiary);
  height: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
}
.trend-amount.is-muted { color: transparent; }
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 4rpx 0;
}
.trend-bar {
  width: 70%;
  min-height: 4rpx;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  background: var(--color-primary-container);
  transition: height 0.3s ease;
}
.trend-bar.is-selected {
  background: var(--gradient-hero);
}
.trend-bar.is-empty {
  background: var(--color-surface-low);
}
.trend-month {
  margin-top: 8rpx;
  font-size: var(--font-size-small);
  color: var(--color-text-tertiary);
}
.trend-month.is-selected {
  color: var(--color-primary);
  font-weight: 600;
}

/* 小橘的便签 — AI 评论区（Dusty Rose） */
.ai-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}
.ai-section-title {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 0 8rpx;
  letter-spacing: 2rpx;
  opacity: 0.7;
}

.ai-card {
  position: relative;
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-card);
}
.ai-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--gradient-hero);
}

.ai-card-stamp {
  width: fit-content;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-md);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  background: var(--color-primary-container);
}
.ai-card-stamp--daily   { background: var(--color-primary-container); }
.ai-card-stamp--weekly  { background: var(--color-secondary-container); }
.ai-card-stamp--monthly { background: var(--color-tertiary-container); }
.ai-card-emoji {
  font-size: 36rpx;
  line-height: 1;
  display: inline-block;
  vertical-align: middle;
}

.ai-card-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  letter-spacing: 1rpx;
  opacity: 0.7;
  margin-bottom: 16rpx;
}

.ai-card-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.75;
  letter-spacing: 0.5rpx;
  margin-bottom: 24rpx;
}
.ai-card-text.is-loading {
  font-style: italic;
  font-weight: 400;
  color: var(--color-text-tertiary);
  animation: juji-breathe 2.4s ease-in-out infinite alternate;
}
@keyframes juji-breathe {
  from { opacity: 0.5; }
  to   { opacity: 1; }
}

.ai-card-divider {
  margin: 0 8rpx 18rpx;
  height: 0;
  border-top: 2rpx dashed var(--color-border);
}
.ai-card-disclaimer {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.ai-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ai-refresh-btn {
  background: var(--color-primary-container);
  color: var(--color-primary);
  border: none;
  border-radius: 999rpx;
  line-height: 1.5;
  padding: 0 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.legend-item--hover { opacity: 0.7; }

.retry-banner {
  text-align: center; padding: 24rpx; margin-top: 16rpx;
  font-size: 26rpx; color: var(--color-text-tertiary);
  border-top: 2rpx dashed var(--color-border);
}
.ai-debug-text {
  font-size: 22rpx;
  color: #7e6a69;
  padding: 0 8rpx;
  line-height: 1.4;
}
