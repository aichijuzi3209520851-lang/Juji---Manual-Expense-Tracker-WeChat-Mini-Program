<!-- 首页 -->
<view class="home-page" style="{{themeStyle}}">

  <!-- 季节 -->
  <view class="season-bar">
    <text class="season-text">{{season}}</text>
  </view>

  <!-- 昨日 / 今日 -->
  <view class="day-card">
    <view class="day-item">
      <text class="day-label">昨天</text>
      <text class="day-value muted">-¥{{yesterdayExpense}}</text>
      <text class="day-income">+¥{{yesterdayIncome}}</text>
    </view>
    <view class="day-divider"></view>
    <view class="day-item">
      <text class="day-label">今天</text>
      <text class="day-value">-¥{{todayExpense}}</text>
      <text class="day-income">+¥{{todayIncome}}</text>
    </view>
  </view>

  <!-- 预算 chip（点击展开底部抽屉） -->
  <view class="budget-chip budget-chip--{{budget.status}}" bindtap="openBudgetSheet" hover-class="budget-chip--hover">
    <view class="budget-chip-dot {{budget.status === 'over' ? 'is-over' : ''}}"></view>
    <block wx:if="{{budget.status === 'unset'}}">
      <text class="budget-chip-text">还没设本月预算</text>
      <text class="budget-chip-cta">去设定 ›</text>
    </block>
    <block wx:elif="{{budget.status === 'normal'}}">
      <text class="budget-chip-text">本月预算 · 剩 ¥{{budget.remain}} ({{budget.percent}}%)</text>
      <text class="budget-chip-cta">详情 ›</text>
    </block>
    <block wx:else>
      <text class="budget-chip-text">本月已超支 ¥{{budget.over}}</text>
      <text class="budget-chip-cta over">详情 ›</text>
    </block>
  </view>

  <!-- 预算详情底部抽屉 -->
  <bottom-sheet visible="{{showBudgetSheet}}" title="本月预算" size="small" bind:close="closeBudgetSheet">
    <block wx:if="{{budget.status === 'unset'}}">
      <view class="budget-empty">
        <text class="budget-empty-text">还没有设置本月预算</text>
        <button class="budget-empty-btn" bindtap="goBudget">去设定</button>
      </view>
    </block>
    <block wx:elif="{{budget.status === 'normal'}}">
      <view class="budget-detail">
        <view class="budget-detail-row">
          <text class="budget-detail-label">本月预算</text>
          <text class="budget-detail-remain">剩 ¥{{budget.remain}}</text>
        </view>
        <view class="budget-detail-bar"><view class="budget-detail-fill" style="width: {{budget.percent}}%"></view></view>
        <view class="budget-detail-row sub">
          <text class="budget-detail-sub">已花 ¥{{budget.spent}}</text>
          <text class="budget-detail-sub">/ ¥{{budget.amount}}</text>
        </view>
        <button class="budget-detail-btn" bindtap="goBudget">调整预算</button>
      </view>
    </block>
    <block wx:else>
      <view class="budget-detail">
        <view class="budget-detail-row">
          <text class="budget-detail-label">本月已超支</text>
          <text class="budget-detail-over">¥{{budget.over}}</text>
        </view>
        <view class="budget-detail-bar over"><view class="budget-detail-fill" style="width: 100%"></view></view>
        <view class="budget-detail-row sub">
          <text class="budget-detail-sub">已花 ¥{{budget.spent}}</text>
          <text class="budget-detail-sub">/ ¥{{budget.amount}}</text>
        </view>
        <button class="budget-detail-btn" bindtap="goBudget">调整预算</button>
      </view>
    </block>
  </bottom-sheet>

  <!-- 账单（按日分组） -->
  <view class="recent-section">
    <text class="section-title">账单流水</text>

    <view wx:if="{{groupedBills.length === 0}}" class="empty-state">
      <text class="empty-icon">📒</text>
      <text class="empty-text">还没有账单，记一笔吧</text>
    </view>

    <view wx:for="{{groupedBills}}" wx:key="date" class="day-group">
      <view class="day-header">
        <text class="day-header-label">{{item.label}}</text>
        <text class="day-header-net" wx:if="{{item.netStr}}">{{item.netStr}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="bill" wx:key="_id" class="bill-row"
            hover-class="bill-row--hover" data-id="{{bill._id}}" bindtap="openDetail" bindlongpress="deleteBill">
        <view class="bill-icon">{{bill.icon}}</view>
        <view class="bill-info">
          <text class="bill-category">{{bill.category}}</text>
          <text class="bill-note" wx:if="{{bill.note}}">{{bill.note}}</text>
        </view>
        <text class="bill-amount {{bill.type === 'income' ? 'income' : ''}}">
          {{bill.type === 'income' ? '+' : '-'}}¥{{bill.amount}}
        </text>
      </view>
    </view>
  </view>

  <view wx:if="{{overviewFailed}}" class="retry-banner" bindtap="onShow">加载失败，点击重试</view>

</view>
