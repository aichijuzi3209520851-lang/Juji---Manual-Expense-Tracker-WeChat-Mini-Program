<!-- 首页 -->
<view class="home-page">

  <!-- 天气 -->
  <view wx:if="{{weather}}" class="weather-bar">
    <text class="weather-text">{{weather.icon}} {{weather.temp}}°C</text>
  </view>

  <!-- 今日 / 昨日 -->
  <view class="day-card">
    <view class="day-item">
      <text class="day-label">今天</text>
      <text class="day-value">-¥{{todayExpense}}</text>
    </view>
    <view class="day-divider"></view>
    <view class="day-item">
      <text class="day-label">昨天</text>
      <text class="day-value muted">-¥{{yesterdayExpense}}</text>
    </view>
  </view>

  <!-- 预算 -->
  <view class="budget-card budget-{{budget.status}}" bindtap="goBudget">
    <block wx:if="{{budget.status === 'unset'}}">
      <view class="budget-row">
        <text class="budget-label">还没设本月预算</text>
        <text class="budget-cta">去设定 ›</text>
      </view>
    </block>
    <block wx:elif="{{budget.status === 'normal'}}">
      <view class="budget-row">
        <text class="budget-label">本月预算</text>
        <text class="budget-remain">剩 ¥{{budget.remain}}</text>
      </view>
      <view class="budget-bar"><view class="budget-fill" style="width: {{budget.percent}}%"></view></view>
      <view class="budget-row sub">
        <text class="budget-sub">已花 ¥{{budget.spent}}</text>
        <text class="budget-sub">/ ¥{{budget.amount}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="budget-row">
        <text class="budget-label">本月已超支</text>
        <text class="budget-over">¥{{budget.over}}</text>
      </view>
      <view class="budget-bar over"><view class="budget-fill" style="width: 100%"></view></view>
      <view class="budget-row sub">
        <text class="budget-sub">已花 ¥{{budget.spent}}</text>
        <text class="budget-sub">/ ¥{{budget.amount}}</text>
      </view>
    </block>
  </view>

  <!-- 账单（按日分组） -->
  <view class="recent-section">
    <text class="section-title">账单流水</text>

    <view wx:if="{{groupedBills.length === 0}}" class="empty-state">
      <text class="empty-icon">📒</text>
      <text class="empty-text">还没有账单，记一笔吧</text>
    </view>

    <view wx:for="{{groupedBills}}" wx:key="date" class="day-group">
      <view class="day-header">
        <text class="day-header-label">{{item.label}}</text>
        <text class="day-header-net" wx:if="{{item.netStr}}">{{item.netStr}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="bill" wx:key="_id" class="bill-row"
            hover-class="bill-row--hover" data-id="{{bill._id}}" bindtap="openDetail" bindlongpress="deleteBill">
        <view class="bill-icon">{{bill.icon}}</view>
        <view class="bill-info">
          <text class="bill-category">{{bill.category}}</text>
          <text class="bill-note" wx:if="{{bill.note}}">{{bill.note}}</text>
        </view>
        <text class="bill-amount {{bill.type === 'income' ? 'income' : ''}}">
          {{bill.type === 'income' ? '+' : '-'}}¥{{bill.amount}}
        </text>
      </view>
    </view>
  </view>

  <view wx:if="{{overviewFailed}}" class="retry-banner" bindtap="onShow">加载失败，点击重试</view>

</view>
