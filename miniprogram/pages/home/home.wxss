.home-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

/* 季节 */
.season-bar {
  text-align: center; padding: 16rpx 0 0;
}
.season-text {
  font-size: 22rpx; color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* 今日 / 昨日 — gradient hero */
.day-card {
  display: flex;
  align-items: center;
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  padding: 40rpx var(--space-lg);
  margin-top: 20rpx;
  position: relative;
  overflow: hidden;
}
.day-card::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 220rpx; height: 220rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.day-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx; left: -40rpx;
  width: 180rpx; height: 180rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
  pointer-events: none;
}
.day-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}
.day-label {
  font-size: var(--font-size-small);
  color: var(--color-on-primary);
  opacity: 0.78;
  letter-spacing: 2rpx;
}
.day-value {
  font-size: var(--font-size-h1);
  font-weight: var(--font-weight-bold);
  color: var(--color-on-primary);
  font-family: var(--font-numeric);
  font-variant-numeric: tabular-nums;
  line-height: var(--line-height-tight);
}
.day-value.muted {
  font-size: 38rpx;
  font-weight: var(--font-weight-semibold);
  font-family: var(--font-numeric);
  opacity: 0.72;
}
.day-income {
  font-size: var(--font-size-regular);
  font-weight: var(--font-weight-semibold);
  color: var(--color-on-primary);
  opacity: 0.85;
}
.day-divider {
  width: 2rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.25);
  position: relative;
  z-index: 1;
}

/* 预算 chip */
.budget-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  min-height: 72rpx;
  transition: transform 0.15s ease;
}
.budget-chip--hover {
  transform: scale(0.98);
}
.budget-chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  animation: budget-pulse 2s ease-in-out infinite;
}
.budget-chip-dot.is-over {
  background: var(--color-error);
}
@keyframes budget-pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.15); }
}
.budget-chip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
.budget-chip-cta {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}
.budget-chip-cta.over {
  color: var(--color-error);
}

/* 预算抽屉内详情 */
.budget-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 0;
}
.budget-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}
.budget-empty-btn {
  background: var(--gradient-hero);
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
  border: none;
}
.budget-detail {
  padding: 8rpx 0 16rpx;
}
.budget-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.budget-detail-row.sub {
  margin-top: 10rpx;
}
.budget-detail-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}
.budget-detail-remain {
  font-size: 40rpx;
  font-weight: 700;
  font-family: var(--font-numeric);
  color: var(--color-primary);
}
.budget-detail-over {
  font-size: 40rpx;
  font-weight: 700;
  font-family: var(--font-numeric);
  color: var(--color-error);
}
.budget-detail-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.budget-detail-bar {
  margin-top: 18rpx;
  height: 14rpx;
  background: var(--color-primary-container);
  border-radius: 7rpx;
  overflow: hidden;
}
.budget-detail-fill {
  height: 100%;
  background: var(--gradient-hero);
  border-radius: 7rpx;
}
.budget-detail-bar.over .budget-detail-fill {
  background: var(--color-error);
}
.budget-detail-btn {
  margin-top: 24rpx;
  background: var(--color-primary-container);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 16rpx 0;
  border: none;
}

/* 账单分组 */
.recent-section {
  margin-top: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  letter-spacing: 1rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.day-group {
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
  padding: 8rpx 0;
  overflow: hidden;
}
.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
}
.day-header-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  letter-spacing: 1rpx;
  opacity: 0.85;
}
.day-header-net {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: transparent;
  border-radius: 0;
  margin-bottom: 0;
  box-shadow: none;
  border-top: 1rpx solid var(--color-border);
}
.day-header + .bill-row {
  border-top: none;
}
.bill-icon {
  font-size: 40rpx;
  width: 72rpx; height: 72rpx;
  background: var(--color-primary-container);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.bill-info {
  flex: 1;
}
.bill-category {
  font-size: var(--font-size-body);
  color: var(--color-text);
  font-weight: var(--font-weight-semibold);
  display: block;
}
.bill-note {
  font-size: var(--font-size-small);
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
}
.bill-amount {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  font-family: var(--font-numeric);
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}
.bill-amount.income {
  color: var(--color-income);
}
.bill-row--hover { background: var(--color-surface-low); }

.retry-banner {
  text-align: center; padding: 24rpx; margin-top: 16rpx;
  font-size: 26rpx; color: var(--color-text-tertiary);
  border-top: 2rpx dashed var(--color-border);
}
