.home-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

/* 季节 */
.season-bar {
  text-align: center; padding: 16rpx 0 0;
}
.season-text {
  font-size: 22rpx; color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* 今日 / 昨日 — gradient hero */
.day-card {
  display: flex;
  align-items: center;
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  padding: 40rpx var(--space-lg);
  margin-top: 20rpx;
  position: relative;
  overflow: hidden;
}
.day-card::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 220rpx; height: 220rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.day-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx; left: -40rpx;
  width: 180rpx; height: 180rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
  pointer-events: none;
}
.day-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}
.day-label {
  font-size: 24rpx;
  color: var(--color-on-primary);
  opacity: 0.78;
  letter-spacing: 2rpx;
}
.day-value {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  font-variant-numeric: tabular-nums;
}
.day-value.muted {
  font-size: 38rpx;
  font-weight: 600;
  opacity: 0.72;
}
.day-income {
  font-size: 26rpx; font-weight: 600;
  color: var(--color-on-primary);
  opacity: 0.85;
}
.day-divider {
  width: 2rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.25);
  position: relative;
  z-index: 1;
}

/* 预算 */
.budget-card {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card);
  padding: var(--space-lg);
  margin-top: 24rpx;
}
.budget-card.budget-unset {
  background: var(--gradient-hero-soft);
  box-shadow: var(--shadow-soft);
}
.budget-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.budget-row.sub {
  margin-top: 10rpx;
}
.budget-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}
.budget-cta {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}
.budget-remain {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.budget-over {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-error);
}
.budget-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.budget-bar {
  margin-top: 18rpx;
  height: 14rpx;
  background: var(--color-primary-container);
  border-radius: 7rpx;
  overflow: hidden;
}
.budget-fill {
  height: 100%;
  background: var(--gradient-hero);
  border-radius: 7rpx;
  transition: width 0.3s ease;
}
.budget-bar.over .budget-fill {
  background: var(--color-error);
}

/* 账单分组 */
.recent-section {
  margin-top: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  letter-spacing: 1rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.day-group {
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
  padding: 8rpx 0;
  overflow: hidden;
}
.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
}
.day-header-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  letter-spacing: 1rpx;
  opacity: 0.85;
}
.day-header-net {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: transparent;
  border-radius: 0;
  margin-bottom: 0;
  box-shadow: none;
  border-top: 1rpx solid var(--color-border);
}
.day-header + .bill-row {
  border-top: none;
}
.bill-icon {
  font-size: 40rpx;
  width: 72rpx; height: 72rpx;
  background: var(--color-primary-container);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.bill-info {
  flex: 1;
}
.bill-category {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  display: block;
}
.bill-note {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
}
.bill-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}
.bill-amount.income {
  color: var(--color-income);
}
.bill-row--hover { background: var(--color-surface-low); }

.retry-banner {
  text-align: center; padding: 24rpx; margin-top: 16rpx;
  font-size: 26rpx; color: var(--color-text-tertiary);
  border-top: 2rpx dashed var(--color-border);
}
