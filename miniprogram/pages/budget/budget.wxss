.budget-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

/* 空态 */
.budget-empty {
  display: flex; flex-direction: column; align-items: center; padding: 160rpx 48rpx 0;
}
.budget-empty-emoji { font-size: 120rpx; margin-bottom: 32rpx; }
.budget-empty-title { font-size: 36rpx; font-weight: 600; color: var(--color-text); margin-bottom: 16rpx; }
.budget-empty-desc { font-size: 28rpx; color: var(--color-text-tertiary); text-align: center; line-height: 1.5; margin-bottom: 40rpx; }
.budget-empty-btn {
  background: linear-gradient(135deg, #f7caca 0%, #f4c0c0 100%);
  color: var(--color-primary); border-radius: var(--radius-full);
  font-size: 32rpx; font-weight: 600; border: none;
  padding: 20rpx 56rpx;
  box-shadow: 0 14rpx 28rpx rgba(247, 202, 201, 0.14);
}
.budget-empty-btn::after { border: none; }

/* 进度环卡片 */
.budget-hero {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(120,86,85,0.06); padding: var(--space-lg);
  margin-top: 24rpx; display: flex; flex-direction: column; align-items: center;
}
.budget-hero-title { font-size: 28rpx; color: var(--color-text-tertiary); margin-bottom: 24rpx; }

.budget-ring-wrap {
  width: 280rpx; height: 280rpx; position: relative; display: flex;
  align-items: center; justify-content: center; margin-bottom: 20rpx;
  transform: scale(0.92); opacity: 0.8;
  transition: transform 0.4s ease, opacity 0.4s ease;
}
.budget-ring-wrap.is-ready { transform: scale(1); opacity: 1; }

.budget-ring {
  width: 100%; height: 100%; border-radius: 50%;
}

.budget-ring-center {
  position: absolute; display: flex; flex-direction: column; align-items: center;
  width: 200rpx; height: 200rpx; border-radius: 50%; background: white;
  justify-content: center;
}
.ring-label { font-size: 22rpx; color: var(--color-text-secondary); }
.ring-amount { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.ring-rate { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 4rpx; }

.budget-summary { display: flex; flex-direction: column; align-items: center; margin-top: 4rpx; }
.budget-total-label { font-size: 24rpx; color: var(--color-text-secondary); font-weight: 500; }

.budget-status {
  margin-top: 24rpx; padding: 16rpx 28rpx; border-radius: var(--radius-full); font-size: 26rpx;
}
.budget-status.safe { background: rgba(206,233,218,0.3); color: var(--color-income); }
.budget-status.warn { background: rgba(108,90,89,0.08); color: var(--color-warning); }
.budget-status.over { background: var(--color-error-container); color: var(--color-error); }

.budget-edit-link {
  margin-top: 24rpx; font-size: 26rpx; color: var(--color-primary);
  font-weight: 600; opacity: 0.7;
}

/* 历史达成率 */
.budget-history {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.04); padding: var(--space-lg);
  margin-top: 24rpx;
}
.history-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); margin-bottom: 20rpx; display: block; }
.history-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.history-month { font-size: 24rpx; color: var(--color-text-secondary); width: 56rpx; text-align: right; font-weight: 500; }
.history-bar-wrap { flex: 1; }
.history-bar {
  height: 14rpx; background: var(--color-surface-low); border-radius: 7rpx; overflow: hidden;
}
.history-bar.is-over { background: var(--color-error-container); }
.history-fill {
  height: 100%; background: var(--color-primary); border-radius: 7rpx;
  min-width: 4rpx; transition: width 0.3s ease;
}
.history-fill.is-over { background: var(--color-error); }
.history-pct { font-size: 22rpx; color: var(--color-text-secondary); width: 56rpx; font-weight: 500; }
.history-pct.is-over { color: var(--color-error); }

/* 消费节奏 */
.budget-pace {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.04); padding: var(--space-lg);
  margin-top: 24rpx;
}
.pace-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); margin-bottom: 20rpx; display: block; }
.pace-row { display: flex; align-items: center; }
.pace-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.pace-value { font-size: 40rpx; font-weight: 700; color: var(--color-text); font-variant-numeric: tabular-nums; }
.pace-label { font-size: 22rpx; color: var(--color-text-tertiary); }
.pace-divider { width: 2rpx; height: 56rpx; background: var(--color-border); }
.pace-footer { margin-top: 20rpx; text-align: center; font-size: 24rpx; color: var(--color-text-secondary); }

/* 钱去哪了 */
.budget-categories {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.04); padding: var(--space-lg);
  margin-top: 24rpx;
}
.cat-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); margin-bottom: 16rpx; display: block; }
.cat-row { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; }
.cat-emoji { font-size: 36rpx; width: 44rpx; text-align: center; }
.cat-name { font-size: 26rpx; color: var(--color-text); width: 80rpx; font-weight: 500; }
.cat-bar-wrap { flex: 1; height: 10rpx; background: var(--color-surface-low); border-radius: 5rpx; overflow: hidden; }
.cat-fill { height: 100%; background: var(--color-primary); border-radius: 5rpx; min-width: 4rpx; }
.cat-amount { font-size: 26rpx; color: var(--color-text-secondary); font-weight: 500; font-variant-numeric: tabular-nums; }
.cat-pct { font-size: 22rpx; color: var(--color-text-tertiary); width: 48rpx; text-align: right; }

/* 灵犀建议 */
.budget-suggestion {
  background: var(--color-surface-low); border-radius: var(--radius-lg);
  padding: var(--space-md); margin-top: 24rpx; text-align: center;
}
.suggestion-text { font-size: 24rpx; color: var(--color-text-tertiary); }

/* Bottom-sheet 编辑面板 */
.budget-mask {
  position: fixed; inset: 0; z-index: 998;
  background: rgba(30, 27, 26, 0.32);
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease;
}
.budget-mask.is-open { opacity: 1; pointer-events: auto; }

.budget-sheet {
  position: fixed; left: 50%; top: 50%;
  transform: translate(-50%, -50%) scale(0.92);
  z-index: 999;
  width: calc(100% - 96rpx);
  max-width: 600rpx;
  background: var(--color-surface); border-radius: var(--radius-xl);
  padding: 40rpx 40rpx 48rpx;
  box-shadow: 0 24rpx 80rpx rgba(120, 86, 85, 0.18);
  opacity: 0; pointer-events: none;
  transition: all 0.35s cubic-bezier(.32,.72,0,1);
}
.budget-sheet.is-open {
  opacity: 1; pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.sheet-handle { display: none; }
.sheet-title { font-size: 36rpx; font-weight: 700; color: var(--color-text); display: block; margin-bottom: 8rpx; text-align: center; }
.sheet-hint { font-size: 24rpx; color: var(--color-text-tertiary); display: block; margin-bottom: 32rpx; text-align: center; }
.sheet-input-row { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-bottom: 36rpx; }
.sheet-currency { font-size: 44rpx; font-weight: 700; color: var(--color-primary); }
.sheet-input {
  flex: 1; font-size: 48rpx; font-weight: 700; color: var(--color-text);
  border-bottom: 2rpx solid var(--color-surface-high); padding: 8rpx 0;
}
.sheet-save {
  width: 100%; background: linear-gradient(135deg, #f7caca 0%, #f4c0c0 100%);
  color: var(--color-primary); border-radius: var(--radius-full);
  font-size: 32rpx; font-weight: 600; border: none; padding: 24rpx 0;
  box-shadow: 0 14rpx 28rpx rgba(247, 202, 201, 0.14);
}
.sheet-save::after { border: none; }
