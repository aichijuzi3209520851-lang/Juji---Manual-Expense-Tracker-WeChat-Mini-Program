.budget-page { padding: 0 var(--space-md); padding-bottom: 60rpx; }
.budget-hero {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(120,86,85,0.06); padding: var(--space-lg);
  margin-top: 24rpx; display: flex; flex-direction: column; align-items: center;
}
.budget-hero-title { font-size: 28rpx; color: var(--color-text-tertiary); margin-bottom: 24rpx; }
.budget-ring-wrap {
  width: 280rpx; height: 280rpx; position: relative; display: flex;
  align-items: center; justify-content: center; margin-bottom: 20rpx;
}
.budget-ring { width: 100%; height: 100%; }
.budget-ring-center {
  position: absolute; display: flex; flex-direction: column; align-items: center;
}
.ring-label { font-size: 22rpx; color: var(--color-text-secondary); }
.ring-amount { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.budget-summary { display: flex; flex-direction: column; align-items: center; }
.budget-total-label { font-size: 22rpx; color: var(--color-text-tertiary); }
.budget-total-amount { font-size: 30rpx; font-weight: 600; color: var(--color-text-secondary); }
.budget-status {
  margin-top: 24rpx; padding: 16rpx 28rpx; border-radius: var(--radius-full); font-size: 26rpx;
}
.budget-status.safe { background: rgba(206,233,218,0.3); color: var(--color-income); }
.budget-status.warn { background: rgba(108,90,89,0.1); color: var(--color-warning); }
.budget-status.over { background: var(--color-error-container); color: var(--color-error); }
/* 设置区 */
.budget-setter {
  background: var(--color-surface); border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.04); padding: var(--space-lg); margin-top: 24rpx;
}
.setter-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 20rpx; display: block; }
.setter-input-row { display: flex; align-items: center; gap: 12rpx; }
.setter-currency { font-size: 36rpx; font-weight: 600; color: var(--color-text); }
.setter-input { flex: 1; font-size: 36rpx; font-weight: 600; color: var(--color-text); border-bottom: 2rpx solid var(--color-surface-highest); padding: 8rpx 0; }
.setter-btn {
  background: var(--color-primary); color: white; border-radius: var(--radius-full);
  padding: 16rpx 40rpx; font-size: 28rpx; font-weight: 600; border: none;
}
.setter-btn::after { border: none; }
