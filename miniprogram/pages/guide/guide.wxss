/* pages/guide/guide.wxss */

/* ========== 基础容器 ========== */
.guide-wrap {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  position: relative;
  background-color: var(--color-bg, #FAFAFA); 
}

.guide-swiper {
  height: 100vh;
  width: 100vw;
  position: relative;
  z-index: 10;
}

/* ========== 弥散光背景 (Mesh Gradient Ambient - 冷暖对比) ========== */
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.6;
  z-index: 1; 
  pointer-events: none; 
}

/* 暖橙色 */
.ambient-1 {
  width: 70vw;
  height: 70vw;
  top: -10vw;
  left: -20vw;
  background: radial-gradient(circle, rgba(255, 140, 0, 0.45) 0%, transparent 70%);
  animation: ambientFloat1 15s ease-in-out infinite alternate;
}

/* 淡绿色 */
.ambient-2 {
  width: 80vw;
  height: 80vw;
  bottom: -20vw;
  right: -20vw;
  background: radial-gradient(circle, rgba(144, 238, 144, 0.35) 0%, transparent 70%);
  animation: ambientFloat2 18s ease-in-out infinite alternate;
}

/* 冷蓝色 */
.ambient-3 {
  width: 60vw;
  height: 60vw;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(135, 206, 235, 0.4) 0%, transparent 70%);
  opacity: 0.5;
  mix-blend-mode: overlay; 
}

@keyframes ambientFloat1 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(5vw, 5vw) scale(1.1); }
}
@keyframes ambientFloat2 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(-6vw, -4vw) scale(1.15); }
}


/* ========== 通用页面结构 (布局居中) ========== */
.guide-page {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center; /* 居中对齐 */
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  position: relative;
}


/* ========== 汉字超级符号水印 (Chinese Typography Background) ========== */
.guide-watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  
  font-size: 650rpx; /* 极大的字号，超出屏幕裁切 */
  font-family: 'PingFang SC', -apple-system, sans-serif;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  
  color: rgba(255, 255, 255, 0.6); /* 极淡的颜色，结合深/浅色背景都适用 */
  
  pointer-events: none;
  user-select: none;
  z-index: 2; 
}


/* ========== 真正的毛玻璃悬浮球 (True Glassmorphism Orb) ========== */
.orb-reveal-wrap {
  position: relative;
  z-index: 20;
  margin-bottom: 60rpx;
  /* 居中布局，无需左外边距 */
}

.guide-glass-orb {
  width: 300rpx; 
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 核心 CSS 魔法参数 */
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  
  /* 内部体积光 & 外部环境投影 */
  box-shadow: 
    inset 0 0 40px rgba(255, 255, 255, 0.4), 
    0 16px 32px rgba(0, 0, 0, 0.05);
    
  /* 缓慢上下呼吸浮动动画 */
  animation: floating 5s ease-in-out infinite alternate;
}

@keyframes floating {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-20px); }
}

.guide-emoji {
  font-size: 130rpx; 
  line-height: 1;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.15));
}


/* ========== 文字区块 (居中排版) ========== */
.guide-text-block {
  display: flex;
  flex-direction: column;
  align-items: center; /* 居中 */
  text-align: center; /* 文字居中 */
  width: 100%;
  position: relative;
  z-index: 20;
}

.guide-title {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-text, #333);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  line-height: 1.2;
}

.guide-sub {
  font-size: 32rpx; /* 稍微调大一点适应居中阅读流 */
  font-weight: 400;
  color: var(--color-text-tertiary, #777);
  line-height: 1.6;
  letter-spacing: 1rpx;
  max-width: 85%;
}


/* ========== 电影级错落排版与贝塞尔曲线动效 (Staggered Cinematic Reveal) ========== */
/* 初始状态：隐藏且下沉 */
.orb-reveal-wrap:not(.reveal),
.guide-title:not(.reveal),
.guide-sub:not(.reveal),
.guide-btn-go:not(.reveal) {
  opacity: 0;
  transform: translateY(40px);
}

/* 顶级贝塞尔曲线入场动画 */
@keyframes smoothUp {
  0% {
    opacity: 0;
    transform: translateY(40px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 使用属性选择器匹配以 anim- 开头的 class，确保每次更换 class 都能重新触发动画 */
.reveal[class*="anim-"] {
  animation: smoothUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}


/* ========== 实心高亮 CTA 按钮 ========== */
.guide-btn-go {
  /* 距离底部约 18vh */
  position: absolute;
  bottom: 18vh; 
  
  width: 70%;
  height: 110rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* 实心、高亮的橙色渐变 */
  background: linear-gradient(135deg, #FF8C00, #FFB800);
  color: #FFFFFF;
  
  border-radius: 60rpx;
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  z-index: 20;
  
  /* 极具点击欲的投影 */
  box-shadow: 0 12px 32px rgba(255, 140, 0, 0.35);
  transition: all 0.2s ease;
}

.guide-btn-go::after {
  display: none;
}

.guide-btn-go--pressed {
  transform: scale(0.95);
  box-shadow: 0 6px 16px rgba(255, 140, 0, 0.2);
}


/* ========== 胶囊指示器 ========== */
.guide-dots {
  position: absolute;
  bottom: calc(8vh + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  z-index: 30;
}

.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--color-border, rgba(0,0,0,0.1));
  transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.guide-dot.is-active {
  width: 48rpx;
  background: var(--color-primary, #FF8C00);
  box-shadow: 0 2rpx 8rpx var(--color-primary-light, rgba(255,165,0,0.3));
}