/* pages/guide/guide.wxss */

/* ========== 基础容器 ========== */
.guide-wrap {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  position: relative;
  background-color: var(--color-bg, #FAFAFA); 
}

.guide-swiper {
  height: 100vh;
  width: 100vw;
  position: relative;
  z-index: 10;
}

/* ========== 弥散光背景 (Mesh Gradient Ambient - 冷暖对比) ========== */
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.6;
  z-index: 1; 
  pointer-events: none; 
}

/* 暖橙色 */
.ambient-1 {
  width: 70vw;
  height: 70vw;
  top: -10vw;
  left: -20vw;
  background: radial-gradient(circle, rgba(255, 140, 0, 0.45) 0%, transparent 70%);
  animation: ambientFloat1 15s ease-in-out infinite alternate;
}

/* 淡绿色 */
.ambient-2 {
  width: 80vw;
  height: 80vw;
  bottom: -20vw;
  right: -20vw;
  background: radial-gradient(circle, rgba(144, 238, 144, 0.35) 0%, transparent 70%);
  animation: ambientFloat2 18s ease-in-out infinite alternate;
}

/* 冷蓝色 */
.ambient-3 {
  width: 60vw;
  height: 60vw;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(135, 206, 235, 0.4) 0%, transparent 70%);
  opacity: 0.5;
  mix-blend-mode: overlay; 
}

@keyframes ambientFloat1 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(5vw, 5vw) scale(1.1); }
}
@keyframes ambientFloat2 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(-6vw, -4vw) scale(1.15); }
}


/* ========== 通用页面结构 (布局居中) ========== */
.guide-page {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center; /* 居中对齐 */
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  position: relative;
}


/* ========== 汉字超级符号水印 (Chinese Typography Background) ========== */
.guide-watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  
  font-size: 650rpx; /* 极大的字号，超出屏幕裁切 */
  font-family: 'PingFang SC', -apple-system, sans-serif;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  
  color: rgba(255, 255, 255, 0.6); /* 极淡的颜色，结合深/浅色背景都适用 */
  
  pointer-events: none;
  user-select: none;
  z-index: 2; 
}


/* ========== 真正的毛玻璃悬浮球 (True Glassmorphism Orb) ========== */
.orb-reveal-wrap {
  position: relative;
  z-index: 20;
  margin-bottom: 60rpx;
  /* 居中布局，无需左外边距 */
}

.guide-glass-orb {
  width: 300rpx; 
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 核心 CSS 魔法参数 */
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  
  /* 内部体积光 & 外部环境投影 */
  box-shadow: 
    inset 0 0 40px rgba(255, 255, 255, 0.4), 
    0 16px 32px rgba(0, 0, 0, 0.05);
    
  /* 缓慢上下呼吸浮动动画 */
  animation: floating 5s ease-in-out infinite alternate;
}

@keyframes floating {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-20px); }
}

.guide-emoji {
  font-size: 130rpx; 
  line-height: 1;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.15));
}


/* ========== 文字区块 (居中排版) ========== */
.guide-text-block {
  display: flex;
  flex-direction: column;
  align-items: center; /* 居中 */
  text-align: center; /* 文字居中 */
  width: 100%;
  position: relative;
  z-index: 20;
}

.guide-title {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-text, #333);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  line-height: 1.2;
}

.guide-sub {
  font-size: 32rpx; /* 稍微调大一点适应居中阅读流 */
  font-weight: 400;
  color: var(--color-text-tertiary, #777);
  line-height: 1.6;
  letter-spacing: 1rpx;
  max-width: 85%;
}


/* ========== 电影级错落排版与贝塞尔曲线动效 (Staggered Cinematic Reveal) ========== */
/* 初始状态：隐藏且下沉 */
.orb-reveal-wrap:not(.reveal),
.guide-title:not(.reveal),
.guide-sub:not(.reveal),
.guide-btn-go:not(.reveal) {
  opacity: 0;
  transform: translateY(40px);
}

/* 顶级贝塞尔曲线入场动画 */
@keyframes smoothUp {
  0% {
    opacity: 0;
    transform: translateY(40px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 使用属性选择器匹配以 anim- 开头的 class，确保每次更换 class 都能重新触发动画 */
.reveal[class*="anim-"] {
  animation: smoothUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}


/* ========== 实心高亮 CTA 按钮 ========== */
.guide-btn-go {
  /* 距离底部约 18vh */
  position: absolute;
  bottom: 18vh; 
  
  width: 70%;
  height: 110rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* 实心、高亮的橙色渐变 */
  background: linear-gradient(135deg, #FF8C00, #FFB800);
  color: #FFFFFF;
  
  border-radius: 60rpx;
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  z-index: 20;
  
  /* 极具点击欲的投影 */
  box-shadow: 0 12px 32px rgba(255, 140, 0, 0.35);
  transition: all 0.2s ease;
}

.guide-btn-go::after {
  display: none;
}

.guide-btn-go--pressed {
  transform: scale(0.95);
  box-shadow: 0 6px 16px rgba(255, 140, 0, 0.2);
}


/* ========== 胶囊指示器 ========== */
.guide-dots {
  position: absolute;
  bottom: calc(8vh + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  z-index: 30;
}

.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--color-border, rgba(0,0,0,0.1));
  transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.guide-dot.is-active {
  width: 48rpx;
  background: var(--color-primary, #FF8C00);
  box-shadow: 0 2rpx 8rpx var(--color-primary-light, rgba(255,165,0,0.3));
}

/* ========== 小橘吉祥物（引导页第 4 屏，招手 + 发射爱心） ========== */
/* 复刻「我的」页 juji-pet，居中放大并改为自动循环动效 */
.guide-juji {
  position: relative;
  width: 150rpx;
  height: 142rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(1.7);
}
.guide-juji .juji-pet {
  position: relative;
  width: 150rpx;
  height: 142rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transform-origin: center bottom;
  animation: juji-pet-idle 2.6s ease-in-out infinite;
}
.juji-pet-body {
  position: relative;
  width: 94rpx;
  height: 90rpx;
  background: linear-gradient(165deg, #f7a628 0%, #f7a628 58%, #e88d17 100%);
  border: 6rpx solid #2d1f0d;
  border-radius: 50%;
  box-shadow: inset -8rpx -6rpx 0 rgba(207,79,30,0.18), inset 7rpx 7rpx 0 rgba(255,236,184,0.22);
}
.juji-pet-body::before,
.juji-pet-body::after {
  content: '';
  position: absolute;
  pointer-events: none;
}
.juji-pet-body::before {
  left: 13rpx;
  top: 15rpx;
  width: 14rpx;
  height: 30rpx;
  background: rgba(253,248,227,0.85);
  border-radius: 9rpx 9rpx 5rpx 5rpx;
  transform: rotate(34deg);
  box-shadow: 14rpx -6rpx 0 -5rpx rgba(253,248,227,0.7), -6rpx 30rpx 0 -4rpx rgba(253,248,227,0.5);
}
.juji-pet-body::after {
  right: 7rpx;
  top: 20rpx;
  width: 13rpx;
  height: 48rpx;
  background: rgba(232,141,23,0.22);
  border-radius: 4rpx 18rpx 18rpx 4rpx;
}
.juji-pet-leaf {
  position: absolute;
  left: 52rpx;
  top: -28rpx;
  width: 38rpx;
  height: 26rpx;
  background: linear-gradient(135deg, #6fc63f 0%, #3a7d2b 100%);
  border: 5rpx solid #2d1f0d;
  border-radius: 4rpx 26rpx 4rpx 26rpx;
  transform: rotate(16deg);
  box-shadow: inset -6rpx -4rpx 0 rgba(43,90,40,0.3);
}
.juji-pet-leaf::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 16rpx;
  width: 9rpx;
  height: 22rpx;
  background: #5a9a32;
  border: 4rpx solid #2d1f0d;
  border-radius: 6rpx;
  transform: rotate(28deg);
}
.juji-pet-leaf::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 9rpx;
  width: 20rpx;
  height: 5rpx;
  background: rgba(45,127,43,0.4);
  border-radius: 4rpx;
  transform: rotate(28deg);
}
.juji-pet-face {
  position: absolute;
  left: 16rpx;
  top: 34rpx;
  width: 62rpx;
  height: 36rpx;
  z-index: 2;
}
.juji-pet-face::before,
.juji-pet-face::after {
  content: '';
  position: absolute;
  top: 17rpx;
  width: 20rpx;
  height: 14rpx;
  background: #f7a0a4;
  border-radius: 50%;
}
.juji-pet-face::before { left: -9rpx; }
.juji-pet-face::after { right: -9rpx; }
.juji-pet-eye {
  position: absolute;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  background: #2d1f0d;
  border-radius: 50%;
  box-shadow: inset 5rpx 5rpx 0 -2rpx rgba(255,255,255,0.95);
  animation: juji-pet-blink 4.6s steps(1) infinite;
}
.juji-pet-eye--left { left: 5rpx; }
.juji-pet-eye--right { right: 5rpx; }
.juji-pet-mouth {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 18rpx;
  height: 12rpx;
  border: 4rpx solid #2d1f0d;
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
  background: transparent;
  box-sizing: border-box;
}
.juji-pet-arm {
  position: absolute;
  top: 50rpx;
  width: 17rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #f7a628 0%, #e88d17 100%);
  border: 5rpx solid #2d1f0d;
  border-radius: 14rpx 14rpx 10rpx 10rpx;
  z-index: 1;
}
.juji-pet-arm--left {
  left: -17rpx;
  transform: rotate(18deg);
}
/* 右臂持续招手（自动循环：两下挥手 + 短暂停歇） */
.juji-pet-arm--right {
  right: -17rpx;
  transform-origin: 50% 10%;
  transform: rotate(-18deg);
  animation: guide-juji-wave 2.8s ease-in-out infinite;
}
.juji-pet-foot {
  position: absolute;
  bottom: -18rpx;
  width: 24rpx;
  height: 18rpx;
  background: linear-gradient(180deg, #f7a628 0%, #e88d17 100%);
  border: 5rpx solid #2d1f0d;
  border-radius: 8rpx 8rpx 6rpx 6rpx;
}
.juji-pet-foot--left { left: 16rpx; }
.juji-pet-foot--right { right: 16rpx; }
.juji-pet-shadow {
  position: absolute;
  bottom: 0;
  width: 112rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(48,38,31,0.16);
  filter: blur(1rpx);
}
/* 飘升的爱心（3 颗，错开延迟，循环发射） */
.guide-heart {
  position: absolute;
  top: 10rpx;
  left: 84rpx;
  font-size: 30rpx;
  color: #ff5d7a;
  pointer-events: none;
  opacity: 0;
  animation: guide-heart-fly 2.6s ease-out infinite;
}
.guide-heart--1 { left: 92rpx; animation-delay: 0s; }
.guide-heart--2 { left: 70rpx; font-size: 22rpx; animation-delay: 0.9s; }
.guide-heart--3 { left: 104rpx; font-size: 26rpx; animation-delay: 1.7s; }

@keyframes juji-pet-idle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}
@keyframes juji-pet-blink {
  0%, 92%, 100% { height: 16rpx; }
  94% { height: 3rpx; }
}
@keyframes guide-juji-wave {
  0% { transform: rotate(-18deg); }
  8% { transform: rotate(-62deg) translateY(-8rpx); }
  16% { transform: rotate(-18deg); }
  24% { transform: rotate(-62deg) translateY(-8rpx); }
  32% { transform: rotate(-18deg); }
  100% { transform: rotate(-18deg); }
}
@keyframes guide-heart-fly {
  0% { transform: translate(0, 18rpx) scale(0.6); opacity: 0; }
  20% { opacity: 1; }
  100% { transform: translate(-22rpx, -70rpx) scale(1.3); opacity: 0; }
}