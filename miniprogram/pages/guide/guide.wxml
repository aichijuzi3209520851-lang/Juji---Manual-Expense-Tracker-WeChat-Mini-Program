<!-- pages/guide/guide.wxml -->
<view class="guide-wrap" style="{{themeStyle}}">

  <!-- 弥散光背景 (Mesh Gradient Ambient - 冷暖对比) -->
  <view class="ambient-orb ambient-1"></view>
  <view class="ambient-orb ambient-2"></view>
  <view class="ambient-orb ambient-3"></view>

  <swiper class="guide-swiper" bindchange="onSwiperChange" current="{{currentIndex}}" duration="{{600}}">

    <!-- 第 1 屏：极速体验 -->
    <swiper-item>
      <view class="guide-page">
        <!-- 巨型汉字超级符号水印 -->
        <text class="guide-watermark">快</text>
        
        <!-- 毛玻璃悬浮球包裹器 (每次切屏绑定 animKey 重新触发动效) -->
        <view class="orb-reveal-wrap {{currentIndex === 0 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0s">
          <view class="guide-glass-orb">
            <text class="guide-emoji">🍊</text>
          </view>
        </view>

        <!-- 居中排版文字区块 -->
        <view class="guide-text-block">
          <text class="guide-title {{currentIndex === 0 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.1s">极速，毫无负担</text>
          <text class="guide-sub {{currentIndex === 0 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.2s">打开即记，三步搞定。不打断你的生活节奏。</text>
        </view>
      </view>
    </swiper-item>

    <!-- 第 2 屏：美学与光影 -->
    <swiper-item>
      <view class="guide-page">
        <text class="guide-watermark">美</text>
        
        <view class="orb-reveal-wrap {{currentIndex === 1 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0s">
          <view class="guide-glass-orb">
            <text class="guide-emoji">🎨</text>
          </view>
        </view>

        <view class="guide-text-block">
          <text class="guide-title {{currentIndex === 1 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.1s">高颜值，会呼吸</text>
          <text class="guide-sub {{currentIndex === 1 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.2s">空间计算美学，专属光影质感。让记账成为视觉享受。</text>
        </view>
      </view>
    </swiper-item>

    <!-- 第 3 屏：灵魂与温度 -->
    <swiper-item>
      <view class="guide-page">
        <text class="guide-watermark">心</text>

        <view class="orb-reveal-wrap {{currentIndex === 2 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0s">
          <view class="guide-glass-orb">
            <text class="guide-emoji">✉️</text>
          </view>
        </view>

        <view class="guide-text-block">
          <text class="guide-title {{currentIndex === 2 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.1s">懂账单，更懂你</text>
          <text class="guide-sub {{currentIndex === 2 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.2s">赛博知己"小橘"，为你写下专属的温情信件。</text>
        </view>
      </view>
    </swiper-item>

    <!-- 第 4 屏：遇见小橘 -->
    <swiper-item>
      <view class="guide-page">
        <text class="guide-watermark">伴</text>

        <view class="orb-reveal-wrap {{currentIndex === 3 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0s">
          <view class="guide-glass-orb">
            <!-- 小橘吉祥物：招手 + 发射爱心 -->
            <view class="guide-juji">
              <view class="juji-pet">
                <view class="juji-pet-shadow"></view>
                <view class="juji-pet-body">
                  <view class="juji-pet-leaf"></view>
                  <view class="juji-pet-face">
                    <view class="juji-pet-eye juji-pet-eye--left"></view>
                    <view class="juji-pet-eye juji-pet-eye--right"></view>
                    <view class="juji-pet-mouth"></view>
                  </view>
                  <view class="juji-pet-arm juji-pet-arm--left"></view>
                  <view class="juji-pet-arm juji-pet-arm--right"></view>
                  <view class="juji-pet-foot juji-pet-foot--left"></view>
                  <view class="juji-pet-foot juji-pet-foot--right"></view>
                </view>
              </view>
              <text class="guide-heart guide-heart--1">❤</text>
              <text class="guide-heart guide-heart--2">❤</text>
              <text class="guide-heart guide-heart--3">❤</text>
            </view>
          </view>
        </view>

        <view class="guide-text-block">
          <text class="guide-title {{currentIndex === 3 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.1s">认识一下，小橘</text>
          <text class="guide-sub {{currentIndex === 3 ? 'reveal' : ''}} anim-{{animKey}}" style="animation-delay: 0.2s">跟它说句"中午吃饭18元"，小橘就帮你记好账。还能陪你聊天、复盘开销。</text>
        </view>

        <!-- 实心高亮 CTA 按钮 -->
        <button class="guide-btn-go {{currentIndex === 3 ? 'reveal' : ''}} anim-{{animKey}}" hover-class="guide-btn-go--pressed" style="animation-delay: 0.3s" bindtap="finishGuide">
          开启记账之旅
        </button>
      </view>
    </swiper-item>

  </swiper>

  <!-- 胶囊指示器 -->
  <view class="guide-dots">
    <view wx:for="{{[0,1,2,3]}}" wx:key="*this" class="guide-dot {{item === currentIndex ? 'is-active' : ''}}"></view>
  </view>

</view>