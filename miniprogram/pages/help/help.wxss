/* 帮助与教程 */
.help-page {
  min-height: 100vh;
  padding: 24rpx var(--space-md) 80rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.help-header {
  padding: 20rpx 8rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.help-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}

.help-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ===== 分组 ===== */
.help-group {
  margin-bottom: 32rpx;
}

.help-group-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

.help-group-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.help-group-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

/* ===== 主题卡片（手风琴） ===== */
.help-topic {
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx var(--shadow-dark);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.help-topic-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.help-topic-head-hover {
  opacity: 0.7;
}

.help-topic-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.help-topic-arrow {
  font-size: 34rpx;
  color: var(--color-text-tertiary);
  transition: transform 0.2s ease;
  transform: rotate(0deg);
}

.help-topic-arrow.is-open {
  transform: rotate(90deg);
}

.help-topic-body {
  padding: 4rpx 30rpx 28rpx;
  border-top: 2rpx solid var(--color-bg);
}

/* ===== 步骤 ===== */
.help-step {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.help-step-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.help-tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: calc(var(--radius-xl) - 8rpx);
}

.help-tip-text {
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--color-text-tertiary);
}

/* ===== 页脚 ===== */
.help-footer {
  margin-top: 20rpx;
  padding: 0 8rpx;
  display: flex;
  justify-content: center;
}

.help-footer-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
