.profile-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.profile-hero {
  display: flex; align-items: center; gap: 24rpx;
  padding: 36rpx 196rpx 36rpx 32rpx;
  margin-top: 36rpx;
  min-height: 152rpx;
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  position: relative; overflow: visible;
}
.profile-hero::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.profile-avatar-wrap {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,0.22);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 8rpx 16rpx var(--shadow-dark);
  position: relative; z-index: 1;
  flex-shrink: 0;
}
.profile-avatar { width: 100%; height: 100%; }
.profile-avatar-fallback { font-size: 56rpx; line-height: 1; }
.profile-avatar-hover { opacity: 0.7; }
.profile-info { display: flex; flex-direction: column; gap: 10rpx; position: relative; z-index: 1; }
.profile-nickname { font-size: 40rpx; font-weight: 700; color: var(--color-on-primary); }
.profile-nickname-hover { opacity: 0.7; }
.profile-gender {
  font-size: 22rpx; color: var(--color-on-primary);
  background: rgba(255,255,255,0.25);
  padding: 4rpx 18rpx; border-radius: var(--radius-full);
  display: inline-block; width: fit-content;
  letter-spacing: 1rpx;
}
/* 小橘 AI 助手 (圆润可爱Q弹重构版) */
.juji-pet {
  position: absolute;
  right: 22rpx;
  top: 46rpx;
  width: 150rpx;
  height: 146rpx;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transform-origin: center bottom;
  animation: juji-pet-idle 3.2s ease-in-out infinite;
}
.juji-pet:active {
  transform: scale(0.92) rotate(-3deg);
}
.juji-pet-body {
  position: relative;
  width: 100rpx;
  height: 96rpx;
  background: linear-gradient(145deg, #ffc843 0%, #fb923c 60%, #f97316 100%);
  border: 5.5rpx solid #3b200b;
  border-radius: 50% 50% 48% 48% / 52% 52% 48% 48%;
  box-shadow: inset -10rpx -8rpx 0 rgba(224, 86, 20, 0.28), inset 8rpx 8rpx 0 rgba(255, 245, 205, 0.45), 0 8rpx 20rpx rgba(249, 115, 22, 0.25);
}
.juji-pet-body::before,
.juji-pet-body::after {
  content: '';
  position: absolute;
  pointer-events: none;
}
.juji-pet-body::before {
  left: 14rpx;
  top: 12rpx;
  width: 22rpx;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  transform: rotate(-24deg);
  filter: blur(0.5rpx);
}
.juji-pet-body::after {
  right: 10rpx;
  bottom: 12rpx;
  width: 16rpx;
  height: 40rpx;
  background: rgba(234, 88, 12, 0.2);
  border-radius: 50%;
}
.juji-pet-leaf {
  position: absolute;
  left: 48rpx;
  top: -26rpx;
  width: 36rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #84cc16 0%, #4d7c0f 100%);
  border: 4.5rpx solid #233807;
  border-radius: 2rpx 24rpx 2rpx 24rpx;
  transform: rotate(18deg);
  box-shadow: inset -4rpx -3rpx 0 rgba(20, 45, 4, 0.3);
}
.juji-pet-leaf::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 14rpx;
  width: 8rpx;
  height: 20rpx;
  background: #65a30d;
  border: 4rpx solid #233807;
  border-radius: 6rpx;
  transform: rotate(26deg);
}
.juji-pet-leaf::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 18rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 4rpx;
  transform: rotate(26deg);
}
.juji-pet-face {
  position: absolute;
  left: 14rpx;
  top: 32rpx;
  width: 72rpx;
  height: 38rpx;
  z-index: 2;
}
.juji-pet-face::before,
.juji-pet-face::after {
  content: '';
  position: absolute;
  top: 16rpx;
  width: 24rpx;
  height: 16rpx;
  background: radial-gradient(circle, #ff7b92 0%, rgba(255, 123, 146, 0.1) 80%);
  border-radius: 50%;
}
.juji-pet-face::before { left: -8rpx; }
.juji-pet-face::after { right: -8rpx; }
.juji-pet-eye {
  position: absolute;
  top: 2rpx;
  width: 18rpx;
  height: 18rpx;
  background: #2b1708;
  border-radius: 50%;
  box-shadow: inset 4rpx 4rpx 0 0 #ffffff, inset -2rpx -2rpx 0 0 rgba(255, 255, 255, 0.5);
  animation: juji-pet-blink 4.2s ease-in-out infinite;
}
.juji-pet-eye--left { left: 8rpx; }
.juji-pet-eye--right { right: 8rpx; }
.juji-pet-mouth {
  position: absolute;
  left: 26rpx;
  top: 20rpx;
  width: 20rpx;
  height: 12rpx;
  border: 4.5rpx solid #2b1708;
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
  background: transparent;
  box-sizing: border-box;
}
/* 软糯水滴四肢重构 */
.juji-pet-arm {
  position: absolute;
  top: 46rpx;
  width: 22rpx;
  height: 38rpx;
  background: linear-gradient(180deg, #ffc843 0%, #fb923c 100%);
  border: 4.5rpx solid #3b200b;
  border-radius: 50% 50% 45% 45% / 40% 40% 60% 60%;
  z-index: 1;
}
.juji-pet-arm--left {
  left: -15rpx;
  transform: rotate(24deg);
}
.juji-pet-arm--right {
  right: -15rpx;
  transform-origin: 50% 15%;
  transform: rotate(-24deg);
}
.juji-pet-foot {
  position: absolute;
  bottom: -14rpx;
  width: 28rpx;
  height: 20rpx;
  background: linear-gradient(180deg, #fb923c 0%, #f97316 100%);
  border: 4.5rpx solid #3b200b;
  border-radius: 50% 50% 45% 45%;
}
.juji-pet-foot--left { left: 14rpx; }
.juji-pet-foot--right { right: 14rpx; }
.juji-pet-shadow {
  position: absolute;
  bottom: -6rpx;
  width: 110rpx;
  height: 20rpx;
  background: rgba(59, 32, 11, 0.15);
  border-radius: 50%;
  filter: blur(3rpx);
  animation: juji-pet-shadow 3.2s ease-in-out infinite;
}
.juji-pet-bubble {
  position: absolute;
  top: -46rpx;
  left: -24rpx;
  background: #ffffff;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 3.5rpx solid #3b200b;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  white-space: nowrap;
  animation: juji-pet-bubble 1.1s ease both;
}
.juji-pet-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 28rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #ffffff;
}
.juji-pet-heart {
  position: absolute;
  top: -30rpx;
  right: 10rpx;
  color: #ef4444;
  font-size: 32rpx;
  animation: juji-pet-heart 1.4s ease-out forwards;
}
/* 动效增强 */
.juji-pet--wave .juji-pet-arm--right {
  animation: juji-pet-wave 0.35s ease-in-out 4;
}
.juji-pet--jump {
  animation: juji-pet-jump 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.juji-pet--heart .juji-pet-body {
  animation: juji-pet-pop 0.55s ease both;
}
@keyframes juji-pet-idle {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  50% { transform: translateY(-8rpx) scale(1.03, 0.97); }
}
@keyframes juji-pet-shadow {
  0%, 100% { transform: scale(1); opacity: 0.15; }
  50% { transform: scale(0.88); opacity: 0.08; }
}
@keyframes juji-pet-blink {
  0%, 94%, 98%, 100% { transform: scaleY(1); }
  96% { transform: scaleY(0.1); }
}
@keyframes juji-pet-wave {
  0%, 100% { transform: rotate(-24deg); }
  50% { transform: rotate(-72deg); }
}
@keyframes juji-pet-jump {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-24rpx) scale(0.96, 1.05); }
  70% { transform: translateY(0) scale(1.05, 0.95); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes juji-pet-pop {
  45% { transform: scale(1.08); }
}
@keyframes juji-heart-fly {
  0% { transform: translate(0, 22rpx) scale(0.7); opacity: 0; }
  25% { opacity: 1; }
  100% { transform: translate(-18rpx, -48rpx) scale(1.35); opacity: 0; }
}
@keyframes juji-pet-bubble {
  from { transform: translateY(8rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
/* 菜单区 */
.profile-section { margin-top: 32rpx; }
.profile-section-title { font-size: 24rpx; color: var(--color-primary); font-weight: 700; padding: 0 8rpx 12rpx; display: block; letter-spacing: 2rpx; opacity: 0.85; }
.profile-collapsible-wrap { margin-top: 24rpx; }
.profile-menu {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.menu-item {
  display: flex; align-items: center; gap: 20rpx; padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  font-size: 32rpx;
  width: 64rpx; height: 64rpx;
  background: var(--color-primary-container);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.menu-label { flex: 1; font-size: var(--font-size-body); color: var(--color-text); font-weight: var(--font-weight-medium); }
.menu-label.danger-text { color: var(--color-error); }
.menu-arrow { font-size: var(--font-size-h3); color: var(--color-text-tertiary); }
.menu-value-wrap { display: flex; align-items: center; gap: 8rpx; }
.menu-value { font-size: var(--font-size-regular); color: var(--color-text-secondary); }
.menu-badge { font-size: var(--font-size-small); color: var(--color-primary); background: var(--color-primary-container); padding: 4rpx 16rpx; border-radius: var(--radius-full); font-weight: var(--font-weight-semibold); }
.menu-item.disabled { opacity: 0.6; }
.menu-item picker { flex: 1; display: flex; justify-content: flex-end; }
/* 记账足迹 */
.footprint-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 36rpx var(--space-md);
  margin-top: 24rpx; display: flex; align-items: center;
}
.footprint-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.footprint-value-wrap { height: 60rpx; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 12rpx; }
.footprint-value { font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); font-family: var(--font-numeric); color: var(--color-primary); font-variant-numeric: tabular-nums; line-height: 1; }
.footprint-label { font-size: var(--font-size-small); color: var(--color-text-tertiary); line-height: 1; }
.footprint-emoji { font-size: 44rpx; line-height: 1; }
.footprint-title-value {
  max-width: 190rpx;
  font-size: 28rpx;
  line-height: 1.15;
  font-weight: 800;
  color: var(--color-primary);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.footprint-title-value.is-locked {
  color: var(--color-text-tertiary);
}
.footprint-title-value.is-loading {
  color: var(--color-primary);
  animation: profile-title-breathe 1.5s ease-in-out infinite;
}
@keyframes profile-title-breathe {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}
.footprint-divider { width: 2rpx; height: 56rpx; background: var(--color-border); }
/* AI 称号弹窗 */
.title-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9998;
}
.title-card {
  width: 82%;
  max-width: 620rpx;
  box-sizing: border-box;
  border-radius: var(--radius-2xl);
  background: var(--color-surface);
  padding: 42rpx 36rpx 34rpx;
  box-shadow: var(--shadow-elevated);
  border: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title-kicker {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.title-name-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  max-width: 100%;
}
.title-emoji {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--color-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.title-name {
  max-width: 430rpx;
  font-size: 42rpx;
  line-height: 1.15;
  color: var(--color-text);
  font-weight: 900;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.title-source {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.title-reason {
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--color-primary-container);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: left;
}
.title-actions {
  margin-top: 28rpx;
  width: 100%;
  display: flex;
  gap: 18rpx;
}
.title-btn {
  flex: 1;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  padding: 22rpx 0;
  border: none;
}
.title-btn::after {
  border: none;
}
.title-btn--ghost {
  background: var(--color-surface-low);
  color: var(--color-text-secondary);
}
.title-btn--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-soft);
}
/* 小橘 AI 聊天 */
.ai-chat-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transition: bottom 0.18s ease-out;
}
.ai-chat-panel {
  width: 100%;
  height: 86vh;
  max-height: 1320rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: var(--color-bg);
  box-shadow: 0 -12rpx 40rpx rgba(0,0,0,0.18);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transition: height 0.18s ease-out, border-radius 0.18s ease-out;
}
.ai-chat-panel.is-keyboard {
  height: 100%;
  max-height: none;
  border-radius: 0;
  padding-bottom: 0;
}
.ai-chat-header {
  min-height: 112rpx;
  padding: 26rpx 28rpx 20rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.ai-chat-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.ai-chat-logo,
.chat-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--color-primary-container);
  flex-shrink: 0;
  overflow: hidden;
}
.ai-chat-name {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 800;
  line-height: 1.2;
}
.ai-chat-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
}
.ai-chat-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-low);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
.ai-chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 18rpx;
  box-sizing: border-box;
}
.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.chat-row--user {
  flex-direction: row-reverse;
}
.chat-avatar-img {
  width: 100%;
  height: 100%;
}
.chat-avatar--fallback {
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-bubble {
  max-width: 510rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}
.chat-bubble--assistant {
  background: var(--color-surface);
  color: var(--color-text);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--color-border);
}
.chat-bubble--user {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-top-right-radius: 8rpx;
}
.chat-bubble--typing {
  color: var(--color-text-tertiary);
  animation: juji-chat-typing 1.2s ease-in-out infinite;
}
.chat-suggestions {
  margin: -6rpx 0 24rpx 72rpx;
  max-width: 560rpx;
}
.chat-suggestions-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.chat-suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chat-suggestion-chip {
  max-width: 100%;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.05);
}
@keyframes juji-chat-typing {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.bill-draft {
  max-width: 540rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  border-top-left-radius: 8rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}
.bill-draft-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 14rpx;
}
.bill-draft-row {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.bill-draft-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-draft-cat {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.bill-draft-cat-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text);
}
.bill-draft-tag {
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.bill-draft-tag--income {
  background: rgba(76,175,80,0.16);
  color: #3a8a3e;
}
.bill-draft-tag--new {
  background: rgba(247,166,40,0.18);
  color: #d77f00;
}
.bill-draft-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.bill-draft-yuan {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.bill-draft-amount-input {
  width: 130rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}
.bill-draft-del {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-primary-container);
  flex-shrink: 0;
}
.bill-draft-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
}
.bill-draft-newcat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}
.bill-draft-check {
  width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  font-size: 20rpx;
  color: var(--color-on-primary);
  flex-shrink: 0;
}
.bill-draft-check.is-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.bill-draft-newcat-label {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.bill-draft-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
  line-height: 1.6;
}
.bill-draft-btn--ghost {
  background: var(--color-primary-container);
  color: var(--color-text-secondary);
}
.bill-draft-btn--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}
.bill-draft-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-status--done {
  color: #3a8a3e;
  font-weight: 700;
}
.ai-chat-footer {
  padding: 14rpx 24rpx 22rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}
.ai-chat-notice {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.ai-chat-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ai-chat-input {
  flex: 1;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface-low);
  color: var(--color-text);
  font-size: 27rpx;
  border: 1rpx solid var(--color-border);
}
.ai-chat-send {
  width: 118rpx;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}
.ai-chat-send::after {
  border: none;
}
.ai-chat-send.is-disabled {
  opacity: 0.45;
}
/* 记账打卡热力图 */
.heatmap-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 28rpx 24rpx;
}
.heatmap-nav {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  margin-bottom: 20rpx;
}
.heatmap-arrow { font-size: 36rpx; color: var(--color-primary); padding: 8rpx; opacity: 0.8; }
.heatmap-month { font-size: 28rpx; font-weight: 600; color: var(--color-text); letter-spacing: 1rpx; }
.heatmap-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
  margin-bottom: 12rpx;
}
.heatmap-wd {
  text-align: center; font-size: 20rpx; color: var(--color-text-tertiary);
  font-weight: 500; padding: 4rpx 0;
}
.heatmap-grid {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
}
.heatmap-tile {
  aspect-ratio: 1; border-radius: 8rpx;
  background: var(--color-surface-low);
  box-shadow: inset 2rpx 2rpx 4rpx var(--shadow-dark), inset -2rpx -2rpx 4rpx var(--shadow-light);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.heatmap-tile.is-checked {
  border-radius: 8rpx;
}
.heatmap-tile.is-empty { background: transparent; box-shadow: none; }
.heatmap-day-num {
  font-size: 18rpx; font-weight: 600;
  color: var(--color-text-tertiary);
}
.heatmap-tile.is-checked .heatmap-day-num { color: rgba(255,255,255,0.9); }
.heatmap-summary {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--color-text-tertiary);
  margin-top: 16rpx; margin-bottom: 20rpx;
}
.heatmap-color-section {
  border-top: 1rpx solid var(--color-border);
  padding-top: 20rpx;
}
.heatmap-color-label {
  font-size: 22rpx; color: var(--color-primary); font-weight: 600;
  display: block; margin-bottom: 14rpx; letter-spacing: 1rpx;
}
.heatmap-swatches { display: flex; gap: 16rpx; flex-wrap: wrap; }
.heatmap-swatch {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-soft);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}
.heatmap-swatch.is-active {
  transform: scale(1.15);
  box-shadow: var(--shadow-card);
}
.heatmap-swatch-check { font-size: 22rpx; color: rgba(255,255,255,0.9); font-weight: 700; }
/* 页脚 */
.profile-footer { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 60rpx 0; }
.footer-version { font-size: 22rpx; color: var(--color-text-tertiary); }
.footer-tagline { font-size: 24rpx; color: var(--color-text-secondary); font-style: italic; }
/* 足迹项点击态 */
.footprint-hover { opacity: 0.6; border-radius: 16rpx; }
/* AI 信件弹窗 */
.letter-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
}
.letter-card {
  position: relative;
  width: 88%; max-width: 640rpx;
  background: #FFFAF0;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 55rpx,
    rgba(0,0,0,0.04) 55rpx,
    rgba(0,0,0,0.04) 56rpx
  );
  border-radius: 24rpx;
  padding: 72rpx 48rpx 52rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.18), 0 2rpx 8rpx rgba(0,0,0,0.06);
  display: flex; flex-direction: column;
  background-position: 0 68rpx;
}
.letter-deco {
  position: absolute; top: -24rpx; left: -16rpx;
  font-size: 52rpx;
  filter: drop-shadow(2rpx 4rpx 6rpx rgba(0,0,0,0.15));
}
.letter-salutation {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
  line-height: 56rpx;
}
.letter-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 56rpx;
  text-align: left;
  letter-spacing: 0.5rpx;
  word-break: break-all;
  margin-bottom: 32rpx;
}
.letter-sign {
  align-self: flex-end;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
  margin-bottom: 40rpx;
  line-height: 1;
}
.letter-disclaimer {
  align-self: flex-end;
  margin-top: -16rpx;
  margin-bottom: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  background: rgba(0,0,0,0.04);
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.2;
}
.letter-footer {
  width: 100%;
  display: flex; justify-content: center;
  padding-top: 8rpx;
}
.letter-btn {
  width: 70%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 30rpx; font-weight: 600;
  border-radius: var(--radius-full);
  padding: 22rpx 0;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-elevated);
}
.letter-btn::after { border: none; }
