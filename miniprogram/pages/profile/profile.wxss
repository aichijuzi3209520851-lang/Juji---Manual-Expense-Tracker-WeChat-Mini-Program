.profile-page { padding: 0 var(--space-md); padding-bottom: 60rpx; }
.profile-hero {
  display: flex; align-items: center; gap: 24rpx; padding: 48rpx 0 32rpx;
}
.profile-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--color-surface-high); }
.profile-info { display: flex; flex-direction: column; gap: 8rpx; }
.profile-nickname { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.profile-gender { font-size: 24rpx; color: var(--color-primary); background: var(--color-surface-low); padding: 4rpx 20rpx; border-radius: var(--radius-sm); display: inline-block; width: fit-content; }
/* 菜单区 */
.profile-section { margin-top: 32rpx; }
.profile-section-title { font-size: 24rpx; color: var(--color-primary); font-weight: 600; padding: 0 8rpx 12rpx; display: block; }
.profile-menu { background: var(--color-surface); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(120,86,85,0.03); }
.menu-item {
  display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(212,195,194,0.3);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; }
.menu-label { flex: 1; font-size: 30rpx; color: var(--color-text); font-weight: 500; }
.menu-label.danger-text { color: var(--color-error); }
.menu-arrow { font-size: 36rpx; color: var(--color-text-tertiary); }
.menu-value-wrap { display: flex; align-items: center; gap: 8rpx; }
.menu-value { font-size: 26rpx; color: var(--color-text-secondary); }
.menu-badge { font-size: 22rpx; color: var(--color-text-tertiary); background: var(--color-surface-high); padding: 4rpx 16rpx; border-radius: var(--radius-sm); }
.menu-item.disabled { opacity: 0.6; }
/* 页脚 */
.profile-footer { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 60rpx 0; }
.footer-version { font-size: 22rpx; color: var(--color-text-tertiary); }
.footer-tagline { font-size: 24rpx; color: var(--color-text-secondary); font-style: italic; }
