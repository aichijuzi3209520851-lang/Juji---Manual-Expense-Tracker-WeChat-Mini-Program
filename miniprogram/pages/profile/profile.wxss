.profile-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.profile-hero {
  display: flex; align-items: center; gap: 24rpx;
  padding: 36rpx 32rpx;
  margin-top: 24rpx;
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  position: relative; overflow: hidden;
}
.profile-hero::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.profile-avatar-wrap {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,0.22);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 8rpx 16rpx var(--shadow-dark);
  position: relative; z-index: 1;
  flex-shrink: 0;
}
.profile-avatar { width: 100%; height: 100%; }
.profile-avatar-fallback { font-size: 56rpx; line-height: 1; }
.profile-avatar-hover { opacity: 0.7; }
.profile-info { display: flex; flex-direction: column; gap: 10rpx; position: relative; z-index: 1; }
.profile-nickname { font-size: 40rpx; font-weight: 700; color: var(--color-on-primary); }
.profile-nickname-hover { opacity: 0.7; }
.profile-gender {
  font-size: 22rpx; color: var(--color-on-primary);
  background: rgba(255,255,255,0.25);
  padding: 4rpx 18rpx; border-radius: var(--radius-full);
  display: inline-block; width: fit-content;
  letter-spacing: 1rpx;
}
/* 菜单区 */
.profile-section { margin-top: 32rpx; }
.profile-section-title { font-size: 24rpx; color: var(--color-primary); font-weight: 700; padding: 0 8rpx 12rpx; display: block; letter-spacing: 2rpx; opacity: 0.85; }
.profile-menu {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.menu-item {
  display: flex; align-items: center; gap: 20rpx; padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  font-size: 32rpx;
  width: 64rpx; height: 64rpx;
  background: var(--color-primary-container);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.menu-label { flex: 1; font-size: var(--font-size-body); color: var(--color-text); font-weight: var(--font-weight-medium); }
.menu-label.danger-text { color: var(--color-error); }
.menu-arrow { font-size: var(--font-size-h3); color: var(--color-text-tertiary); }
.menu-value-wrap { display: flex; align-items: center; gap: 8rpx; }
.menu-value { font-size: var(--font-size-regular); color: var(--color-text-secondary); }
.menu-badge { font-size: var(--font-size-small); color: var(--color-primary); background: var(--color-primary-container); padding: 4rpx 16rpx; border-radius: var(--radius-full); font-weight: var(--font-weight-semibold); }
.menu-item.disabled { opacity: 0.6; }
/* 记账足迹 */
.footprint-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 36rpx var(--space-md);
  margin-top: 24rpx; display: flex; align-items: center;
}
.footprint-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.footprint-value { font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); font-family: var(--font-numeric); color: var(--color-primary); font-variant-numeric: tabular-nums; }
.footprint-label { font-size: var(--font-size-small); color: var(--color-text-tertiary); }
.footprint-emoji { font-size: 44rpx; line-height: 1; }
.footprint-divider { width: 2rpx; height: 56rpx; background: var(--color-border); }
/* 记账打卡热力图 */
.heatmap-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 28rpx 24rpx;
}
.heatmap-nav {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  margin-bottom: 20rpx;
}
.heatmap-arrow { font-size: 36rpx; color: var(--color-primary); padding: 8rpx; opacity: 0.8; }
.heatmap-month { font-size: 28rpx; font-weight: 600; color: var(--color-text); letter-spacing: 1rpx; }
.heatmap-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
  margin-bottom: 12rpx;
}
.heatmap-wd {
  text-align: center; font-size: 20rpx; color: var(--color-text-tertiary);
  font-weight: 500; padding: 4rpx 0;
}
.heatmap-grid {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
}
.heatmap-tile {
  aspect-ratio: 1; border-radius: 8rpx;
  background: var(--color-surface-low);
  box-shadow: inset 2rpx 2rpx 4rpx var(--shadow-dark), inset -2rpx -2rpx 4rpx var(--shadow-light);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.heatmap-tile.is-checked {
  border-radius: 8rpx;
}
.heatmap-tile.is-empty { background: transparent; box-shadow: none; }
.heatmap-day-num {
  font-size: 18rpx; font-weight: 600;
  color: var(--color-text-tertiary);
}
.heatmap-tile.is-checked .heatmap-day-num { color: rgba(255,255,255,0.9); }
.heatmap-summary {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--color-text-tertiary);
  margin-top: 16rpx; margin-bottom: 20rpx;
}
.heatmap-color-section {
  border-top: 1rpx solid var(--color-border);
  padding-top: 20rpx;
}
.heatmap-color-label {
  font-size: 22rpx; color: var(--color-primary); font-weight: 600;
  display: block; margin-bottom: 14rpx; letter-spacing: 1rpx;
}
.heatmap-swatches { display: flex; gap: 16rpx; flex-wrap: wrap; }
.heatmap-swatch {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-soft);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}
.heatmap-swatch.is-active {
  transform: scale(1.15);
  box-shadow: var(--shadow-card);
}
.heatmap-swatch-check { font-size: 22rpx; color: rgba(255,255,255,0.9); font-weight: 700; }
/* 页脚 */
.profile-footer { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 60rpx 0; }
.footer-version { font-size: 22rpx; color: var(--color-text-tertiary); }
.footer-tagline { font-size: 24rpx; color: var(--color-text-secondary); font-style: italic; }
/* 足迹项点击态 */
.footprint-hover { opacity: 0.6; border-radius: 16rpx; }
/* AI 信件弹窗 */
.letter-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
}
.letter-card {
  position: relative;
  width: 85%; max-width: 620rpx;
  background: linear-gradient(135deg, #fff9f0 0%, #fff5eb 100%);
  border-radius: var(--radius-2xl);
  padding: 56rpx 44rpx 44rpx;
  box-shadow: var(--shadow-elevated);
  display: flex; flex-direction: column; align-items: center;
}
.letter-deco {
  position: absolute; top: 20rpx; right: 28rpx;
  font-size: 40rpx; opacity: 0.7;
}
.letter-text {
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.75;
  text-align: center;
  letter-spacing: 0.5rpx;
  margin-bottom: 36rpx;
  word-break: break-all;
}
.letter-footer {
  width: 100%;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
}
.letter-sign {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
}
.letter-btn {
  width: 80%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 30rpx; font-weight: 600;
  border-radius: var(--radius-full);
  padding: 22rpx 0;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-elevated);
}
.letter-btn::after { border: none; }
