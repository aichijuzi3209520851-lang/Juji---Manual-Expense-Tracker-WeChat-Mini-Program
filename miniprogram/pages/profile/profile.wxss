.profile-page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-md);
  padding-bottom: 208rpx;
  padding-bottom: calc(208rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.profile-hero {
  display: flex; align-items: center; gap: 24rpx;
  padding: 36rpx 196rpx 36rpx 32rpx;
  margin-top: 36rpx;
  min-height: 152rpx;
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  position: relative; overflow: visible;
}
.profile-hero::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
  pointer-events: none;
}
.profile-avatar-wrap {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,0.22);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 8rpx 16rpx var(--shadow-dark);
  position: relative; z-index: 1;
  flex-shrink: 0;
}
.profile-avatar { width: 100%; height: 100%; }
.profile-avatar-fallback { font-size: 56rpx; line-height: 1; }
.profile-avatar-hover { opacity: 0.7; }
.profile-info { display: flex; flex-direction: column; gap: 10rpx; position: relative; z-index: 1; }
.profile-nickname { font-size: 40rpx; font-weight: 700; color: var(--color-on-primary); }
.profile-nickname-hover { opacity: 0.7; }
.profile-gender {
  font-size: 22rpx; color: var(--color-on-primary);
  background: rgba(255,255,255,0.25);
  padding: 4rpx 18rpx; border-radius: var(--radius-full);
  display: inline-block; width: fit-content;
  letter-spacing: 1rpx;
}
/* 小橘 AI 助手 (Q版萌化形象) */
.juji-pet {
  position: absolute;
  right: 22rpx;
  top: 46rpx;
  width: 150rpx;
  height: 150rpx;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transform-origin: center bottom;
  animation: juji-pet-idle 3.2s ease-in-out infinite;
}
.juji-pet:active {
  transform: scale(0.92) rotate(-3deg);
}
.juji-pet-img {
  position: relative;
  z-index: 2;
  width: 150rpx;
  height: 150rpx;
  transform-origin: 50% 88%;
}
.juji-pet-shadow {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 86rpx;
  height: 16rpx;
  background: rgba(59, 32, 11, 0.15);
  border-radius: 50%;
  filter: blur(3rpx);
  animation: juji-pet-shadow 3.2s ease-in-out infinite;
}
/* 气泡：右对齐并浮在小橘头顶上方（与 record.wxss 保持一致）
   单行不换行 + 右对齐的原因见 record.wxss 注释；语录长度上限见 utils/petPhrases.js */
.juji-pet-bubble {
  position: absolute;
  top: auto;
  right: 6rpx;
  bottom: 140rpx;
  background: #ffffff;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 3.5rpx solid #3b200b;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  white-space: nowrap;
  animation: juji-pet-bubble 1.1s ease both;
  z-index: 4;
}
.juji-pet-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  right: 34rpx;
  left: auto;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #ffffff;
}
/* 粒子（❤／💤／💫／✨）—— 位置、字号、延迟、时长由 utils/petActions.js 的
   PARTICLE_SPECS 内联下发，这里只定义统一的上升淡出轨迹 */
.juji-pet-particle {
  position: absolute;
  z-index: 4;
  opacity: 0;
  pointer-events: none;
  animation: juji-particle-fly 1.4s ease-out forwards;
}
/* 动效增强 —— 与 record.wxss 保持一致，新增动作需两页同步 */
.juji-pet--wave .juji-pet-img {
  animation: juji-pet-wave 0.35s ease-in-out 4;
}
.juji-pet--jump {
  animation: juji-pet-jump 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.juji-pet--heart .juji-pet-img {
  animation: juji-pet-pop 0.55s ease both;
}
.juji-pet--jelly .juji-pet-img {
  animation: juji-pet-jelly 0.9s ease-in-out both;
}
.juji-pet--shake .juji-pet-img {
  animation: juji-pet-shake 0.25s ease-in-out 4;
}
.juji-pet--dance .juji-pet-img {
  animation: juji-pet-dance 0.42s ease-in-out 4;
}
.juji-pet--sleep .juji-pet-img {
  animation: juji-pet-sleep 1.9s ease-in-out both;
}
.juji-pet--dizzy .juji-pet-img {
  animation: juji-pet-dizzy 0.3s ease-in-out 4;
}
.juji-pet--sparkle .juji-pet-img {
  animation: juji-pet-sparkle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes juji-pet-idle {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  50% { transform: translateY(-8rpx) scale(1.03, 0.97); }
}
@keyframes juji-pet-shadow {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.15; }
  50% { transform: translateX(-50%) scale(0.88); opacity: 0.08; }
}
@keyframes juji-pet-wave {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-9deg); }
  75% { transform: rotate(7deg); }
}
@keyframes juji-pet-jump {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-24rpx) scale(0.96, 1.05); }
  70% { transform: translateY(0) scale(1.05, 0.95); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes juji-pet-pop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
/* 果冻弹：先横向撑开压扁，再回弹，模拟软体 */
@keyframes juji-pet-jelly {
  0% { transform: scale(1, 1); }
  25% { transform: scale(1.16, 0.84); }
  45% { transform: scale(0.92, 1.1); }
  65% { transform: scale(1.06, 0.95); }
  85% { transform: scale(0.98, 1.02); }
  100% { transform: scale(1, 1); }
}
/* 抖一抖：小幅快摆，像甩水 */
@keyframes juji-pet-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg); }
  75% { transform: rotate(6deg); }
}
/* 摇摆舞：摆幅更大并带轻微离地 */
@keyframes juji-pet-dance {
  0%, 100% { transform: rotate(0deg) translateY(0); }
  25% { transform: rotate(-10deg) translateY(-4rpx); }
  75% { transform: rotate(10deg) translateY(-4rpx); }
}
/* 打盹：呼吸放慢 + 慢慢歪头 */
@keyframes juji-pet-sleep {
  0%, 100% { transform: rotate(0deg) scale(1, 1); }
  35% { transform: rotate(-5deg) scale(1.02, 0.96); }
  70% { transform: rotate(3deg) scale(1.02, 0.96); }
}
/* 转晕：大角度左右晃 */
@keyframes juji-pet-dizzy {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-14deg); }
  75% { transform: rotate(14deg); }
}
/* 撒花：开心上弹 + 落地压一下 */
@keyframes juji-pet-sparkle {
  0% { transform: translateY(0) scale(0.9); }
  40% { transform: translateY(-22rpx) scale(1.1); }
  70% { transform: translateY(0) scale(0.97, 1.04); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes juji-particle-fly {
  0% { transform: translateY(18rpx) scale(0.6); opacity: 0; }
  25% { opacity: 1; }
  100% { transform: translateY(-56rpx) scale(1.3); opacity: 0; }
}
@keyframes juji-pet-bubble {
  from { transform: translateY(8rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
/* 菜单区 */
.profile-section { margin-top: 32rpx; }
.profile-section-title { font-size: 24rpx; color: var(--color-primary); font-weight: 700; padding: 0 8rpx 12rpx; display: block; letter-spacing: 2rpx; opacity: 0.85; }
.profile-collapsible-wrap { margin-top: 24rpx; }
.profile-menu {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.menu-item {
  display: flex; align-items: center; gap: 20rpx; padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  font-size: 32rpx;
  width: 64rpx; height: 64rpx;
  background: var(--color-primary-container);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.menu-label { flex: 1; font-size: var(--font-size-body); color: var(--color-text); font-weight: var(--font-weight-medium); }
.menu-label.danger-text { color: var(--color-error); }
.menu-arrow { font-size: var(--font-size-h3); color: var(--color-text-tertiary); }
.menu-value-wrap { display: flex; align-items: center; gap: 8rpx; }
.menu-value { font-size: var(--font-size-regular); color: var(--color-text-secondary); }
.menu-badge { font-size: var(--font-size-small); color: var(--color-primary); background: var(--color-primary-container); padding: 4rpx 16rpx; border-radius: var(--radius-full); font-weight: var(--font-weight-semibold); }
.menu-item.disabled { opacity: 0.6; }
.menu-item picker { flex: 1; display: flex; justify-content: flex-end; }
/* 记账足迹 */
.footprint-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 36rpx var(--space-md);
  margin-top: 24rpx; display: flex; align-items: center;
}
.footprint-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.footprint-value-wrap { height: 60rpx; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 12rpx; }
.footprint-value { font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); font-family: var(--font-numeric); color: var(--color-primary); font-variant-numeric: tabular-nums; line-height: 1; }
.footprint-label { font-size: var(--font-size-small); color: var(--color-text-tertiary); line-height: 1; }
.footprint-emoji { font-size: 44rpx; line-height: 1; }
.footprint-title-value {
  max-width: 190rpx;
  font-size: 28rpx;
  line-height: 1.15;
  font-weight: 800;
  color: var(--color-primary);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.footprint-title-value.is-locked {
  color: var(--color-text-tertiary);
}
.footprint-title-value.is-loading {
  color: var(--color-primary);
  animation: profile-title-breathe 1.5s ease-in-out infinite;
}
@keyframes profile-title-breathe {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}
.footprint-divider { width: 2rpx; height: 56rpx; background: var(--color-border); }
/* AI 称号弹窗 */
.title-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9998;
}
.title-card {
  width: 82%;
  max-width: 620rpx;
  box-sizing: border-box;
  border-radius: var(--radius-2xl);
  background: var(--color-surface);
  padding: 42rpx 36rpx 34rpx;
  box-shadow: var(--shadow-elevated);
  border: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title-kicker {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.title-name-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  max-width: 100%;
}
.title-emoji {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--color-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.title-name {
  max-width: 430rpx;
  font-size: 42rpx;
  line-height: 1.15;
  color: var(--color-text);
  font-weight: 900;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.title-source {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.title-reason {
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--color-primary-container);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: left;
}
.title-actions {
  margin-top: 28rpx;
  width: 100%;
  display: flex;
  gap: 18rpx;
}
.title-btn {
  flex: 1;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  padding: 22rpx 0;
  border: none;
}
.title-btn::after {
  border: none;
}
.title-btn--ghost {
  background: var(--color-surface-low);
  color: var(--color-text-secondary);
}
.title-btn--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-soft);
}
/* 小橘 AI 聊天 */
.ai-chat-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transition: bottom 0.18s ease-out;
}
.ai-chat-panel {
  width: 100%;
  height: 86vh;
  max-height: 1320rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: var(--color-bg);
  box-shadow: 0 -12rpx 40rpx rgba(0,0,0,0.18);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transition: height 0.18s ease-out, border-radius 0.18s ease-out;
}
.ai-chat-panel.is-keyboard {
  height: 100%;
  max-height: none;
  border-radius: 0;
  padding-bottom: 0;
}
.ai-chat-header {
  min-height: 112rpx;
  padding: 26rpx 28rpx 20rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.ai-chat-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.ai-chat-logo,
.chat-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--color-primary-container);
  flex-shrink: 0;
  overflow: hidden;
}
.ai-chat-name {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 800;
  line-height: 1.2;
}
.ai-chat-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
}
.ai-chat-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-low);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
.ai-chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 18rpx;
  box-sizing: border-box;
}
.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.chat-row--user {
  flex-direction: row-reverse;
}
.chat-avatar-img {
  width: 100%;
  height: 100%;
}
.chat-avatar--fallback {
  background: var(--color-primary-container);
  color: var(--color-primary);
  font-size: 36rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-bubble {
  max-width: 510rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}
.chat-bubble--assistant {
  background: var(--color-surface);
  color: var(--color-text);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--color-border);
}
.chat-bubble--user {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-top-right-radius: 8rpx;
}
/* 代码回答：加宽气泡 + 等宽字体，减少折行与缩进错位 */
.chat-bubble--code {
  max-width: 620rpx;
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 22rpx;
  line-height: 1.45;
  border-left: 4rpx solid var(--color-primary);
}
.chat-bubble--typing {
  color: var(--color-text-tertiary);
  animation: juji-chat-typing 1.2s ease-in-out infinite;
}
.chat-suggestions {
  margin: -6rpx 0 24rpx 72rpx;
  max-width: 560rpx;
}
.chat-suggestions-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.chat-suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chat-suggestion-chip {
  max-width: 100%;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.05);
}
@keyframes juji-chat-typing {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.bill-draft {
  max-width: 540rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  border-top-left-radius: 8rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}
.bill-draft-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 14rpx;
}
.bill-draft-row {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.bill-draft-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-draft-cat {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.bill-draft-cat-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text);
}
.bill-draft-tag {
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.bill-draft-tag--income {
  background: rgba(76,175,80,0.16);
  color: #3a8a3e;
}
.bill-draft-tag--new {
  background: rgba(247,166,40,0.18);
  color: #d77f00;
}
.bill-draft-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.bill-draft-yuan {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.bill-draft-amount-input {
  width: 130rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}
.bill-draft-del {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-primary-container);
  flex-shrink: 0;
}
.bill-draft-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
}
.bill-draft-newcat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}
.bill-draft-check {
  width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  font-size: 20rpx;
  color: var(--color-on-primary);
  flex-shrink: 0;
}
.bill-draft-check.is-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.bill-draft-newcat-label {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.bill-draft-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
  line-height: 1.6;
}
.bill-draft-btn--ghost {
  background: var(--color-primary-container);
  color: var(--color-text-secondary);
}
.bill-draft-btn--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}
.bill-draft-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-status--done {
  color: #3a8a3e;
  font-weight: 700;
}
.ai-chat-footer {
  padding: 14rpx 24rpx 22rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}
.ai-chat-notice {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.ai-chat-input-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}
.ai-chat-input {
  flex: 1;
  min-height: 76rpx;
  max-height: 220rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-surface-low);
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 44rpx;
  border: 1rpx solid var(--color-border);
  overflow-y: auto;
  word-break: break-all;
  white-space: pre-wrap;
  transition: height 0.18s ease;
}
.ai-chat-send {
  flex-shrink: 0;
  width: 118rpx;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}
.ai-chat-send::after {
  border: none;
}
.ai-chat-send.is-disabled {
  opacity: 0.45;
}
/* 记账打卡热力图 */
.heatmap-card {
  background: var(--color-surface); border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card); padding: 28rpx 24rpx;
}
.heatmap-nav {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  margin-bottom: 20rpx;
}
.heatmap-arrow { font-size: 36rpx; color: var(--color-primary); padding: 8rpx; opacity: 0.8; }
.heatmap-month { font-size: 28rpx; font-weight: 600; color: var(--color-text); letter-spacing: 1rpx; }
.heatmap-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
  margin-bottom: 12rpx;
}
.heatmap-wd {
  text-align: center; font-size: 20rpx; color: var(--color-text-tertiary);
  font-weight: 500; padding: 4rpx 0;
}
.heatmap-grid {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx;
}
.heatmap-tile {
  aspect-ratio: 1; border-radius: 8rpx;
  background: var(--color-surface-low);
  box-shadow: inset 2rpx 2rpx 4rpx var(--shadow-dark), inset -2rpx -2rpx 4rpx var(--shadow-light);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.heatmap-tile.is-checked {
  border-radius: 8rpx;
}
.heatmap-tile.is-empty { background: transparent; box-shadow: none; }
.heatmap-day-num {
  font-size: 18rpx; font-weight: 600;
  color: var(--color-text-tertiary);
}
.heatmap-tile.is-checked .heatmap-day-num { color: rgba(255,255,255,0.9); }
.heatmap-summary {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--color-text-tertiary);
  margin-top: 16rpx; margin-bottom: 20rpx;
}
.heatmap-color-section {
  border-top: 1rpx solid var(--color-border);
  padding-top: 20rpx;
}
.heatmap-color-label {
  font-size: 22rpx; color: var(--color-primary); font-weight: 600;
  display: block; margin-bottom: 14rpx; letter-spacing: 1rpx;
}
.heatmap-swatches { display: flex; gap: 16rpx; flex-wrap: wrap; }
.heatmap-swatch {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-soft);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}
.heatmap-swatch.is-active {
  transform: scale(1.15);
  box-shadow: var(--shadow-card);
}
.heatmap-swatch-check { font-size: 22rpx; color: rgba(255,255,255,0.9); font-weight: 700; }
/* 页脚 */
/* 帮助与教程入口 */
.help-entry {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 30rpx 32rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-dark);
}
.help-entry-hover { opacity: 0.75; }
.help-entry--stacked { margin-top: 20rpx; }
.help-entry-icon { font-size: 36rpx; margin-right: 20rpx; }
.help-entry-label { flex: 1; font-size: 30rpx; font-weight: 600; color: var(--color-text); }
.help-entry-desc { font-size: 24rpx; color: var(--color-text-tertiary); margin-right: 12rpx; }
.help-entry-arrow { font-size: 32rpx; color: var(--color-text-tertiary); }

.profile-footer { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 60rpx 0; }
.footer-version { font-size: 22rpx; color: var(--color-text-tertiary); }
.footer-tagline { font-size: 24rpx; color: var(--color-text-secondary); font-style: italic; }
/* 足迹项点击态 */
.footprint-hover { opacity: 0.6; border-radius: 16rpx; }
/* AI 信件弹窗 */
.letter-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
}
.letter-card {
  position: relative;
  width: 88%; max-width: 640rpx;
  background: #FFFAF0;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 55rpx,
    rgba(0,0,0,0.04) 55rpx,
    rgba(0,0,0,0.04) 56rpx
  );
  border-radius: 24rpx;
  padding: 72rpx 48rpx 52rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.18), 0 2rpx 8rpx rgba(0,0,0,0.06);
  display: flex; flex-direction: column;
  background-position: 0 68rpx;
}
.letter-deco {
  position: absolute; top: -24rpx; left: -16rpx;
  font-size: 52rpx;
  filter: drop-shadow(2rpx 4rpx 6rpx rgba(0,0,0,0.15));
}
.letter-salutation {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
  line-height: 56rpx;
}
.letter-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 56rpx;
  text-align: left;
  letter-spacing: 0.5rpx;
  word-break: break-all;
  margin-bottom: 32rpx;
}
.letter-sign {
  align-self: flex-end;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
  margin-bottom: 40rpx;
  line-height: 1;
}
.letter-disclaimer {
  align-self: flex-end;
  margin-top: -16rpx;
  margin-bottom: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  background: rgba(0,0,0,0.04);
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.2;
}
.letter-footer {
  width: 100%;
  display: flex; justify-content: center;
  padding-top: 8rpx;
}
.letter-btn {
  width: 70%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 30rpx; font-weight: 600;
  border-radius: var(--radius-full);
  padding: 22rpx 0;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-elevated);
}
.letter-btn::after { border: none; }

/* 隐私授权弹窗 */
.privacy-auth-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 10000;
  padding: 0 64rpx;
}
.privacy-auth-modal {
  width: 100%;
  max-width: 560rpx;
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  padding: 52rpx 44rpx 44rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: var(--shadow-elevated);
}
.privacy-auth-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.privacy-auth-title {
  font-size: 36rpx; font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.privacy-auth-desc {
  font-size: 28rpx; line-height: 1.6;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 36rpx;
}
.privacy-auth-btn {
  width: 100%;
  height: 88rpx;
  margin: 0 0 20rpx;
  padding: 0;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 30rpx; font-weight: 600;
  border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  border: none;
  box-shadow: var(--shadow-btn-primary);
}
.privacy-auth-btn::after { border: none; }
.privacy-auth-btn--cancel {
  background: transparent;
  color: var(--color-text-secondary);
  box-shadow: none;
  margin-bottom: 0;
}
/* 微信资料授权引导条 */
.wechat-profile-tip {
  display: flex; align-items: center; justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 0 0;
  padding: 24rpx 28rpx;
  background: var(--gradient-hero);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}
.wechat-profile-tip-text { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.wechat-profile-tip-title { font-size: 28rpx; font-weight: 700; color: var(--color-text); }
.wechat-profile-tip-sub { font-size: 22rpx; color: var(--color-text-secondary); }
.wechat-profile-tip-btn {
  flex-shrink: 0;
  margin: 0; padding: 0 32rpx;
  height: 64rpx; line-height: 64rpx;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 26rpx; font-weight: 600;
  border-radius: var(--radius-full);
  border: none;
  box-shadow: var(--shadow-btn-primary);
}
.wechat-profile-tip-btn::after { border: none; }
.wechat-profile-tip-btn-hover { opacity: 0.7; }
/* 微信资料授权弹窗 */
.wechat-profile-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; justify-content: center;
  z-index: 9999;
  /* 键盘抬起时通过 inline bottom 上移整个弹层（与 AI 聊天面板同一套做法） */
  transition: bottom 0.18s ease-out;
}
/* 弹层：块级布局 + text-align 居中，避免 flex 列把子项（圆形头像/按钮行）挤扁；
   max-height + 纵向滚动兜底，保证任何机型上「取消/保存」都不会被挤出屏幕 */
.wechat-profile-sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  box-sizing: border-box;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  text-align: center;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
}
.wechat-profile-sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: var(--color-text); margin-bottom: 16rpx; }
.wechat-profile-sheet-desc { display: block; font-size: 24rpx; line-height: 1.6; color: var(--color-text-secondary); margin-bottom: 32rpx; }

/* 头像：view 固定成 168×168 正圆（视觉），button 只做铺满的透明点击层 */
.wechat-profile-avatar-picker {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-bg);
}
/* 虚线圈画在伪元素上：不占布局空间，头像图片得以铺满整个圆 */
.wechat-profile-avatar-picker::after {
  content: '';
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border: 2rpx dashed var(--color-border);
  border-radius: 50%;
  pointer-events: none;
}
/* 已有头像时去掉虚线圈，让照片干净地铺满圆形 */
.wechat-profile-avatar-picker.is-filled::after { display: none; }
.wechat-profile-avatar-img { display: block; width: 100%; height: 100%; }
.wechat-profile-avatar-placeholder {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
}
.wechat-profile-avatar-plus { font-size: 52rpx; color: var(--color-text-tertiary); line-height: 1; }
.wechat-profile-avatar-hint { font-size: 20rpx; color: var(--color-text-tertiary); }
.wechat-profile-avatar-hit {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  max-width: 100%; max-height: 100%;
  padding: 0; margin: 0; border: none; border-radius: 50%;
  background: transparent; color: transparent; line-height: 0; font-size: 0;
}
.wechat-profile-avatar-hit::after { border: none; }
.wechat-profile-avatar-hit-hover { background: rgba(0,0,0,0.04); }
.wechat-profile-nickname-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--color-bg);
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
  text-align: left;
  margin-bottom: 36rpx;
}
.wechat-profile-nickname-ph { color: var(--color-text-tertiary); }
.wechat-profile-sheet-actions { display: flex; gap: 20rpx; width: 100%; }
.wechat-profile-cancel, .wechat-profile-confirm {
  flex: 1; margin: 0; height: 88rpx; line-height: 88rpx;
  font-size: 30rpx; font-weight: 600; border-radius: var(--radius-full); border: none;
}
.wechat-profile-cancel { background: var(--color-primary-container); color: var(--color-text-secondary); }
.wechat-profile-confirm { background: var(--color-primary); color: var(--color-on-primary); box-shadow: var(--shadow-btn-primary); }
.wechat-profile-cancel::after, .wechat-profile-confirm::after { border: none; }
.wechat-profile-cancel-hover { opacity: 0.7; }
.wechat-profile-confirm-hover { opacity: 0.85; }
.wechat-profile-confirm[disabled] { opacity: 0.5; }
