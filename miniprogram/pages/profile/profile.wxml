<!-- 我的页面 -->
<view class="profile-page">

  <!-- 用户信息 -->
  <view class="profile-hero">
    <view class="profile-avatar-wrap" bindtap="changeAvatar" hover-class="profile-avatar-hover">
      <image wx:if="{{avatarUrl && !avatarError}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else class="profile-avatar-fallback">🍊</text>
    </view>
    <view class="profile-info">
      <text class="profile-nickname" bindtap="editNickname" hover-class="profile-nickname-hover">{{nickname}}</text>
      <text class="profile-gender" bindtap="setGender">{{genderText}}</text>
    </view>
  </view>

  <!-- 记账足迹 -->
  <view class="footprint-card" wx:if="{{footprint}}">
    <view class="footprint-item" bindtap="onTapDays" hover-class="footprint-hover">
      <text class="footprint-value">{{footprint.days}}</text>
      <text class="footprint-label">记账天数</text>
    </view>
    <view class="footprint-divider"></view>
    <view class="footprint-item" bindtap="onTapCount" hover-class="footprint-hover">
      <text class="footprint-value">{{footprint.count}}</text>
      <text class="footprint-label">累计笔数</text>
    </view>
    <view class="footprint-divider"></view>
    <view class="footprint-item" bindtap="onTapTopCategory" hover-class="footprint-hover">
      <text class="footprint-emoji">{{footprint.topCategory.emoji}}</text>
      <text class="footprint-label">最爱{{footprint.topCategory.name}}</text>
    </view>
  </view>

  <!-- AI 图片弹窗 -->
  <view class="ai-poster-modal" wx:if="{{showPoster}}" catchtap="closePoster">
    <view class="ai-poster-content" catchtap="">
      <!-- 加载态 -->
      <view class="ai-poster-loading" wx:if="{{posterLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">{{loadingTip}}</text>
        <text class="loading-sub" wx:if="{{posterRemaining >= 0}}">今日剩余 {{posterRemaining}}/{{posterTotalLimit}} 次</text>
      </view>
      <!-- 图片展示 -->
      <view wx:if="{{!posterLoading && posterUrl}}" class="poster-img-wrap">
        <image
          class="ai-poster-img"
          src="{{posterUrl}}"
          mode="widthFix"
          show-menu-by-longpress
        />
        <text class="poster-ai-disclaimer">🎨 该图片由混元AI生成，仅供娱乐</text>
      </view>
      <!-- 错误态 -->
      <view class="ai-poster-error" wx:if="{{!posterLoading && !posterUrl}}">
        <text class="error-icon">😢</text>
        <text class="error-text">{{posterError || '生成失败，请重试'}}</text>
      </view>
      <!-- 关闭按钮 -->
      <view class="poster-close-btn" bindtap="closePoster">✕</view>
    </view>
  </view>

  <!-- 个性化设置 -->
  <view class="profile-section">
    <text class="profile-section-title">个性化设置</text>
    <view class="profile-menu">
      <view class="menu-item" bindtap="manageCategories">
        <text class="menu-icon">🏷️</text>
        <text class="menu-label">自定义分类</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="switchTheme">
        <text class="menu-icon">🎨</text>
        <text class="menu-label">主题</text>
        <view class="menu-value-wrap">
          <text class="menu-value">{{themeName}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据与隐私 -->
  <view class="profile-section">
    <text class="profile-section-title">数据与隐私</text>
    <view class="profile-menu">
      <view class="menu-item" bindtap="exportData">
        <text class="menu-icon">📥</text>
        <text class="menu-label">导出数据</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item danger" bindtap="clearData">
        <text class="menu-icon">🗑️</text>
        <text class="menu-label danger-text">清除所有数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本 -->
  <view class="profile-footer">
    <text class="footer-version">版本 1.0.0</text>
    <text class="footer-tagline">用 ❤️ 和很多面条 🍜 做成</text>
  </view>

</view>
