<!-- 我的页面 -->
<view class="profile-page" style="{{themeStyle}}">

  <!-- 用户信息 -->
  <view class="profile-hero">
    <view class="profile-avatar-wrap" bindtap="changeAvatar" hover-class="profile-avatar-hover">
      <image wx:if="{{avatarUrl && !avatarError}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else class="profile-avatar-fallback">🍊</text>
    </view>
    <view class="profile-info">
      <text class="profile-nickname" bindtap="editNickname" hover-class="profile-nickname-hover">{{nickname}}</text>
      <text class="profile-gender" bindtap="setGender">{{genderText}}</text>
    </view>
    <view class="juji-pet juji-pet--{{petAction}}" bindtap="openAiChat" aria-label="小橘AI助手">
      <view wx:if="{{petBubble}}" class="juji-pet-bubble">{{petBubble}}</view>
      <view wx:for="{{petHearts}}" wx:key="id" class="juji-pet-heart">❤</view>
      <view class="juji-pet-shadow"></view>
      <view class="juji-pet-body">
        <view class="juji-pet-leaf"></view>
        <view class="juji-pet-face">
          <view class="juji-pet-eye juji-pet-eye--left"></view>
          <view class="juji-pet-eye juji-pet-eye--right"></view>
          <view class="juji-pet-mouth"></view>
        </view>
        <view class="juji-pet-arm juji-pet-arm--left"></view>
        <view class="juji-pet-arm juji-pet-arm--right"></view>
        <view class="juji-pet-foot juji-pet-foot--left"></view>
        <view class="juji-pet-foot juji-pet-foot--right"></view>
      </view>
    </view>
  </view>

  <!-- 记账足迹 -->
  <view class="footprint-card" wx:if="{{footprint}}">
    <view class="footprint-item" bindtap="onTapDays" hover-class="footprint-hover">
      <view class="footprint-value-wrap">
        <text class="footprint-value">{{footprint.days}}</text>
      </view>
      <text class="footprint-label">记账天数</text>
    </view>
    <view class="footprint-divider"></view>
    <view class="footprint-item" bindtap="onTapCount" hover-class="footprint-hover">
      <view class="footprint-value-wrap">
        <text class="footprint-value">{{footprint.count}}</text>
      </view>
      <text class="footprint-label">累计笔数</text>
    </view>
    <view class="footprint-divider"></view>
    <view class="footprint-item" bindtap="onTapTopCategory" hover-class="footprint-hover">
      <view class="footprint-value-wrap">
        <text class="footprint-title-value {{profileTitle.status === 'locked' ? 'is-locked' : ''}} {{profileTitle.status === 'loading' ? 'is-loading' : ''}}">{{profileTitle.title}}</text>
      </view>
      <text class="footprint-label">今日称号</text>
    </view>
  </view>

  <!-- 个人资料 -->
  <view class="profile-section">
    <text class="profile-section-title">个人资料</text>
    <view class="profile-menu">
      <view class="menu-item">
        <text class="menu-icon">🎂</text>
        <text class="menu-label">出生日期</text>
        <picker mode="date" value="{{birthday}}" start="1940-01-01" end="2015-12-31" bindchange="onBirthdayChange">
          <view class="menu-value-wrap">
            <text class="menu-value">{{birthdayDisplay || '未设置'}}</text>
            <text class="menu-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="menu-item" wx:if="{{zodiac}}">
        <text class="menu-icon">✨</text>
        <text class="menu-label">星座</text>
        <text class="menu-value">{{zodiac}}</text>
      </view>
      <view class="menu-item" bindtap="setOccupation">
        <text class="menu-icon">💼</text>
        <text class="menu-label">职业/状态</text>
        <view class="menu-value-wrap">
          <text class="menu-value">{{occupation || '未设置'}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 今日称号解释弹窗 -->
  <view class="title-modal" wx:if="{{showProfileTitle}}" catchtap="closeProfileTitle">
    <view class="title-card" catchtap="">
      <text class="title-kicker">今日称号</text>
      <view class="title-name-row">
        <text class="title-emoji">{{profileTitle.emoji}}</text>
        <text class="title-name">{{profileTitle.title}}</text>
      </view>
      <text class="title-source" wx:if="{{profileTitle.status !== 'locked'}}">来自今日「{{profileTitle.category}}」支出</text>
      <text class="title-reason">{{profileTitle.reason}}</text>
      <view class="title-actions">
        <button class="title-btn title-btn--ghost" bindtap="closeProfileTitle">知道了</button>
        <button wx:if="{{profileTitle.status === 'ready'}}" class="title-btn title-btn--primary" bindtap="writeLetterFromTitle">看看小橘心里话</button>
      </view>
    </view>
  </view>

  <!-- 小橘 AI 助手聊天弹窗 -->
  <view class="ai-chat-modal" wx:if="{{showAiChat}}" style="{{chatModalStyle}}" catchtap="closeAiChat" catchtouchmove="noop">
    <view class="ai-chat-panel {{chatKeyboardHeight > 0 ? 'is-keyboard' : ''}}" catchtap="noop">
      <view class="ai-chat-header">
        <view class="ai-chat-title">
          <image class="ai-chat-logo" src="/images/juji2.jpg" mode="aspectFill" />
          <view>
            <text class="ai-chat-name">小橘 AI 助手</text>
            <text class="ai-chat-subtitle">AI生成，仅供参考</text>
          </view>
        </view>
        <text class="ai-chat-close" bindtap="closeAiChat">×</text>
      </view>

      <scroll-view class="ai-chat-body" scroll-y="{{true}}" scroll-into-view="{{chatScrollTo}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view wx:for="{{chatMessages}}" wx:key="id" id="{{item.id}}" class="chat-row chat-row--{{item.role}}">
          <image wx:if="{{item.role === 'assistant'}}" class="chat-avatar" src="/images/juji2.jpg" mode="aspectFill" />
          <view wx:if="{{item.role === 'user' && avatarUrl && !avatarError}}" class="chat-avatar chat-avatar--user-img">
            <image class="chat-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          </view>
          <view wx:if="{{item.role === 'user' && (!avatarUrl || avatarError)}}" class="chat-avatar chat-avatar--fallback">我</view>

          <!-- 待确认账单卡 -->
          <view wx:if="{{item.type === 'billDraft'}}" class="bill-draft">
            <view class="bill-draft-title">理出这几笔，确认下吧</view>
            <view wx:for="{{item.drafts}}" wx:for-item="row" wx:key="key" class="bill-draft-row">
              <view class="bill-draft-main">
                <view class="bill-draft-cat">
                  <text class="bill-draft-cat-name">{{row.category}}</text>
                  <text wx:if="{{row.type === 'income'}}" class="bill-draft-tag bill-draft-tag--income">收入</text>
                  <text wx:if="{{row.isNewCategory}}" class="bill-draft-tag bill-draft-tag--new">新</text>
                </view>
                <view class="bill-draft-amount">
                  <text class="bill-draft-yuan">¥</text>
                  <input class="bill-draft-amount-input" type="digit" value="{{row.amountText}}" disabled="{{item.status !== 'pending'}}" data-msg="{{item.id}}" data-key="{{row.key}}" bindinput="onDraftAmountInput" />
                </view>
                <view wx:if="{{item.status === 'pending'}}" class="bill-draft-del" data-msg="{{item.id}}" data-key="{{row.key}}" bindtap="removeDraftRow">✕</view>
              </view>
              <input class="bill-draft-note" value="{{row.note}}" placeholder="备注（可选）" maxlength="30" disabled="{{item.status !== 'pending'}}" data-msg="{{item.id}}" data-key="{{row.key}}" bindinput="onDraftNoteInput" />
              <view wx:if="{{row.isNewCategory && item.status === 'pending'}}" class="bill-draft-newcat" data-msg="{{item.id}}" data-key="{{row.key}}" bindtap="toggleDraftNewCategory">
                <text class="bill-draft-check {{row.createNew ? 'is-on' : ''}}">{{row.createNew ? '✓' : ''}}</text>
                <text class="bill-draft-newcat-label">创建新分类「{{row.category}}」（不勾则归「其他」）</text>
              </view>
            </view>
            <view wx:if="{{item.status === 'pending'}}" class="bill-draft-actions">
              <button class="bill-draft-btn bill-draft-btn--ghost" data-msg="{{item.id}}" bindtap="cancelBillDraft">取消</button>
              <button class="bill-draft-btn bill-draft-btn--primary" data-msg="{{item.id}}" bindtap="confirmBillDraft">确认记账</button>
            </view>
            <view wx:if="{{item.status === 'saving'}}" class="bill-draft-status">记账中...</view>
            <view wx:if="{{item.status === 'done'}}" class="bill-draft-status bill-draft-status--done">✓ 已记账</view>
          </view>

          <view wx:else class="chat-bubble chat-bubble--{{item.role}}">{{item.content}}</view>
        </view>
        <view wx:if="{{showChatSuggestions}}" class="chat-suggestions">
          <text class="chat-suggestions-title">可以这样问小橘</text>
          <view class="chat-suggestion-list">
            <view wx:for="{{chatSuggestions}}" wx:for-item="suggestion" wx:key="*this" class="chat-suggestion-chip" data-text="{{suggestion}}" bindtap="sendChatSuggestion">{{suggestion}}</view>
          </view>
        </view>
        <view wx:if="{{chatLoading}}" id="chat_loading" class="chat-row chat-row--assistant">
          <image class="chat-avatar" src="/images/juji2.jpg" mode="aspectFill" />
          <view class="chat-bubble chat-bubble--assistant chat-bubble--typing">小橘正在想...</view>
        </view>
      </scroll-view>

      <view class="ai-chat-footer">
        <text class="ai-chat-notice">AI生成，仅供参考，请勿输入敏感个人信息。</text>
        <view class="ai-chat-input-row">
          <input class="ai-chat-input" value="{{chatInput}}" bindinput="onChatInput" bindblur="onChatInputBlur" bindconfirm="sendChatMessage" bindkeyboardheightchange="onChatKeyboardHeightChange" confirm-type="send" adjust-position="{{false}}" cursor-spacing="12" placeholder="和小橘聊聊..." maxlength="300" />
          <button class="ai-chat-send {{chatLoading || !chatInput ? 'is-disabled' : ''}}" bindtap="sendChatMessage">发送</button>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 信件弹窗 -->
  <view class="letter-modal" wx:if="{{showLetter}}" catchtap="closeLetter">
    <view class="letter-card" catchtap="">
      <text class="letter-deco">🍊</text>
      <text class="letter-salutation">亲爱的{{nickname}}：</text>
      <text class="letter-text">{{letterText}}</text>
      <text class="letter-disclaimer">AI生成，仅供娱乐</text>
      <text class="letter-sign">—— 你的赛博知己 小橘</text>
      <view class="letter-footer">
        <button class="letter-btn" bindtap="closeLetter">收下心意</button>
      </view>
    </view>
  </view>

  <!-- 记账打卡热力图 -->
  <view class="profile-section">
    <text class="profile-section-title">记账打卡</text>
    <view class="heatmap-card">
      <view class="heatmap-nav">
        <text class="heatmap-arrow" bindtap="heatmapPrev">‹</text>
        <text class="heatmap-month">{{heatmapMonth}}</text>
        <text class="heatmap-arrow" bindtap="heatmapNext">›</text>
      </view>
      <view class="heatmap-weekdays">
        <text wx:for="{{weekdays}}" wx:key="*this" class="heatmap-wd">{{item}}</text>
      </view>
      <view class="heatmap-grid">
        <view wx:for="{{heatmapDays}}" wx:key="day"
              class="heatmap-tile {{item.checked ? 'is-checked' : ''}} {{item.day === 0 ? 'is-empty' : ''}}"
              style="{{item.checked ? 'background:' + heatmapColor + ';box-shadow:-2rpx -2rpx 6rpx rgba(255,255,255,0.8),2rpx 2rpx 6rpx ' + heatmapShadowDark : ''}}">
          <text class="heatmap-day-num" wx:if="{{item.day > 0}}">{{item.day}}</text>
        </view>
      </view>
      <text class="heatmap-summary">本月打卡 {{heatmapCheckedCount}} 天</text>
      <view class="heatmap-color-section">
        <text class="heatmap-color-label">打卡颜色</text>
        <view class="heatmap-swatches">
          <view class="heatmap-swatch {{heatmapCustomColor === '' ? 'is-active' : ''}}"
                style="background: var(--color-primary);"
                bindtap="pickHeatmapColor" data-hex="">
            <text class="heatmap-swatch-check" wx:if="{{heatmapCustomColor === ''}}">✓</text>
          </view>
          <view wx:for="{{heatmapPalette}}" wx:key="hex"
                class="heatmap-swatch {{heatmapCustomColor === item.hex ? 'is-active' : ''}}"
                style="background: {{item.hex}};"
                bindtap="pickHeatmapColor" data-hex="{{item.hex}}">
            <text class="heatmap-swatch-check" wx:if="{{heatmapCustomColor === item.hex}}">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 个性化设置 -->
  <view class="profile-section">
    <text class="profile-section-title">个性化设置</text>
    <view class="profile-menu">
      <view class="menu-item" bindtap="manageCategories">
        <text class="menu-icon">🏷️</text>
        <text class="menu-label">自定义分类</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="switchTheme">
        <text class="menu-icon">🎨</text>
        <text class="menu-label">主题</text>
        <view class="menu-value-wrap">
          <text class="menu-value">{{themeName}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据与隐私 -->
  <view class="profile-section">
    <text class="profile-section-title">数据与隐私</text>
    <view class="profile-menu">
      <view class="menu-item" bindtap="exportData">
        <text class="menu-icon">📤</text>
        <text class="menu-label">导出账单数据</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="importData">
        <text class="menu-icon">📥</text>
        <text class="menu-label">导入账单数据</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="viewPrivacyAgreement">
        <text class="menu-icon">🔐</text>
        <text class="menu-label">隐私协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="viewUserAgreement">
        <text class="menu-icon">📄</text>
        <text class="menu-label">用户协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item danger" bindtap="clearData">
        <text class="menu-icon">🗑️</text>
        <text class="menu-label danger-text">清除所有数据</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="logout">
        <text class="menu-icon">🚪</text>
        <text class="menu-label">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本 -->
  <view class="profile-footer">
    <text class="footer-version">版本 1.0.0</text>
    <text class="footer-tagline">一颗橘子，陪你记账 📒</text>
  </view>

</view>
