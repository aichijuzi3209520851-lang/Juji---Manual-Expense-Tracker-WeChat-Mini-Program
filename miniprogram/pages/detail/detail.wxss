.detail-page {
  min-height: 100vh;
  padding: 0 var(--space-md) 80rpx;
  background: linear-gradient(180deg, #fdf8f2 0%, #faf3ec 100%);
  display: flex; flex-direction: column; align-items: center;
}

/* 照片 — 拍立得风格 */
.detail-photo {
  width: 100%; margin-top: 32rpx; position: relative;
}
.detail-photo-img {
  width: 100%; border-radius: 24rpx;
  border: 4rpx solid rgba(120, 86, 85, 0.08);
  box-shadow: 0 12rpx 40rpx rgba(120, 86, 85, 0.06),
              inset 0 0 0 2rpx rgba(255, 255, 255, 0.9);
}

/* 金额 */
.detail-amount-row {
  padding: 48rpx 0 32rpx;
}
.detail-amount {
  font-size: 80rpx; font-weight: 700; color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}
.detail-amount.is-income { color: var(--color-income); }

/* 心情印章 */
.detail-mood { margin-bottom: 32rpx; }
.detail-mood-stamp {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(254, 252, 249, 0.85);
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(120, 86, 85, 0.06);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
}
.detail-mood-stamp.has-mood {
  background: var(--color-primary-container);
  box-shadow: 0 10rpx 28rpx rgba(120, 86, 85, 0.1);
}
.detail-mood-empty {
  font-size: 20rpx; color: var(--color-text-tertiary); text-align: center; line-height: 1.3;
}

/* 分类 */
.detail-category {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;
}
.detail-cat-icon { font-size: 44rpx; }
.detail-cat-name { font-size: 32rpx; font-weight: 600; color: var(--color-text); }

/* 日期 */
.detail-date { margin-bottom: 36rpx; }
.detail-date-text {
  font-size: 26rpx; color: var(--color-text-secondary);
  background: rgba(255,255,255,0.6); padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
}

/* 备注纸片 */
.detail-note { width: 100%; margin-bottom: 48rpx; }
.detail-note-paper {
  position: relative;
  background: #fefcf9; border-radius: var(--radius-xl);
  border: 1rpx solid rgba(120, 86, 85, 0.05);
  box-shadow: 0 4rpx 24rpx rgba(120, 86, 85, 0.04);
  padding: 36rpx 32rpx; min-height: 120rpx;
}
.detail-note-lines {
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    180deg,
    transparent,
    transparent 42rpx,
    rgba(120, 86, 85, 0.04) 42rpx,
    rgba(120, 86, 85, 0.04) 43rpx
  );
  border-radius: var(--radius-xl); pointer-events: none;
}
.detail-note-text {
  position: relative; z-index: 1;
  font-size: 32rpx; color: var(--color-text); line-height: 1.75;
}
.detail-note-placeholder {
  position: relative; z-index: 1;
  font-size: 28rpx; color: var(--color-text-tertiary); font-style: italic;
}

/* 操作按钮区 */
.detail-actions { width: 100%; padding-top: 32rpx; display: flex; flex-direction: column; gap: 20rpx; }
.detail-edit-btn {
  width: 100%; background: var(--color-primary); color: #fff;
  font-size: 28rpx; font-weight: 600; border-radius: var(--radius-full);
  padding: 22rpx 0; text-align: center;
}
.detail-edit-btn::after { border: none; }
.detail-delete-btn {
  width: 100%; background: transparent; color: var(--color-error);
  font-size: 26rpx; font-weight: 500; border: 1rpx dashed var(--color-error-container);
  border-radius: var(--radius-full); padding: 18rpx 0; text-align: center;
}
.detail-delete-btn::after { border: none; }

/* 加载 */
.detail-loading {
  display: flex; align-items: center; justify-content: center;
  min-height: 60vh;
}
.detail-loading-text {
  font-size: 30rpx; color: var(--color-text-tertiary);
  animation: juji-breathe 1.6s ease-in-out infinite alternate;
}
