<view class="login-page" style="{{themeStyle}}">
  <view class="login-glow login-glow-top"></view>
  <view class="login-glow login-glow-bottom"></view>

  <image class="float-icon float-bag drift-a" src="/images/login/bag.svg" mode="aspectFit" />
  <image class="float-icon float-utensils drift-b" src="/images/login/utensils.svg" mode="aspectFit" />
  <image class="float-icon float-plane drift-c" src="/images/login/plane.svg" mode="aspectFit" />
  <image class="float-icon float-car drift-d" src="/images/login/car.svg" mode="aspectFit" />
  <image class="float-icon float-mug drift-b" src="/images/login/mug.svg" mode="aspectFit" />
  <image class="float-icon float-masks drift-a" src="/images/login/masks.svg" mode="aspectFit" />
  <image class="float-icon float-cart drift-c" src="/images/login/cart.svg" mode="aspectFit" />
  <image class="float-icon float-wheel drift-d" src="/images/login/wheel.svg" mode="aspectFit" />

  <view class="login-main">
    <view class="login-logo-frame">
      <image class="login-logo" src="/images/juji2.jpg" mode="aspectFill" />
    </view>
    <text class="login-title">橘记</text>
    <text class="login-tagline">清晰记账，从容生活。</text>
  </view>

  <view class="login-action">
    <button class="login-btn" bindtap="handleLogin" hover-class="login-btn-hover" loading="{{loading}}">
      <text wx:if="{{!loading}}">微信一键登录</text>
      <text wx:else>登录中...</text>
    </button>

    <view class="privacy-row">
      <checkbox-group class="privacy-check-group" bindchange="onPrivacyChange">
        <checkbox value="agree" checked="{{privacyAgreed}}" color="#785655" />
      </checkbox-group>
      <view class="privacy-copy">
        <text>我已阅读并同意</text>
        <text class="privacy-link" catchtap="viewPrivacyAgreement">《隐私协议》</text>
        <text>和</text>
        <text class="privacy-link" catchtap="viewUserAgreement">《用户协议》</text>
      </view>
    </view>
  </view>
</view>
