/* ==================== 登录页 — 使用 CSS 变量，支持多主题切换 ==================== */

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 0 62rpx;
  background:
    radial-gradient(circle at 18% 16%, var(--color-primary-container, rgba(247,202,201,0.26)), transparent 28%),
    radial-gradient(circle at 84% 88%, var(--color-primary-container, rgba(247,202,201,0.16)), transparent 24%),
    linear-gradient(180deg, var(--color-bg, #fffaf8) %, var(--color-surface-low, #fffdfc) 100%);
  overflow: hidden;
  position: relative;
}

.login-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
}

.login-glow-top {
  width: 500rpx;
  height: 500rpx;
  top: -140rpx;
  left: -120rpx;
  background: var(--color-primary-container, rgba(247,202,201,0.28));
}

.login-glow-bottom {
  width: 430rpx;
  height: 430rpx;
  right: -90rpx;
  bottom: 20rpx;
  background: var(--color-primary-light, rgba(244,224,220,0.2));
}

.float-icon {
  position: absolute;
  opacity: 0.68;
  pointer-events: none;
}

.float-bag { width: 72rpx; height: 72rpx; top: 11%; left: 18%; }
.float-utensils { width: 110rpx; height: 110rpx; top: 18%; right: 14%; }
.float-plane { width: 88rpx; height: 88rpx; top: 39%; right: 8%; }
.float-car { width: 68rpx; height: 68rpx; top: 50%; left: 10%; }
.float-mug { width: 92rpx; height: 92rpx; top: 61%; left: 8%; }
.float-masks { width: 66rpx; height: 66rpx; top: 65%; right: 12%; }
.float-cart { width: 108rpx; height: 108rpx; left: 20%; bottom: 19%; }
.float-wheel { width: 84rpx; height: 84rpx; right: 15%; bottom: 10%; }

.drift-a { animation: driftA 9.8s ease-in-out infinite; }
.drift-b { animation: driftB 11.5s ease-in-out infinite; }
.drift-c { animation: driftC 10.2s ease-in-out infinite; }
.drift-d { animation: driftD 12.4s ease-in-out infinite; }

@keyframes driftA {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  30% { transform: translate3d(16rpx, -34rpx, 0) rotate(5deg); }
  65% { transform: translate3d(-12rpx, 18rpx, 0) rotate(-4deg); }
}

@keyframes driftB {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  35% { transform: translate3d(-18rpx, -28rpx, 0) rotate(-6deg); }
  70% { transform: translate3d(12rpx, 16rpx, 0) rotate(4deg); }
}

@keyframes driftC {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  40% { transform: translate3d(10rpx, -30rpx, 0) rotate(3deg); }
  78% { transform: translate3d(-16rpx, 16rpx, 0) rotate(-5deg); }
}

@keyframes driftD {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  25% { transform: translate3d(14rpx, -24rpx, 0) rotate(4deg); }
  55% { transform: translate3d(-14rpx, 14rpx, 0) rotate(-3deg); }
  85% { transform: translate3d(8rpx, -10rpx, 0) rotate(2deg); }
}

.login-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  padding-top: 294rpx;
}

.login-logo-frame {
  width: 164rpx;
  height: 164rpx;
  margin-bottom: 34rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 38rpx var(--shadow-login-logo, rgba(120,86,85,0.08));
  position: relative;
}

.login-logo {
  width: 136%;
  height: 100%;
  position: absolute;
  left: -18%;
  top: 0;
}

.login-title {
  font-size: 58rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 14rpx;
}

.login-tagline {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.login-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  padding-bottom: 188rpx;
  width: 100%;
  padding-left: 64rpx;
  padding-right: 64rpx;
  box-sizing: border-box;
}

.login-btn-wrap {
  width: 100%;
}

/* 协议勾选行：整行可点，自绘勾选框跟随主题色 */
.privacy-consent {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 6rpx 4rpx;
}

.privacy-consent__toggle {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 3rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-outline, #c9beb6);
  background: var(--color-surface, #ffffff);
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
}

.privacy-consent:active .privacy-consent__toggle {
  transform: scale(0.88);
}

.privacy-consent__toggle.is-checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 10rpx var(--shadow-dark, rgba(0, 0, 0, 0.1));
}

.privacy-consent__tick {
  width: 20rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  border-radius: 1rpx;
  opacity: 0;
  transform: rotate(-45deg) scale(0.3);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s ease;
}

.privacy-consent__toggle.is-checked .privacy-consent__tick {
  opacity: 1;
  transform: rotate(-45deg) scale(1);
}

.privacy-consent__copy {
  font-size: 22rpx;
  line-height: 42rpx;
  color: var(--color-text-tertiary, #8c7c79);
}

/* 「暂不登录，先逛逛」：保证登录页不是死胡同 —— 不登录也能进首页使用 */
.login-skip {
  margin-top: 30rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary, #8c7c79);
  text-decoration: underline;
}
.login-skip-hover { opacity: 0.65; }

.privacy-consent__link {
  color: var(--color-primary);
  font-weight: 600;
  white-space: nowrap;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, var(--color-primary-container, #f7caca) 0%, var(--color-primary-light, #f4c0c0) 100%);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 34rpx var(--shadow-btn-primary, rgba(247,202,201,0.16));
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.login-btn--privacy {
  line-height: 96rpx;
}

.login-btn-disabled {
  opacity: 0.56;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  opacity: 0.94;
  transform: scale(0.985);
}

.login-btn:active {
  transform: scale(0.97);
}
