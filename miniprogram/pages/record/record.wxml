<!-- 记账页 — 橘记的核心 -->
<view class="record-page {{type === 'income' ? 'is-income' : ''}}" style="{{themeStyle}}">

  <!-- 收/支切换 -->
  <view class="type-toggle">
    <view class="type-bg">
      <view class="type-slider {{type === 'income' ? 'right' : ''}}"></view>
      <view class="type-option {{type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="switchType">支出</view>
      <view class="type-option {{type === 'income' ? 'active' : ''}}" data-type="income" bindtap="switchType">收入</view>
    </view>
  </view>

  <!-- 金额输入区 -->
  <view class="amount-area">
    <view class="amount-chip">{{type === 'expense' ? '本次支出' : '本次收入'}}</view>
    <view class="amount-row">
      <view class="amount-field">
        <text class="amount-symbol">¥</text>
        <input class="amount-input" value="{{amount}}" placeholder="0.00" placeholder-class="amount-placeholder" type="digit" focus="{{true}}" bindinput="onAmountInput" cursor-spacing="24" />
      </view>
    </view>
    <picker mode="date" value="{{dateStr}}" start="2020-01-01" fields="day" bindchange="onDateChange">
      <view class="date-tag" hover-class="date-tag--hover">
        <text>{{displayDate}}</text>
        <text class="date-tag__dot">·</text>
        <text class="date-tag__hint">点击修改</text>
      </view>
    </picker>
  </view>

  <!-- 分类选择 -->
  <view class="category-section">
    <view class="section-label">分类</view>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="name" class="category-item {{selectedCategory === item.name ? 'selected' : ''}}" data-name="{{item.name}}" bindtap="selectCategory">
        <view class="category-card">
          <view class="category-icon">
            <image wx:if="{{item.iconPath}}" class="category-image {{selectedCategory === item.name ? 'is-selected' : ''}}" src="{{item.iconPath}}" mode="aspectFit" />
            <text wx:else class="category-emoji">{{item.icon}}</text>
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
      <view class="category-item add-category" bindtap="openAddDialog">
        <view class="category-card">
          <view class="category-icon add-icon">+</view>
          <text class="category-name">自创</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注（可选） -->
  <view class="note-section">
    <view class="note-card {{showNoteInput ? 'expanded' : ''}}">
      <view class="note-card-head">
        <text class="note-label">备注</text>
      </view>
      <input class="note-input" value="{{note}}" placeholder="添加备注…" placeholder-class="note-placeholder" bindinput="onNoteInput" bindfocus="onNoteFocus" bindblur="onNoteBlur" maxlength="200" />
      <view class="note-tools">
        <view class="note-photo-trigger {{photoUrl ? 'has-photo' : ''}}" bindtap="choosePhoto" hover-class="note-photo-trigger--hover">
          <image class="note-photo-icon" src="/images/record/camera.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="photo-inline" wx:if="{{photoUrl}}">
      <image class="photo-inline-preview" src="{{photoUrl}}" mode="aspectFill" bindtap="previewPhoto" />
      <view class="photo-inline-copy">
        <text class="photo-inline-title">已添加照片</text>
        <text class="photo-inline-subtitle">点击预览，或重新选择一张更合适的图片</text>
      </view>
      <view class="photo-inline-remove" bindtap="removePhoto">移除</view>
    </view>
  </view>

  <!-- 心情（可选） -->
  <view class="mood-section">
    <text class="mood-label">心情（可选）</text>
    <view class="mood-row">
      <view wx:for="{{presetMoods}}" wx:key="*this" class="mood-chip {{mood === item ? 'is-active' : ''}}" data-emoji="{{item}}" bindtap="selectMood">{{item}}</view>
      <view class="mood-chip mood-custom {{isCustomMood ? 'is-active' : ''}}" bindtap="pickCustomMood">
        <text wx:if="{{!isCustomMood}}">+</text>
        <text wx:else>{{mood}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮区 -->
  <view class="record-actions">
    <view class="record-actions-inner">
      <block wx:if="{{editMode}}">
        <button class="cancel-btn" bindtap="cancelEdit">取消</button>
      </block>
      <button class="save-btn {{editMode ? 'edit-save' : ''}}" bindtap="saveRecord">{{editMode ? '保存修改' : '保存'}}</button>
    </view>
  </view>

  <!-- 自创分类弹窗 -->
  <view wx:if="{{showAddDialog}}" class="add-dialog-mask" bindtap="closeAddDialog"></view>
  <view wx:if="{{showAddDialog}}" class="add-dialog">
    <text class="add-dialog-title">新建自创分类</text>
    <view class="add-dialog-field">
      <text class="add-dialog-label">分类名称</text>
      <input class="add-dialog-input" value="{{addCategoryName}}" placeholder="如：奶茶、约会…" bindinput="onAddName" maxlength="10" />
      <text wx:if="{{addCategoryError}}" class="add-dialog-error">{{addCategoryError}}</text>
    </view>
    <view class="add-dialog-field">
      <text class="add-dialog-label">分类图标</text>
      <view class="add-dialog-icon-row" bindtap="pickAddEmoji">
        <text class="add-dialog-icon-preview">{{addCategoryEmoji || '📌'}}</text>
        <text class="add-dialog-icon-hint">点击选择 → 从输入法选取 emoji</text>
      </view>
    </view>
    <view class="add-dialog-actions">
      <button class="add-dialog-cancel" bindtap="closeAddDialog">取消</button>
      <button class="add-dialog-confirm" bindtap="saveAddCategory">创建并使用</button>
    </view>
  </view>

</view>
