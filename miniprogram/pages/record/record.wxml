<!-- 记账页 — 橘记的核心 -->
<view class="record-page">

  <!-- 收/支切换 -->
  <view class="type-toggle">
    <view class="type-bg">
      <view class="type-slider {{type === 'income' ? 'right' : ''}}"></view>
      <view class="type-option {{type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="switchType">支出</view>
      <view class="type-option {{type === 'income' ? 'active' : ''}}" data-type="income" bindtap="switchType">收入</view>
    </view>
  </view>

  <!-- 金额输入区 -->
  <view class="amount-area">
    <view class="amount-row">
      <text class="amount-symbol">¥</text>
      <input class="amount-input" value="{{amount}}" placeholder="0.00" placeholder-class="amount-placeholder" type="digit" focus="{{true}}" bindinput="onAmountInput" />
    </view>
    <view class="date-tag" bindtap="pickDate">
      <text>📅 {{displayDate}}</text>
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="category-section">
    <view class="section-label">分类</view>
    <scroll-view class="category-scroll" scroll-x>
      <view class="category-list">
        <view wx:for="{{categories}}" wx:key="name" class="category-item {{selectedCategory === item.name ? 'selected' : ''}}" data-name="{{item.name}}" bindtap="selectCategory">
          <view class="category-icon">{{item.icon}}</view>
          <text class="category-name">{{item.name}}</text>
        </view>
        <view class="category-item add-category" bindtap="addCategory">
          <view class="category-icon add-icon">+</view>
          <text class="category-name">自创</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 备注（可选） -->
  <view class="note-section">
    <view class="note-row {{showNoteInput ? 'expanded' : ''}}">
      <text class="note-icon">✏️</text>
      <input class="note-input" value="{{note}}" placeholder="添加备注…" placeholder-class="note-placeholder" bindinput="onNoteInput" bindfocus="onNoteFocus" bindblur="onNoteBlur" maxlength="200" />
    </view>
  </view>

  <!-- 照片（可选） -->
  <view class="photo-section" wx:if="{{photoUrl}}">
    <image class="photo-preview" src="{{photoUrl}}" mode="aspectFill" bindtap="previewPhoto" />
    <view class="photo-remove" bindtap="removePhoto">✕</view>
  </view>

  <!-- 操作按钮区 -->
  <view class="record-actions">
    <view class="action-item" bindtap="choosePhoto">
      <text class="action-icon">{{photoUrl ? '🔄' : '📷'}}</text>
      <text class="action-label">{{photoUrl ? '换照片' : '加照片'}}</text>
    </view>
    <view class="action-divider"></view>
    <button class="save-btn" bindtap="saveRecord">保存</button>
  </view>

</view>
