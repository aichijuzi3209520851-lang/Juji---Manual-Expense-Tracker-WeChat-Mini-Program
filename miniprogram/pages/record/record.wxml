<!-- 记账页 — 橘记的核心 -->
<view class="record-page {{type === 'income' ? 'is-income' : ''}}" style="{{themeStyle}}">

  <!-- 金额 hero 卡（含 收/支 切换 + 金额 + 日期） -->
  <view class="amount-hero {{type === 'income' ? 'is-income' : ''}}">
    <!-- 收/支切换 -->
    <view class="type-toggle">
      <view class="type-bg">
        <view class="type-slider {{type === 'income' ? 'right' : ''}}"></view>
        <view class="type-option {{type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="switchType">支出</view>
        <view class="type-option {{type === 'income' ? 'active' : ''}}" data-type="income" bindtap="switchType">收入</view>
      </view>
    </view>

    <view class="juji-pet juji-pet--{{petAction}}" bindtap="openAiChat" aria-label="小橘AI助手">
      <view wx:if="{{petBubble}}" class="juji-pet-bubble">{{petBubble}}</view>
      <view wx:for="{{petHearts}}" wx:key="id" class="juji-pet-heart">❤</view>
      <view class="juji-pet-shadow"></view>
      <view class="juji-pet-body">
        <view class="juji-pet-leaf"></view>
        <view class="juji-pet-face">
          <view class="juji-pet-eye juji-pet-eye--left"></view>
          <view class="juji-pet-eye juji-pet-eye--right"></view>
          <view class="juji-pet-mouth"></view>
        </view>
        <view class="juji-pet-arm juji-pet-arm--left"></view>
        <view class="juji-pet-arm juji-pet-arm--right"></view>
        <view class="juji-pet-foot juji-pet-foot--left"></view>
        <view class="juji-pet-foot juji-pet-foot--right"></view>
      </view>
    </view>

    <view class="amount-chip">{{type === 'expense' ? '本次支出' : '本次收入'}}</view>
    <view class="amount-row">
      <view class="amount-field">
        <text class="amount-symbol">¥</text>
        <input class="amount-input" value="{{amount}}" placeholder="0.00" placeholder-class="amount-placeholder" type="digit" focus="{{amountAutoFocus}}" confirm-type="done" bindinput="onAmountInput" bindfocus="onAmountFocus" bindblur="onAmountBlur" bindconfirm="quickSaveRecord" bindkeyboardheightchange="onKeyboardHeightChange" cursor-spacing="24" />
      </view>
    </view>
    <picker mode="date" value="{{dateStr}}" start="2020-01-01" end="2027-12-31" fields="day" bindchange="onDateChange">
      <view class="date-tag" hover-class="date-tag--hover">
        <text>{{displayDate}}</text>
        <text class="date-tag__dot">·</text>
        <text class="date-tag__hint">点击修改</text>
      </view>
    </picker>
  </view>

  <!-- 分类选择 -->
  <view class="category-section">
    <view class="section-label">分类</view>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="name" class="category-item {{selectedCategory === item.name ? 'selected' : ''}}" data-name="{{item.name}}" data-item="{{item}}" bindtap="selectCategory" bindlongpress="handleDeleteCategory">
        <view class="category-card">
          <view class="category-icon">
            <image wx:if="{{item.iconPath}}" class="category-image {{selectedCategory === item.name ? 'is-selected' : ''}}" src="{{item.iconPath}}" mode="aspectFit" />
            <text wx:else class="category-emoji">{{item.icon}}</text>
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
      <view class="category-item add-category" bindtap="openAddDialog">
        <view class="category-card">
          <view class="category-icon add-icon">+</view>
          <text class="category-name">自创</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 附加信息 chip 行（备注 / 照片 / 心情，默认折叠） -->
  <view class="extras-row">
    <view class="extras-chip {{note ? 'is-active' : ''}}" bindtap="toggleNoteExpand" hover-class="extras-chip--hover">
      <text class="extras-chip-icon">💬</text>
      <text class="extras-chip-label">{{note ? '备注' : '加备注'}}</text>
    </view>
    <view class="extras-chip {{photoUrl ? 'is-active' : ''}}" bindtap="choosePhoto" hover-class="extras-chip--hover">
      <text class="extras-chip-icon">📷</text>
      <text class="extras-chip-label">{{photoUrl ? '已拍照' : '拍照'}}</text>
    </view>
    <view class="extras-chip {{mood ? 'is-active' : ''}}" bindtap="openMoodSheet" hover-class="extras-chip--hover">
      <text class="extras-chip-icon">{{mood || '😊'}}</text>
      <text class="extras-chip-label">{{mood ? '心情' : '心情'}}</text>
    </view>
  </view>

  <!-- 备注行内展开 -->
  <view class="note-expand {{noteExpanded ? 'is-open' : ''}}">
    <view class="note-expand-inner">
      <input class="note-input" value="{{note}}" placeholder="添加备注…" placeholder-class="note-placeholder" bindinput="onNoteInput" maxlength="200" />
      <view wx:if="{{note}}" class="note-clear" bindtap="clearNote">清除</view>
    </view>
  </view>

  <!-- 照片预览（已选时展示） -->
  <view class="photo-preview" wx:if="{{photoUrl}}">
    <image class="photo-preview-img" src="{{photoUrl}}" mode="aspectFill" bindtap="previewPhoto" />
    <view class="photo-preview-actions">
      <view class="photo-preview-action" bindtap="choosePhoto">重选</view>
      <view class="photo-preview-action danger" bindtap="removePhoto">移除</view>
    </view>
  </view>

  <!-- 心情选择底部抽屉 -->
  <bottom-sheet visible="{{showMoodSheet}}" title="记录心情（可选）" size="small" bind:close="closeMoodSheet">
    <view class="mood-grid">
      <view wx:for="{{presetMoods}}" wx:key="*this" class="mood-grid-item {{mood === item ? 'is-active' : ''}}" data-emoji="{{item}}" bindtap="selectMood">{{item}}</view>
      <view class="mood-grid-item mood-grid-custom {{isCustomMood ? 'is-active' : ''}}" bindtap="pickCustomMood">
        <text wx:if="{{!isCustomMood}}">+</text>
        <text wx:else>{{mood}}</text>
      </view>
    </view>
    <view wx:if="{{mood}}" class="mood-clear-row">
      <view class="mood-clear-btn" bindtap="clearMood">清除当前心情</view>
    </view>
  </bottom-sheet>

  <!-- 操作按钮区 -->
  <view class="record-actions">
    <view class="record-actions-inner">
      <block wx:if="{{editMode}}">
        <button class="cancel-btn" bindtap="cancelEdit">取消</button>
      </block>
      <button class="save-btn {{editMode ? 'edit-save' : ''}}" bindtap="saveRecord">{{editMode ? '保存修改' : '保存'}}</button>
    </view>
  </view>

  <view wx:if="{{amountFocused && !editMode}}" class="quick-confirm-bar" style="{{quickConfirmStyle}}">
    <view class="quick-confirm-copy">
      <text class="quick-confirm-label">{{type === 'expense' ? '快速记支出' : '快速记收入'}}</text>
      <text class="quick-confirm-meta">{{selectedCategory}} · {{displayDate}} · ¥{{amount ? amount : '0.00'}}</text>
    </view>
    <button class="quick-confirm-btn {{quickCanSave && !quickSaving ? '' : 'is-disabled'}}" loading="{{quickSaving}}" disabled="{{!quickCanSave || quickSaving}}" catchtap="quickSaveRecord">确认记账</button>
  </view>

  <!-- 小橘 AI 助手聊天弹窗 -->
  <view class="ai-chat-modal" wx:if="{{showAiChat}}" style="{{chatModalStyle}}" catchtap="closeAiChat" catchtouchmove="noop">
    <view class="ai-chat-panel {{chatKeyboardHeight > 0 ? 'is-keyboard' : ''}}" catchtap="noop">
      <view class="ai-chat-header">
        <view class="ai-chat-title">
          <image class="ai-chat-logo" src="/images/juji2.jpg" mode="aspectFill" />
          <view>
            <text class="ai-chat-name">小橘 AI 助手</text>
            <text class="ai-chat-subtitle">AI生成，仅供参考</text>
          </view>
        </view>
        <text class="ai-chat-close" bindtap="closeAiChat">×</text>
      </view>

      <scroll-view class="ai-chat-body" scroll-y="{{true}}" scroll-into-view="{{chatScrollTo}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view wx:for="{{chatMessages}}" wx:key="id" id="{{item.id}}" class="chat-row chat-row--{{item.role}}">
          <image wx:if="{{item.role === 'assistant'}}" class="chat-avatar" src="/images/juji2.jpg" mode="aspectFill" />
          <view wx:if="{{item.role === 'user' && chatUserAvatarUrl && !chatAvatarError}}" class="chat-avatar chat-avatar--user-img">
            <image class="chat-avatar-img" src="{{chatUserAvatarUrl}}" mode="aspectFill" binderror="onChatAvatarError" />
          </view>
          <view wx:if="{{item.role === 'user' && (!chatUserAvatarUrl || chatAvatarError)}}" class="chat-avatar chat-avatar--fallback">🍊</view>

          <view wx:if="{{item.type === 'billDraft'}}" class="bill-draft">
            <view class="bill-draft-title">理出这几笔，确认下吧</view>
            <view wx:for="{{item.drafts}}" wx:for-item="row" wx:key="key" class="bill-draft-row">
              <view class="bill-draft-main">
                <view class="bill-draft-cat">
                  <text class="bill-draft-cat-name">{{row.category}}</text>
                  <text wx:if="{{row.type === 'income'}}" class="bill-draft-tag bill-draft-tag--income">收入</text>
                  <text wx:if="{{row.isNewCategory}}" class="bill-draft-tag bill-draft-tag--new">新</text>
                </view>
                <view class="bill-draft-amount">
                  <text class="bill-draft-yuan">¥</text>
                  <input class="bill-draft-amount-input" type="digit" value="{{row.amountText}}" disabled="{{item.status !== 'pending'}}" data-msg="{{item.id}}" data-key="{{row.key}}" bindinput="onDraftAmountInput" />
                </view>
                <view wx:if="{{item.status === 'pending'}}" class="bill-draft-del" data-msg="{{item.id}}" data-key="{{row.key}}" bindtap="removeDraftRow">✕</view>
              </view>
              <input class="bill-draft-note" value="{{row.note}}" placeholder="备注（可选）" maxlength="30" disabled="{{item.status !== 'pending'}}" data-msg="{{item.id}}" data-key="{{row.key}}" bindinput="onDraftNoteInput" />
              <view wx:if="{{row.isNewCategory && item.status === 'pending'}}" class="bill-draft-newcat" data-msg="{{item.id}}" data-key="{{row.key}}" bindtap="toggleDraftNewCategory">
                <text class="bill-draft-check {{row.createNew ? 'is-on' : ''}}">{{row.createNew ? '✓' : ''}}</text>
                <text class="bill-draft-newcat-label">创建新分类「{{row.category}}」（不勾则归「其他」+备注原词）</text>
              </view>
            </view>
            <view wx:if="{{item.status === 'pending'}}" class="bill-draft-actions">
              <button class="bill-draft-btn bill-draft-btn--ghost" data-msg="{{item.id}}" bindtap="cancelBillDraft">取消</button>
              <button class="bill-draft-btn bill-draft-btn--primary" data-msg="{{item.id}}" bindtap="confirmBillDraft">确认记账</button>
            </view>
            <view wx:if="{{item.status === 'saving'}}" class="bill-draft-status">记账中...</view>
            <view wx:if="{{item.status === 'done'}}" class="bill-draft-status bill-draft-status--done">✓ 已记账</view>
          </view>

          <view wx:else class="chat-bubble chat-bubble--{{item.role}}">{{item.content}}</view>
        </view>
        <view wx:if="{{showChatSuggestions}}" class="chat-suggestions">
          <text class="chat-suggestions-title">可以这样问小橘</text>
          <view class="chat-suggestion-list">
            <view wx:for="{{chatSuggestions}}" wx:for-item="suggestion" wx:key="*this" class="chat-suggestion-chip" data-text="{{suggestion}}" bindtap="sendChatSuggestion">{{suggestion}}</view>
          </view>
        </view>
        <view wx:if="{{chatLoading}}" id="chat_loading" class="chat-row chat-row--assistant">
          <image class="chat-avatar" src="/images/juji2.jpg" mode="aspectFill" />
          <view class="chat-bubble chat-bubble--assistant chat-bubble--typing">小橘正在想...</view>
        </view>
      </scroll-view>

      <view class="ai-chat-footer">
        <text class="ai-chat-notice">AI生成，仅供参考，请勿输入敏感个人信息。</text>
        <view class="ai-chat-input-row">
          <textarea class="ai-chat-input" value="{{chatInput}}" bindinput="onChatInput" bindblur="onChatInputBlur" bindconfirm="sendChatMessage" bindkeyboardheightchange="onChatKeyboardHeightChange" auto-height="{{true}}" show-confirm-bar="{{false}}" confirm-type="send" adjust-position="{{false}}" cursor-spacing="12" placeholder="和小橘聊聊..." maxlength="300"></textarea>
          <button class="ai-chat-send {{chatLoading || !chatInput ? 'is-disabled' : ''}}" bindtap="sendChatMessage">发送</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 自创分类弹窗 -->
  <view wx:if="{{showAddDialog}}" class="add-dialog-mask" bindtap="closeAddDialog"></view>
  <view wx:if="{{showAddDialog}}" class="add-dialog">
    <text class="add-dialog-title">新建自创分类</text>
    <view class="add-dialog-field">
      <text class="add-dialog-label">分类名称</text>
      <input class="add-dialog-input" value="{{addCategoryName}}" placeholder="如：奶茶、约会…" bindinput="onAddName" maxlength="10" />
      <text wx:if="{{addCategoryError}}" class="add-dialog-error">{{addCategoryError}}</text>
    </view>
    <view class="add-dialog-field">
      <text class="add-dialog-label">分类图标</text>
      <input class="add-dialog-input" value="{{addCategoryEmoji}}" placeholder="粘贴或输入一个 emoji 表情" placeholder-class="add-dialog-placeholder" bindinput="onAddEmoji" maxlength="2" />
    </view>
    <view class="add-dialog-actions">
      <button class="add-dialog-cancel" bindtap="closeAddDialog">取消</button>
      <button class="add-dialog-confirm" bindtap="saveAddCategory">创建并使用</button>
    </view>
  </view>

  <!-- 隐私授权弹窗 -->
  <view wx:if="{{showPrivacyAuth}}" class="privacy-auth-mask" bindtap="hidePrivacyAuthorizeButton">
    <view class="privacy-auth-modal" catchtap="noop">
      <view class="privacy-auth-icon">🔐</view>
      <text class="privacy-auth-title">隐私授权</text>
      <text class="privacy-auth-desc">使用{{privacyAuthFeature || '本功能'}}需要先同意隐私保护指引，请阅读后点击同意。</text>
      <button
        id="{{privacyAuthButtonId}}"
        class="privacy-auth-btn"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onPrivacyAuthorize"
      >同意并继续</button>
      <button class="privacy-auth-btn privacy-auth-btn--cancel" bindtap="hidePrivacyAuthorizeButton">取消</button>
    </view>
  </view>

</view>
