.record-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-md);
}

/* ======= 金额 hero 卡 ======= */
.amount-hero {
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  padding: 28rpx 32rpx 36rpx;
  margin-top: 24rpx;
  position: relative;
  overflow: hidden;
}
.amount-hero::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx;
  background: rgba(255,255,255,0.10);
  border-radius: 50%;
  pointer-events: none;
}
.amount-hero::after {
  content: '';
  position: absolute;
  bottom: -100rpx; left: -60rpx;
  width: 220rpx; height: 220rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
  pointer-events: none;
}

/* 类型切换 — hero 内毛玻璃药丸 */
.type-toggle { display: flex; justify-content: center; padding-bottom: 24rpx; position: relative; z-index: 1; }
.type-bg {
  display: flex;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-full);
  padding: 6rpx;
  position: relative;
  backdrop-filter: blur(8rpx);
}
.type-slider {
  position: absolute;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  top: 6rpx;
  left: 6rpx;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  box-shadow: 0 6rpx 14rpx var(--shadow-dark);
  transition: transform 0.25s ease;
}
.type-slider.right { transform: translateX(100%); }
.type-option {
  width: 160rpx;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: var(--color-on-primary);
  opacity: 0.7;
  z-index: 1;
  transition: color 0.25s, opacity 0.25s;
  position: relative;
  font-weight: 600;
}
.type-option.active {
  color: var(--color-primary);
  opacity: 1;
  font-weight: 700;
}

/* 金额 */
.amount-chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.20);
  color: var(--color-on-primary);
  opacity: 0.85;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.amount-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 140rpx;
  padding: 8rpx 0 0;
  position: relative;
  z-index: 1;
}
.amount-field {
  display: flex;
  align-items: center;
  justify-content: center;
}
.amount-symbol {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-on-primary);
  opacity: 0.8;
  line-height: 1;
  margin-right: 12rpx;
  flex-shrink: 0;
  transform: translateY(2rpx);
}
.amount-input {
  flex: 0 1 auto;
  min-width: 200rpx;
  height: 124rpx;
  line-height: 124rpx;
  font-size: 96rpx;
  font-weight: 800;
  color: var(--color-on-primary);
  text-align: left;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}
.amount-placeholder {
  color: var(--color-on-primary);
  opacity: 0.4;
}

/* 日期药丸 */
.date-tag {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-full);
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: var(--color-on-primary);
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  backdrop-filter: blur(8rpx);
  transition: opacity 0.15s ease, transform 0.15s ease;
  position: relative;
  z-index: 1;
}
.date-tag--hover { opacity: 0.7; transform: scale(0.97); }
.date-tag__dot { opacity: 0.5; }
.date-tag__hint { opacity: 0.7; }

picker { display: flex; justify-content: center; }

/* ======= 分类区 ======= */
.category-section { padding: 32rpx 0 24rpx; }
.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  display: block;
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 14rpx;
}
.category-item {
  display: flex;
  width: 164rpx;
  flex: 0 0 164rpx;
}
.category-card {
  width: 100%;
  min-height: 156rpx;
  border-radius: var(--radius-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 18rpx 8rpx 16rpx;
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
}
.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--color-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  transition: background 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
}
.category-image {
  width: 52rpx;
  height: 52rpx;
  filter: brightness(0) opacity(0.5);
  transition: filter 0.22s ease;
}
.category-emoji { font-size: 44rpx; line-height: 1; }
.category-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* 选中态 — 容器染主色，图标变白 */
.category-item.selected .category-card {
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  transform: translateY(-3rpx);
}
.category-item.selected .category-icon {
  background: var(--gradient-hero);
  box-shadow: 0 12rpx 24rpx var(--shadow-dark);
  transform: translateY(-2rpx);
}
.category-item.selected .category-image {
  filter: brightness(0) invert(1) opacity(0.95);
}
.category-item.selected .category-name {
  color: var(--color-primary);
  font-weight: 700;
}

/* + 新建卡 */
.add-category .category-card {
  background: transparent;
  border: 2rpx dashed var(--color-border);
  box-shadow: none;
}
.add-category .category-icon {
  background: var(--color-primary-container);
  box-shadow: none;
}
.add-icon {
  font-size: 44rpx;
  color: var(--color-primary);
  font-weight: 300;
}

/* ======= 备注 ======= */
.note-section { padding: 0 0 32rpx; }
.note-card {
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-card);
  padding: 28rpx 28rpx 24rpx;
}
.note-card-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.note-label {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.note-tools {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-start;
}
.note-photo-trigger {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: var(--color-primary-container);
  display: inline-flex; align-items: center; justify-content: center;
  position: relative;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.note-photo-trigger--hover { opacity: 0.7; transform: scale(0.95); }
.note-photo-trigger.has-photo::after {
  content: ''; position: absolute; top: 8rpx; right: 8rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--color-income);
  border: 2rpx solid var(--color-surface);
}
.note-photo-icon {
  width: 32rpx; height: 32rpx;
  filter: brightness(0) opacity(0.55);
}
.note-input {
  width: 100%;
  min-height: 54rpx;
  font-size: 30rpx;
  color: var(--color-text);
}
.note-placeholder { color: var(--color-text-tertiary); opacity: 0.6; }
.photo-inline {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.photo-inline-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}
.photo-inline-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.photo-inline-title { font-size: 26rpx; color: var(--color-text); font-weight: 600; }
.photo-inline-subtitle { font-size: 22rpx; color: var(--color-text-tertiary); line-height: 1.55; }
.photo-inline-remove {
  font-size: 24rpx;
  color: var(--color-error);
  font-weight: 600;
  padding: 14rpx 0 14rpx 16rpx;
}

/* ======= 心情 ======= */
.mood-section { padding: 0 0 24rpx; }
.mood-label {
  font-size: 24rpx; color: var(--color-primary); font-weight: 700;
  letter-spacing: 2rpx;
  display: block; margin-bottom: 16rpx; padding-left: 8rpx;
}
.mood-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.mood-chip {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: var(--color-surface); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}
.mood-chip.is-active {
  background: var(--gradient-hero);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx var(--shadow-dark);
  transform: scale(1.1);
}
.mood-custom {
  font-size: 30rpx; color: var(--color-text-tertiary);
}
.mood-custom.is-active { font-size: 36rpx; color: var(--color-on-primary); }

/* ======= 保存按钮 ======= */
.record-actions {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 230rpx;
  padding-bottom: calc(230rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
  margin-top: auto;
}
.record-actions-inner {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}
.save-btn {
  flex: 1;
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-full);
  padding: 26rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-elevated);
  letter-spacing: 2rpx;
}
.save-btn::after { border: none; }
.cancel-btn {
  width: 160rpx;
  background: transparent;
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--color-border);
}
.cancel-btn::after { border: none; }

/* ======= 自创分类弹窗 ======= */
.add-dialog-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(30, 27, 26, 0.4);
}
.add-dialog {
  position: fixed; left: 48rpx; right: 48rpx; top: 50%; z-index: 101;
  transform: translateY(-50%);
  background: var(--color-surface); border-radius: var(--radius-2xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-elevated);
}
.add-dialog-title {
  font-size: 34rpx; font-weight: 700; color: var(--color-text);
  display: block; margin-bottom: 28rpx;
}
.add-dialog-field { margin-bottom: 22rpx; }
.add-dialog-label {
  font-size: 24rpx; color: var(--color-text-secondary); font-weight: 500;
  display: block; margin-bottom: 10rpx;
}
.add-dialog-input {
  font-size: 30rpx; color: var(--color-text);
  border-bottom: 2rpx solid var(--color-border); padding: 8rpx 0;
}
.add-dialog-error {
  font-size: 22rpx; color: var(--color-error); margin-top: 6rpx; display: block;
}
.add-dialog-icon-row {
  display: flex; align-items: center; gap: 16rpx;
  background: var(--color-primary-container); border-radius: var(--radius-lg);
  padding: 16rpx 20rpx;
}
.add-dialog-icon-preview {
  font-size: 44rpx; line-height: 1; flex-shrink: 0;
}
.add-dialog-icon-hint {
  font-size: 24rpx; color: var(--color-primary); line-height: 1.4; opacity: 0.85;
}
.add-dialog-actions {
  display: flex; gap: 16rpx; margin-top: 28rpx;
}
.add-dialog-cancel {
  flex: 1; background: var(--color-surface-low); color: var(--color-text-secondary);
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 500; border: none;
  padding: 22rpx 0;
}
.add-dialog-cancel::after { border: none; }
.add-dialog-confirm {
  flex: 1; background: var(--color-primary); color: var(--color-on-primary);
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 600; border: none;
  padding: 22rpx 0;
}
.add-dialog-confirm::after { border: none; }
