.record-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 16%, var(--color-primary-container), transparent 24%),
    radial-gradient(circle at 86% 18%, var(--color-primary-light), transparent 20%),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-md);
}

.record-page.is-income {
  background:
    radial-gradient(circle at 12% 16%, var(--color-tertiary-container), transparent 24%),
    radial-gradient(circle at 86% 18%, var(--color-tertiary-container), transparent 20%),
    var(--color-bg);
}
/* 类型切换 */
.type-toggle { padding: 40rpx 0; display: flex; justify-content: center; }
.type-bg {
  display: flex;
  background: rgba(255, 255, 255, 0.78);
  border-radius: var(--radius-full);
  padding: 6rpx;
  position: relative;
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  box-shadow: 0 16rpx 30rpx rgba(120, 86, 85, 0.05);
}
.type-slider {
  position: absolute;
  width: 50%;
  height: calc(100% - 12rpx);
  top: 6rpx;
  left: 6rpx;
  background: linear-gradient(180deg, #f6c9c8 0%, #eeb8b7 100%);
  border-radius: var(--radius-full);
  box-shadow: 0 12rpx 22rpx rgba(120, 86, 85, 0.14);
  transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}
.record-page.is-income .type-slider {
  background: linear-gradient(180deg, #d2ead9 0%, #bddbc8 100%);
  box-shadow: 0 12rpx 22rpx rgba(75, 100, 88, 0.14);
}
.type-slider.right { transform: translateX(100%); }
.type-option {
  width: 160rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: var(--color-text-secondary);
  z-index: 1;
  transition: color 0.25s;
  position: relative;
}
.type-option.active { color: white; font-weight: 600; }
/* 金额 */
.amount-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 54rpx;
}
.amount-chip {
  padding: 10rpx 22rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(120, 86, 85, 0.07);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 34rpx;
}
.record-page.is-income .amount-chip {
  color: var(--color-income);
  border-color: rgba(75, 100, 88, 0.08);
}
.amount-row {
  display: flex;
  justify-content: center;
  width: 100%;
  min-height: 160rpx;
  padding: 0 0 12rpx 34rpx;
}
.amount-field {
  width: 540rpx;
  min-height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.amount-symbol {
  font-size: 54rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
  text-align: center;
  width: 48rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  transform: translateY(4rpx);
}
.record-page.is-income .amount-symbol {
  color: var(--color-income);
}
.amount-input {
  flex: 0 1 auto;
  width: 320rpx;
  min-width: 320rpx;
  height: 136rpx;
  line-height: 136rpx;
  font-size: 104rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: left;
  font-variant-numeric: tabular-nums;
}
.amount-placeholder { color: #ddd4d2; }
.date-tag {
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-full);
  padding: 14rpx 30rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.date-tag--hover { opacity: 0.7; transform: scale(0.97); }
.date-tag__dot {
  opacity: 0.4;
}
.date-tag__hint {
  color: var(--color-text-tertiary);
}
/* 分类 */
.category-section { padding: 8rpx 0 36rpx; }
.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 14rpx;
}
.category-item {
  display: flex;
  width: 164rpx;
  flex: 0 0 164rpx;
}
.category-card {
  width: 100%;
  min-height: 148rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  box-shadow: 0 12rpx 30rpx rgba(120, 86, 85, 0.045);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 8rpx 16rpx;
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
}
.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fbf2f0 0%, #f4e5e2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  transition: transform 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
}
.record-page.is-income .category-icon {
  background: linear-gradient(180deg, #f2f8f4 0%, #e1efe6 100%);
}
.category-item.selected .category-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(250, 240, 238, 0.92));
  border-color: rgba(120, 86, 85, 0.12);
  box-shadow: 0 18rpx 34rpx rgba(120, 86, 85, 0.08);
  transform: translateY(-3rpx);
}
.record-page.is-income .category-item.selected .category-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(241, 248, 243, 0.94));
  border-color: rgba(75, 100, 88, 0.12);
  box-shadow: 0 18rpx 34rpx rgba(75, 100, 88, 0.08);
}
.category-item.selected .category-icon {
  background: linear-gradient(180deg, #f6c9c8 0%, #efb8b7 100%);
  box-shadow: 0 12rpx 24rpx rgba(120, 86, 85, 0.12);
  transform: translateY(-2rpx);
}
.record-page.is-income .category-item.selected .category-icon {
  background: linear-gradient(180deg, #d2ead9 0%, #bddbc8 100%);
  box-shadow: 0 12rpx 24rpx rgba(75, 100, 88, 0.12);
}
.category-image { width: 50rpx; height: 50rpx; }
.category-image.is-selected { filter: brightness(0) invert(1) opacity(0.95); }
.category-emoji { font-size: 40rpx; line-height: 1; }
.category-name {
  font-size: 23rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}
.category-item.selected .category-name { color: var(--color-primary); }
.record-page.is-income .category-item.selected .category-name { color: var(--color-income); }
.add-category .category-card {
  background: rgba(255, 255, 255, 0.62);
  border-style: dashed;
}
.add-icon {
  font-size: 42rpx;
  color: var(--color-text-tertiary);
}
/* 备注 */
.note-section { padding: 0 0 32rpx; }
.note-card {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 28rpx;
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  box-shadow: 0 14rpx 34rpx rgba(120,86,85,0.05);
  padding: 24rpx 28rpx 24rpx;
}
.note-card-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.note-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}
.note-tools {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-start;
}
.note-photo-trigger {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(180deg, #fff8f6 0%, #f8ece9 100%);
  border: 1rpx solid rgba(120, 86, 85, 0.06);
  display: inline-flex; align-items: center; justify-content: center;
  position: relative;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.note-photo-trigger--hover { opacity: 0.7; transform: scale(0.95); }
.note-photo-trigger.has-photo::after {
  content: ''; position: absolute; top: 8rpx; right: 8rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--color-income);
  border: 2rpx solid white;
}
.record-page.is-income .note-photo-trigger {
  background: linear-gradient(180deg, #f5faf6 0%, #eaf3ed 100%);
  border-color: rgba(75, 100, 88, 0.08);
}
.note-photo-icon { width: 30rpx; height: 30rpx; }
.note-input {
  width: 100%;
  min-height: 54rpx;
  font-size: 30rpx;
  color: var(--color-text);
}
.note-placeholder { color: #d1d1cc; }
.photo-inline {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.82);
  box-shadow: 0 8rpx 22rpx rgba(120,86,85,0.04);
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.photo-inline-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}
.photo-inline-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.photo-inline-title { font-size: 26rpx; color: var(--color-text); font-weight: 600; }
.photo-inline-subtitle { font-size: 22rpx; color: var(--color-text-tertiary); line-height: 1.55; }
.photo-inline-remove {
  font-size: 24rpx;
  color: var(--color-error);
  font-weight: 600;
  padding: 14rpx 0 14rpx 16rpx;
}
/* 心情选择 */
.mood-section { padding: 0 0 24rpx; }
.mood-label {
  font-size: 24rpx; color: var(--color-text-secondary); font-weight: 600;
  display: block; margin-bottom: 16rpx;
}
.mood-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.mood-chip {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255,255,255,0.78); border: 1rpx solid rgba(120,86,85,0.08);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}
.mood-chip.is-active {
  background: var(--color-primary-container);
  box-shadow: 0 8rpx 18rpx rgba(120,86,85,0.1);
  transform: scale(1.1);
}
.mood-custom {
  font-size: 28rpx; color: var(--color-text-tertiary);
}
.mood-custom.is-active { font-size: 34rpx; }
/* 保存按钮 */
.record-actions {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 230rpx;
  padding-bottom: calc(230rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
  margin-top: auto;
}
.record-actions-inner {
  width: 100%;
  display: flex;
  justify-content: center;
}
.save-btn {
  width: 84%;
  background: linear-gradient(180deg, #f6c9c8 0%, #efb9b8 100%);
  color: white;
  border-radius: var(--radius-full);
  padding: 24rpx 0;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(120, 86, 85, 0.15);
}
.record-page.is-income .save-btn {
  background: linear-gradient(180deg, #d2ead9 0%, #bddbc8 100%);
  box-shadow: 0 14rpx 28rpx rgba(75, 100, 88, 0.16);
}
.save-btn::after { border: none; }

/* 自创分类弹窗 */
.add-dialog-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(30, 27, 26, 0.4);
}
.add-dialog {
  position: fixed; left: 48rpx; right: 48rpx; top: 50%; z-index: 101;
  transform: translateY(-50%);
  background: var(--color-surface); border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: 0 20rpx 60rpx rgba(120, 86, 85, 0.14);
}
.add-dialog-title {
  font-size: 34rpx; font-weight: 700; color: var(--color-text);
  display: block; margin-bottom: 28rpx;
}
.add-dialog-field { margin-bottom: 22rpx; }
.add-dialog-label {
  font-size: 24rpx; color: var(--color-text-secondary); font-weight: 500;
  display: block; margin-bottom: 10rpx;
}
.add-dialog-input {
  font-size: 30rpx; color: var(--color-text);
  border-bottom: 2rpx solid var(--color-surface-high); padding: 8rpx 0;
}
.add-dialog-error {
  font-size: 22rpx; color: var(--color-error); margin-top: 6rpx; display: block;
}
.add-dialog-emoji-grid {
  display: flex; flex-wrap: wrap; gap: 10rpx;
  max-height: 240rpx; overflow-y: auto;
}
.add-dialog-emoji {
  width: 68rpx; height: 68rpx; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-md);
  background: var(--color-surface-low);
  transition: background 0.15s ease, transform 0.15s ease;
}
.add-dialog-emoji.is-selected {
  background: var(--color-primary-container);
  transform: scale(1.14);
}
.add-dialog-actions {
  display: flex; gap: 16rpx; margin-top: 28rpx;
}
.add-dialog-cancel {
  flex: 1; background: var(--color-surface-low); color: var(--color-text-secondary);
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 500; border: none;
  padding: 20rpx 0;
}
.add-dialog-cancel::after { border: none; }
.add-dialog-confirm {
  flex: 1; background: var(--color-primary); color: white;
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 600; border: none;
  padding: 20rpx 0;
}
.add-dialog-confirm::after { border: none; }
