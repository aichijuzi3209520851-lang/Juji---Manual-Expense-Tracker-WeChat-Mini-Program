.record-page {
  min-height: 100vh; background: linear-gradient(180deg, #fffaf8 0%, #fffdfc 100%);
  display: flex; flex-direction: column; padding: 0 var(--space-md);
}
/* 类型切换 */
.type-toggle { padding: 40rpx 0; display: flex; justify-content: center; }
.type-bg {
  display: flex; background: var(--color-surface-high); border-radius: var(--radius-full);
  padding: 6rpx; position: relative;
}
.type-slider {
  position: absolute; width: 50%; height: calc(100% - 12rpx); top: 6rpx; left: 6rpx;
  background: var(--color-primary); border-radius: var(--radius-full); transition: transform 0.25s ease;
}
.type-slider.right { transform: translateX(100%); }
.type-option {
  width: 160rpx; text-align: center; padding: 20rpx 0; font-size: 32rpx;
  color: var(--color-text-secondary); z-index: 1; transition: color 0.25s; position: relative;
}
.type-option.active { color: white; font-weight: 600; }
/* 金额 */
.amount-area { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0 48rpx; }
.amount-row { display: flex; align-items: center; border-bottom: 4rpx solid transparent; padding-bottom: 8rpx; }
.amount-symbol { font-size: 52rpx; font-weight: 700; color: var(--color-primary); margin-right: 8rpx; }
.amount-input { width: 360rpx; font-size: 96rpx; font-weight: 700; color: var(--color-text); text-align: center; }
.amount-placeholder { color: #e0d8d7; }
.date-tag { margin-top: 32rpx; background: var(--color-surface-low); border-radius: var(--radius-full); padding: 12rpx 28rpx; font-size: 26rpx; color: var(--color-text-secondary); }
/* 分类 */
.category-section { padding: 16rpx 0 32rpx; }
.section-label { font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 24rpx; }
.category-scroll { white-space: nowrap; }
.category-list { display: inline-flex; gap: 8rpx; }
.category-item {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 16rpx 8rpx; min-width: 120rpx;
}
.category-icon {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--color-surface-highest);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.category-item.selected .category-icon { background: var(--color-primary); }
.category-name { font-size: 24rpx; color: var(--color-text-secondary); }
.category-item.selected .category-name { color: var(--color-primary); font-weight: 600; }
.add-icon { font-size: 44rpx; color: var(--color-text-tertiary); }
/* 备注 */
.note-section { padding: 0 0 32rpx; }
.note-row {
  background: var(--color-surface); border-radius: var(--radius-lg);
  box-shadow: 0 2rpx 8rpx rgba(120,86,85,0.03); padding: 24rpx 32rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.note-icon { font-size: 32rpx; }
.note-input { flex: 1; font-size: 30rpx; color: var(--color-text); }
.note-placeholder { color: #d1d1cc; }
/* 照片 */
.photo-section { position: relative; width: 160rpx; height: 160rpx; margin-bottom: 24rpx; }
.photo-preview { width: 100%; height: 100%; border-radius: var(--radius-md); }
.photo-remove {
  position: absolute; top: -12rpx; right: -12rpx; width: 44rpx; height: 44rpx;
  background: var(--color-error); color: white; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx;
}
/* 保存按钮 */
.record-actions { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0 60rpx; margin-top: auto; }
.action-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.action-icon { font-size: 44rpx; }
.action-label { font-size: 22rpx; color: var(--color-text-tertiary); }
.action-divider { width: 1rpx; height: 48rpx; background: var(--color-border); }
.save-btn {
  flex: 1; background: var(--color-primary); color: white; border-radius: var(--radius-full);
  padding: 24rpx 0; font-size: 34rpx; font-weight: 600; text-align: center; border: none;
}
.save-btn::after { border: none; }
