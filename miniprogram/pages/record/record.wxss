.record-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-md);
}

/* ======= 金额 hero 卡 ======= */
.amount-hero {
  background: var(--gradient-hero);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-hero);
  padding: 28rpx 32rpx 36rpx;
  margin-top: 24rpx;
  position: relative;
  overflow: hidden;
}
.amount-hero::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx;
  background: rgba(255,255,255,0.10);
  border-radius: 50%;
  pointer-events: none;
}
.amount-hero::after {
  content: '';
  position: absolute;
  bottom: -100rpx; left: -60rpx;
  width: 220rpx; height: 220rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
  pointer-events: none;
}

/* 小橘 AI 助手 (Q版萌化形象) */
.juji-pet {
  position: absolute;
  right: 16rpx;
  top: 104rpx;
  width: 150rpx;
  height: 150rpx;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transform-origin: center bottom;
  animation: juji-pet-idle 3.2s ease-in-out infinite;
}
.juji-pet:active {
  transform: scale(0.92) rotate(-3deg);
}
.juji-pet-img {
  position: relative;
  z-index: 2;
  width: 150rpx;
  height: 150rpx;
  transform-origin: 50% 88%;
}
.juji-pet-shadow {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 86rpx;
  height: 16rpx;
  background: rgba(59, 32, 11, 0.15);
  border-radius: 50%;
  filter: blur(3rpx);
  animation: juji-pet-shadow 3.2s ease-in-out infinite;
}
/* 气泡：右对齐并浮在小橘头顶上方
   注意 ① 单行不换行 —— 父级 .amount-hero 是 overflow:hidden，小橘上方仅 104rpx 可用，
        换行会被裁掉；语录长度上限见 utils/petPhrases.js 的 MAX_PHRASE_LEN
   注意 ② 右对齐 —— 原先 left:-28rpx 会让长句向右顶出屏幕 */
.juji-pet-bubble {
  position: absolute;
  top: auto;
  right: 6rpx;
  bottom: 140rpx;
  background: #ffffff;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 3.5rpx solid #3b200b;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  white-space: nowrap;
  animation: juji-pet-bubble 1.1s ease both;
  z-index: 4;
}
.juji-pet-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  right: 34rpx;
  left: auto;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #ffffff;
}
/* 粒子（❤／💤／💫／✨）—— 位置、字号、延迟、时长由 utils/petActions.js 的
   PARTICLE_SPECS 内联下发，这里只定义统一的上升淡出轨迹 */
.juji-pet-particle {
  position: absolute;
  z-index: 4;
  opacity: 0;
  pointer-events: none;
  animation: juji-particle-fly 1.4s ease-out forwards;
}

/* 动效增强 —— 动作清单与权重见 utils/petActions.js，新增动作需两页同步 */
.juji-pet--wave .juji-pet-img {
  animation: juji-pet-wave 0.35s ease-in-out 4;
}
.juji-pet--jump {
  animation: juji-pet-jump 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.juji-pet--heart .juji-pet-img {
  animation: juji-pet-pop 0.55s ease both;
}
.juji-pet--jelly .juji-pet-img {
  animation: juji-pet-jelly 0.9s ease-in-out both;
}
.juji-pet--shake .juji-pet-img {
  animation: juji-pet-shake 0.25s ease-in-out 4;
}
.juji-pet--dance .juji-pet-img {
  animation: juji-pet-dance 0.42s ease-in-out 4;
}
.juji-pet--sleep .juji-pet-img {
  animation: juji-pet-sleep 1.9s ease-in-out both;
}
.juji-pet--dizzy .juji-pet-img {
  animation: juji-pet-dizzy 0.3s ease-in-out 4;
}
.juji-pet--sparkle .juji-pet-img {
  animation: juji-pet-sparkle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes juji-pet-idle {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  50% { transform: translateY(-8rpx) scale(1.03, 0.97); }
}
@keyframes juji-pet-shadow {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.15; }
  50% { transform: translateX(-50%) scale(0.88); opacity: 0.08; }
}
@keyframes juji-pet-wave {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-9deg); }
  75% { transform: rotate(7deg); }
}
@keyframes juji-pet-jump {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-24rpx) scale(0.96, 1.05); }
  70% { transform: translateY(0) scale(1.05, 0.95); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes juji-pet-pop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
/* 果冻弹：先横向撑开压扁，再回弹，模拟软体 */
@keyframes juji-pet-jelly {
  0% { transform: scale(1, 1); }
  25% { transform: scale(1.16, 0.84); }
  45% { transform: scale(0.92, 1.1); }
  65% { transform: scale(1.06, 0.95); }
  85% { transform: scale(0.98, 1.02); }
  100% { transform: scale(1, 1); }
}
/* 抖一抖：小幅快摆，像甩水 */
@keyframes juji-pet-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg); }
  75% { transform: rotate(6deg); }
}
/* 摇摆舞：摆幅更大并带轻微离地 */
@keyframes juji-pet-dance {
  0%, 100% { transform: rotate(0deg) translateY(0); }
  25% { transform: rotate(-10deg) translateY(-4rpx); }
  75% { transform: rotate(10deg) translateY(-4rpx); }
}
/* 打盹：呼吸放慢 + 慢慢歪头 */
@keyframes juji-pet-sleep {
  0%, 100% { transform: rotate(0deg) scale(1, 1); }
  35% { transform: rotate(-5deg) scale(1.02, 0.96); }
  70% { transform: rotate(3deg) scale(1.02, 0.96); }
}
/* 转晕：大角度左右晃 */
@keyframes juji-pet-dizzy {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-14deg); }
  75% { transform: rotate(14deg); }
}
/* 撒花：开心上弹 + 落地压一下 */
@keyframes juji-pet-sparkle {
  0% { transform: translateY(0) scale(0.9); }
  40% { transform: translateY(-22rpx) scale(1.1); }
  70% { transform: translateY(0) scale(0.97, 1.04); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes juji-particle-fly {
  0% { transform: translateY(18rpx) scale(0.6); opacity: 0; }
  25% { opacity: 1; }
  100% { transform: translateY(-56rpx) scale(1.3); opacity: 0; }
}
@keyframes juji-pet-bubble {
  from { transform: translateY(8rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 类型切换 — hero 内毛玻璃药丸 */
.type-toggle { display: flex; justify-content: center; padding-bottom: 24rpx; position: relative; z-index: 1; }
.type-bg {
  display: flex;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-full);
  padding: 6rpx;
  position: relative;
  backdrop-filter: blur(8rpx);
}
.type-slider {
  position: absolute;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  top: 6rpx;
  left: 6rpx;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  box-shadow: 0 6rpx 14rpx var(--shadow-dark);
  transition: transform 0.25s ease;
}
.type-slider.right { transform: translateX(100%); }
.type-option {
  width: 160rpx;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: var(--color-on-primary);
  opacity: 0.7;
  z-index: 1;
  transition: color 0.25s, opacity 0.25s;
  position: relative;
  font-weight: 600;
}
.type-option.active {
  color: var(--color-primary);
  opacity: 1;
  font-weight: 700;
}

/* 金额 */
.amount-chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.20);
  color: var(--color-on-primary);
  opacity: 0.85;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.amount-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 140rpx;
  padding: 8rpx 0 0;
  position: relative;
  z-index: 1;
}
.amount-field {
  display: flex;
  align-items: center;
  justify-content: center;
}
.amount-symbol {
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-bold);
  font-family: var(--font-numeric);
  color: var(--color-on-primary);
  opacity: 0.8;
  line-height: 1;
  margin-right: 12rpx;
  flex-shrink: 0;
  transform: translateY(2rpx);
}
.amount-input {
  flex: 0 1 auto;
  min-width: 200rpx;
  height: 124rpx;
  line-height: 124rpx;
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-black);
  font-family: var(--font-numeric);
  color: var(--color-on-primary);
  text-align: left;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}
.amount-placeholder {
  color: var(--color-on-primary);
  opacity: 0.4;
}

/* 日期药丸 */
.date-tag {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-full);
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: var(--color-on-primary);
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  backdrop-filter: blur(8rpx);
  transition: opacity 0.15s ease, transform 0.15s ease;
  position: relative;
  z-index: 1;
}
.date-tag--hover { opacity: 0.7; transform: scale(0.97); }
.date-tag__dot { opacity: 0.5; }
.date-tag__hint { opacity: 0.7; }

picker { display: flex; justify-content: center; }

/* ======= 分类区 ======= */
.category-section { padding: 32rpx 0 24rpx; }
.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  display: block;
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 14rpx;
}
.category-item {
  display: flex;
  width: 164rpx;
  flex: 0 0 164rpx;
}
.category-card {
  width: 100%;
  min-height: 156rpx;
  border-radius: var(--radius-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 18rpx 8rpx 16rpx;
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
}
.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--color-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  transition: background 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
}
.category-image {
  width: 52rpx;
  height: 52rpx;
  filter: brightness(0) opacity(0.5);
  transition: filter 0.22s ease;
}
.category-emoji { font-size: 44rpx; line-height: 1; }
.category-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* 选中态 — 容器染主色，图标变白 */
.category-item.selected .category-card {
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  transform: translateY(-3rpx);
}
.category-item.selected .category-icon {
  background: var(--gradient-hero);
  box-shadow: 0 12rpx 24rpx var(--shadow-dark);
  transform: translateY(-2rpx);
}
.category-item.selected .category-image {
  filter: brightness(0) invert(1) opacity(0.95);
}
.category-item.selected .category-name {
  color: var(--color-primary);
  font-weight: 700;
}

/* + 新建卡 */
.add-category .category-card {
  background: transparent;
  border: 2rpx dashed var(--color-border);
  box-shadow: none;
}
.add-category .category-icon {
  background: var(--color-primary-container);
  box-shadow: none;
}
.add-icon {
  font-size: 44rpx;
  color: var(--color-primary);
  font-weight: 300;
}

/* ======= 附加信息 chip 行（备注 / 照片 / 心情） ======= */
.extras-row {
  display: flex;
  gap: 16rpx;
  padding: 0 0 24rpx;
  flex-wrap: wrap;
}
.extras-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  min-height: 64rpx;
  transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  opacity: 0.7;
}
.extras-chip--hover {
  transform: scale(0.96);
  background: var(--color-primary-container);
}
.extras-chip.is-active {
  opacity: 1;
  background: var(--color-primary-container);
  border-color: var(--color-primary);
}
.extras-chip-icon {
  font-size: 30rpx;
  line-height: 1;
}
.extras-chip-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
.extras-chip.is-active .extras-chip-label {
  color: var(--color-primary);
}

/* 备注行内展开 */
.note-expand {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.note-expand.is-open {
  max-height: 200rpx;
}
.note-expand-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 0 24rpx;
}
.note-input {
  flex: 1;
  min-height: 64rpx;
  font-size: 30rpx;
  color: var(--color-text);
  padding: 12rpx 20rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
}
.note-placeholder { color: var(--color-text-tertiary); opacity: 0.6; }
.note-clear {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 12rpx 16rpx;
  flex-shrink: 0;
}

/* 照片预览 */
.photo-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 0 24rpx;
}
.photo-preview-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.photo-preview-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.photo-preview-action {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}
.photo-preview-action.danger {
  color: var(--color-error);
}

/* 心情选择抽屉内的网格 */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 16rpx 0 24rpx;
  justify-content: center;
}
.mood-grid-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}
.mood-grid-item.is-active {
  background: var(--gradient-hero);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx var(--shadow-dark);
  transform: scale(1.1);
}
.mood-grid-custom {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
}
.mood-grid-custom.is-active {
  font-size: 40rpx;
  color: var(--color-on-primary);
}
.mood-clear-row {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 16rpx;
}
.mood-clear-btn {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}

/* ======= 保存按钮 ======= */
.record-actions {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 230rpx;
  padding-bottom: calc(230rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
  margin-top: auto;
}
.record-actions-inner {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}
.save-btn {
  flex: 1;
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-full);
  padding: 26rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-elevated);
  letter-spacing: 2rpx;
}
.save-btn::after { border: none; }
.cancel-btn {
  width: 160rpx;
  background: transparent;
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--color-border);
}
.cancel-btn::after { border: none; }

.quick-confirm-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 1200;
  min-height: 108rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  box-shadow: 0 -18rpx 42rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  gap: 18rpx;
  transform: translateY(1rpx);
}
.quick-confirm-bar::before {
  content: '';
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.72);
}
.quick-confirm-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.quick-confirm-label {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 700;
}
.quick-confirm-meta {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quick-confirm-btn {
  width: 184rpx;
  height: 74rpx;
  line-height: 74rpx;
  padding: 0;
  border: none;
  border-radius: var(--radius-full);
  background: var(--gradient-hero);
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx var(--shadow-dark);
}
.quick-confirm-btn::after {
  border: none;
}
.quick-confirm-btn--hover {
  transform: scale(0.98);
  opacity: 0.92;
}
.quick-confirm-btn.is-disabled {
  opacity: 0.48;
  box-shadow: none;
}

/* 小橘 AI 聊天 */
.ai-chat-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transition: bottom 0.18s ease-out;
}
.ai-chat-panel {
  width: 100%;
  height: 86vh;
  max-height: 1320rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: var(--color-bg);
  box-shadow: 0 -12rpx 40rpx rgba(0,0,0,0.18);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transition: height 0.18s ease-out, border-radius 0.18s ease-out;
}
.ai-chat-panel.is-keyboard {
  height: 100%;
  max-height: none;
  border-radius: 0;
  padding-bottom: 0;
}
.ai-chat-header {
  min-height: 112rpx;
  padding: 26rpx 28rpx 20rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.ai-chat-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.ai-chat-logo,
.chat-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--color-primary-container);
  flex-shrink: 0;
  overflow: hidden;
}
.ai-chat-name {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 800;
  line-height: 1.2;
}
.ai-chat-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
}
.ai-chat-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-low);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
.ai-chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 18rpx;
  box-sizing: border-box;
}
.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.chat-row--user {
  flex-direction: row-reverse;
}
.chat-avatar-img {
  width: 100%;
  height: 100%;
}
.chat-avatar--fallback {
  background: var(--color-primary-container);
  color: var(--color-primary);
  font-size: 36rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-bubble {
  max-width: 510rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}
.chat-bubble--assistant {
  background: var(--color-surface);
  color: var(--color-text);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--color-border);
}
.chat-bubble--user {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-top-right-radius: 8rpx;
}
/* 代码回答：加宽气泡 + 等宽字体，减少折行与缩进错位 */
.chat-bubble--code {
  max-width: 620rpx;
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 22rpx;
  line-height: 1.45;
  border-left: 4rpx solid var(--color-primary);
}
.chat-bubble--typing {
  color: var(--color-text-tertiary);
  animation: juji-chat-typing 1.2s ease-in-out infinite;
}
.chat-suggestions {
  margin: -6rpx 0 24rpx 72rpx;
  max-width: 560rpx;
}
.chat-suggestions-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.chat-suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chat-suggestion-chip {
  max-width: 100%;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.05);
}
@keyframes juji-chat-typing {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.bill-draft {
  max-width: 540rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  border-top-left-radius: 8rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}
.bill-draft-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 14rpx;
}
.bill-draft-row {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.bill-draft-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-draft-cat {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.bill-draft-cat-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text);
}
.bill-draft-tag {
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.bill-draft-tag--income {
  background: rgba(76,175,80,0.16);
  color: #3a8a3e;
}
.bill-draft-tag--new {
  background: rgba(247,166,40,0.18);
  color: #d77f00;
}
.bill-draft-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.bill-draft-yuan {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.bill-draft-amount-input {
  width: 130rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}
.bill-draft-del {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-primary-container);
  flex-shrink: 0;
}
.bill-draft-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
}
.bill-draft-newcat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}
.bill-draft-check {
  width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  font-size: 20rpx;
  color: var(--color-on-primary);
  flex-shrink: 0;
}
.bill-draft-check.is-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.bill-draft-newcat-label {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.bill-draft-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
  line-height: 1.6;
}
.bill-draft-btn::after {
  border: none;
}
.bill-draft-btn--ghost {
  background: var(--color-primary-container);
  color: var(--color-text-secondary);
}
.bill-draft-btn--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}
.bill-draft-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.bill-draft-status--done {
  color: #3a8a3e;
  font-weight: 700;
}
.ai-chat-footer {
  padding: 14rpx 24rpx 22rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}
.ai-chat-notice {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
.ai-chat-input-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}
.ai-chat-input {
  flex: 1;
  min-height: 76rpx;
  max-height: 220rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-surface-low);
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 44rpx;
  border: 1rpx solid var(--color-border);
  overflow-y: auto;
  word-break: break-all;
  white-space: pre-wrap;
  transition: height 0.18s ease;
}
.ai-chat-send {
  flex-shrink: 0;
  width: 118rpx;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}
.ai-chat-send::after {
  border: none;
}
.ai-chat-send.is-disabled {
  opacity: 0.45;
}

/* ======= 自创分类弹窗 ======= */
.add-dialog-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(30, 27, 26, 0.4);
}
.add-dialog {
  position: fixed; left: 48rpx; right: 48rpx; top: 50%; z-index: 101;
  transform: translateY(-50%);
  background: var(--color-surface); border-radius: var(--radius-2xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-elevated);
}
.add-dialog-title {
  font-size: 34rpx; font-weight: 700; color: var(--color-text);
  display: block; margin-bottom: 28rpx;
}
.add-dialog-field { margin-bottom: 22rpx; }
.add-dialog-label {
  font-size: 24rpx; color: var(--color-text-secondary); font-weight: 500;
  display: block; margin-bottom: 10rpx;
}
.add-dialog-input {
  font-size: 30rpx; color: var(--color-text);
  border-bottom: 2rpx solid var(--color-border); padding: 8rpx 0;
}
.add-dialog-error {
  font-size: 22rpx; color: var(--color-error); margin-top: 6rpx; display: block;
}
.add-dialog-icon-row {
  display: flex; align-items: center; gap: 16rpx;
  background: var(--color-primary-container); border-radius: var(--radius-lg);
  padding: 16rpx 20rpx;
}
.add-dialog-icon-preview {
  font-size: 44rpx; line-height: 1; flex-shrink: 0;
}
.add-dialog-icon-hint {
  font-size: 24rpx; color: var(--color-primary); line-height: 1.4; opacity: 0.85;
}
.add-dialog-actions {
  display: flex; gap: 16rpx; margin-top: 28rpx;
}
.add-dialog-cancel {
  flex: 1; background: var(--color-surface-low); color: var(--color-text-secondary);
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 500; border: none;
  padding: 22rpx 0;
}
.add-dialog-cancel::after { border: none; }
.add-dialog-confirm {
  flex: 1; background: var(--color-primary); color: var(--color-on-primary);
  border-radius: var(--radius-full); font-size: 28rpx; font-weight: 600; border: none;
  padding: 22rpx 0;
}
.add-dialog-confirm::after { border: none; }

/* 隐私授权弹窗 */
.privacy-auth-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 10000;
  padding: 0 64rpx;
}
.privacy-auth-modal {
  width: 100%;
  max-width: 560rpx;
  background: var(--color-surface);
  border-radius: var(--radius-2xl);
  padding: 52rpx 44rpx 44rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: var(--shadow-elevated);
}
.privacy-auth-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.privacy-auth-title {
  font-size: 36rpx; font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.privacy-auth-desc {
  font-size: 28rpx; line-height: 1.6;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 36rpx;
}
.privacy-auth-btn {
  width: 100%;
  height: 88rpx;
  margin: 0 0 20rpx;
  padding: 0;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 30rpx; font-weight: 600;
  border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  border: none;
  box-shadow: var(--shadow-btn-primary);
}
.privacy-auth-btn::after { border: none; }
.privacy-auth-btn--cancel {
  background: transparent;
  color: var(--color-text-secondary);
  box-shadow: none;
  margin-bottom: 0;
}
