/* 更新日志页 —— 全部走主题 CSS 变量 */

.cl-page {
  min-height: 100vh;
  background: var(--color-bg, #fffaf8);
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
}

/* 当前版本 */
.cl-current {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--color-surface, #fff);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow-soft);
  margin-bottom: 24rpx;
}
.cl-current-left {
  display: flex;
  align-items: baseline;
}
.cl-current-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #938481);
  margin-right: 16rpx;
}
.cl-current-version {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text, #1e1b1a);
}
.cl-current-badge {
  font-size: 22rpx;
  color: var(--color-primary, #785655);
  background: var(--color-primary-container, #f7cac9);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full, 9999rpx);
}

/* 公告卡片 */
.cl-card {
  background: var(--color-surface, #fff);
  border-radius: var(--radius-lg, 24rpx);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
}
.cl-card.is-latest {
  border-left: 8rpx solid var(--color-primary, #785655);
}

.cl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.cl-card-title-wrap {
  display: flex;
  align-items: center;
}
.cl-card-version {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text, #1e1b1a);
}
.cl-card-latest {
  font-size: 20rpx;
  color: var(--color-on-primary, #fff);
  background: var(--color-primary, #785655);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm, 8rpx);
  margin-left: 12rpx;
}
.cl-card-date {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #938481);
}

.cl-card-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-secondary, #6c5a59);
  background: var(--color-surface-container, #f8efed);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full, 9999rpx);
  margin-bottom: 16rpx;
}

.cl-card-title {
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 500;
  color: var(--color-text, #1e1b1a);
  margin-bottom: 20rpx;
}

.cl-card-items {
  border-top: 2rpx solid var(--color-border, #e4d5d3);
  padding-top: 20rpx;
}
.cl-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.cl-item:last-child {
  margin-bottom: 0;
}
.cl-item-tag {
  flex: none;
  font-size: 20rpx;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm, 8rpx);
  margin-right: 12rpx;
  margin-top: 4rpx;
  color: var(--color-on-primary, #fff);
  background: var(--color-primary, #785655);
}
.cl-item-tag--feature {
  background: var(--color-primary, #785655);
}
.cl-item-tag--optimize {
  background: var(--color-tertiary, #4b6458);
}
.cl-item-tag--fix {
  background: var(--color-secondary, #6c5a59);
}
.cl-item-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #5b4d4a);
}

/* 空态 */
.cl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.cl-empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.cl-empty-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #938481);
}
