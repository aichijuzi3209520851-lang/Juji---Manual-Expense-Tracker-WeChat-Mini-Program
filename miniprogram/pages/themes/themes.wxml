<!-- 主题预览 -->
<view class="themes-page" style="{{themeStyle}}">
  <view class="themes-header">
    <text class="themes-title">选择主题</text>
    <text class="themes-hint">选一套配色，换个心情</text>
  </view>

  <!-- 预设主题 -->
  <view class="section-title">预设主题</view>
  <view wx:for="{{presetThemes}}" wx:key="id"
        class="theme-card {{currentTheme === item.id ? 'is-current' : ''}}"
        bindtap="selectTheme" data-id="{{item.id}}">
    <view class="theme-colors">
      <view class="theme-swatch" wx:for="{{item.colors}}" wx:key="name"
            wx:for-item="c" style="background: {{c.value}}"></view>
    </view>
    <view class="theme-info">
      <text class="theme-name">{{item.name}}</text>
      <text class="theme-desc">{{item.desc}}</text>
    </view>
    <view class="theme-checkmark" wx:if="{{currentTheme === item.id}}">
      <text>✓</text>
    </view>
  </view>

  <!-- 我的主题 -->
  <view class="section-title">
    我的主题 <text class="section-count">{{userThemeCount}}/{{maxUserThemes}}</text>
  </view>
  <view wx:for="{{userThemes}}" wx:key="id"
        class="theme-card {{currentTheme === item.id ? 'is-current' : ''}}"
        bindtap="selectTheme" bindlongpress="onLongPressUserTheme" data-id="{{item.id}}">
    <view class="theme-colors">
      <view class="theme-swatch" style="background: {{item.hex}}"></view>
    </view>
    <view class="theme-info">
      <text class="theme-name">{{item.name}}</text>
      <text class="theme-desc">长按删除</text>
    </view>
    <view class="theme-checkmark" wx:if="{{currentTheme === item.id}}">
      <text>✓</text>
    </view>
  </view>

  <!-- + 新建卡 -->
  <view class="theme-card create-card" bindtap="openCreatePanel">
    <view class="create-plus">+</view>
    <view class="theme-info">
      <text class="theme-name">新建自定义主题</text>
      <text class="theme-desc">最多保存 {{maxUserThemes}} 个</text>
    </view>
  </view>

  <!-- 创建面板 -->
  <view class="picker-mask {{showCreate ? 'is-open' : ''}}" catchtap="closeCreatePanel"></view>
  <view class="picker-panel {{showCreate ? 'is-open' : ''}}">
    <view class="picker-header">
      <text class="picker-title">创建自定义主题</text>
    </view>
    <view class="picker-body">
      <view class="picker-preview" style="background: {{palette[createPickerIndex].hex}}"></view>
      <picker-view class="picker-wheel" indicator-style="height: 72rpx;"
                   value="{{[createPickerIndex]}}" bindchange="onCreatePickerChange">
        <picker-view-column>
          <view class="picker-item" wx:for="{{palette}}" wx:key="hex">{{item.name}}</view>
        </picker-view-column>
      </picker-view>
    </view>
    <input class="name-input"
           placeholder="给主题取个名字（最多10字）"
           maxlength="10"
           value="{{createName}}"
           bindinput="onCreateNameInput" />
    <button class="picker-confirm" bindtap="confirmCreateTheme">保存并应用</button>
  </view>
</view>
