.themes-page {
  padding: var(--space-md);
  min-height: 100vh;
  background: var(--color-bg);
}

.themes-header {
  padding: 32rpx 8rpx 8rpx;
}
.themes-title {
  font-size: 40rpx; font-weight: 700; color: var(--color-text);
  display: block; margin-bottom: 8rpx;
}
.themes-hint {
  font-size: 24rpx; color: var(--color-text-tertiary);
}

/* section 标题 */
.section-title {
  font-size: 26rpx; font-weight: 600;
  color: var(--color-text-secondary);
  padding: 32rpx 8rpx 8rpx;
  display: flex; align-items: baseline;
}
.section-count {
  font-size: 24rpx; font-weight: 400;
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
}

.theme-card {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--color-surface); border-radius: var(--radius-xl);
  padding: var(--space-md) var(--space-lg); margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.04);
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  position: relative;
}
.theme-card.is-current {
  border-color: var(--color-primary);
  box-shadow: 0 6rpx 24rpx rgba(120,86,85,0.08);
}

.theme-colors {
  display: flex; gap: 10rpx; flex-shrink: 0;
}
.theme-swatch {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(120,86,85,0.08);
}

.theme-info { flex: 1; }
.theme-name {
  font-size: 30rpx; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 6rpx;
}
.theme-desc {
  font-size: 24rpx; color: var(--color-text-tertiary);
}

.theme-checkmark {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--color-primary); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
}

/* + 新建卡片 */
.create-card {
  border: 2rpx dashed var(--color-border);
  background: transparent;
  box-shadow: none;
}
.create-plus {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--color-primary-container);
  color: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 300;
  flex-shrink: 0;
}

/* 自定义颜色选择器弹窗 */
.picker-mask {
  position: fixed; inset: 0; z-index: 998;
  background: rgba(30, 27, 26, 0.32);
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease;
}
.picker-mask.is-open { opacity: 1; pointer-events: auto; }

.picker-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx 40rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(.32,.72,0,1);
}
.picker-panel.is-open { transform: translateY(0); }

.picker-header {
  text-align: center; margin-bottom: 24rpx;
}
.picker-title {
  font-size: 32rpx; font-weight: 700; color: var(--color-text);
}

.picker-body {
  display: flex; align-items: center; gap: 28rpx;
  margin-bottom: 24rpx;
}
.picker-preview {
  width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(120,86,85,0.10);
  transition: background 0.2s ease;
}
.picker-wheel {
  flex: 1; height: 320rpx;
}
.picker-item {
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: var(--color-text); height: 72rpx;
}

/* 名称输入框 */
.name-input {
  background: var(--color-surface-low);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx; color: var(--color-text);
  margin-bottom: 24rpx;
}

.picker-confirm {
  width: 100%; background: var(--color-primary); color: var(--color-on-primary);
  border-radius: var(--radius-full); font-size: 32rpx; font-weight: 600;
  border: none; padding: 24rpx 0;
}
.picker-confirm::after { border: none; }
