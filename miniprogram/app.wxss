page {
  --color-primary: #785655;
  --color-primary-container: #f7cac9;
  --color-primary-light: #eed7d4;
  --color-on-primary: #ffffff;
  --color-secondary: #6c5a59;
  --color-secondary-container: #f4e3e0;
  --color-tertiary: #4b6458;
  --color-tertiary-container: #c0dbcc;
  --color-error: #ba1a1a;
  --color-error-container: #ffdad6;

  --color-bg: #fffaf8;
  --color-surface: #ffffff;
  --color-surface-low: #fdf5f3;
  --color-surface-container: #f8efed;
  --color-surface-high: #f3eae8;
  --color-surface-highest: #ece2df;
  --color-surface-dim: #e7ddda;

  --color-text: #1e1b1a;
  --color-text-secondary: #5b4d4a;
  --color-text-tertiary: #938481;
  --color-text-on-primary: #ffffff;

  --color-border: #e4d5d3;
  --color-outline: #938481;

  --color-income: #4b6458;
  --color-income-light: #c0dbcc;
  --color-warning: #6c5a59;
  
  --shadow-light: rgba(255, 255, 255, 1);
  --shadow-dark: rgba(120, 86, 85, 0.15);

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-2xl: 40rpx;
  --radius-full: 9999rpx;

  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 40rpx;

  /* —— 衍生主题 token（根据 primary 自动生成，所有主题一致复用）—— */
  --gradient-hero: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent, var(--color-primary-light)) 100%);
  --gradient-hero-soft: linear-gradient(135deg, var(--color-primary-container) 0%, var(--color-primary-light) 100%);
  --shadow-soft: -8rpx -8rpx 24rpx var(--shadow-light), 8rpx 8rpx 24rpx var(--shadow-dark);
  --shadow-card: -12rpx -12rpx 32rpx var(--shadow-light), 12rpx 12rpx 32rpx var(--shadow-dark);
  --shadow-elevated: -16rpx -16rpx 48rpx var(--shadow-light), 16rpx 16rpx 48rpx var(--shadow-dark);
  --shadow-hero: 0 16rpx 40rpx var(--shadow-dark);

  /* ======= Typography Tokens ======= */
  /* 数字专属字体族（紧凑、专业） */
  --font-numeric: 'DIN Alternate', 'Helvetica Neue', Helvetica, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  /* 正文字体族 */
  --font-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  /* 字号层级 */
  --font-size-display: 96rpx;   /* 记账页核心大数字 */
  --font-size-h1: 52rpx;       /* 首页/预算/统计 核心大数字 */
  --font-size-h2: 44rpx;       /* 次级数字（足迹卡、进度环中心） */
  --font-size-h3: 36rpx;       /* 三级标题 */
  --font-size-body: 28rpx;     /* 正文 */
  --font-size-regular: 26rpx;  /* 常规文字（分类名、列表） */
  --font-size-small: 22rpx;    /* 辅助标签（单位符号、说明文本） */
  --font-size-tiny: 20rpx;     /* 最小标签 */

  /* 字重层级 */
  --font-weight-black: 800;    /* 核心数字 */
  --font-weight-bold: 700;     /* 大数字 */
  --font-weight-semibold: 600; /* 标签 */
  --font-weight-medium: 500;   /* 次级 */
  --font-weight-regular: 400;  /* 正文 */

  /* 行高 */
  --line-height-tight: 1.1;
  --line-height-normal: 1.4;
  --line-height-relaxed: 1.6;

  /* 复合变量（兼容旧代码） */
  --font-hero: var(--font-weight-black) var(--font-size-display)/var(--line-height-tight) var(--font-numeric);
  --font-headline-lg: var(--font-weight-bold) var(--font-size-h1)/var(--line-height-tight) var(--font-numeric);
  --font-headline-md: var(--font-weight-semibold) var(--font-size-h3)/var(--line-height-normal) var(--font-body);
  --font-body-lg: var(--font-weight-regular) var(--font-size-body)/var(--line-height-relaxed) var(--font-body);
  --font-body-md: var(--font-weight-regular) var(--font-size-body)/var(--line-height-normal) var(--font-body);
  --font-label: var(--font-weight-semibold) var(--font-size-small)/var(--line-height-normal) var(--font-body);

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-md);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-full);
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 4rpx 8rpx 20rpx var(--shadow-dark);
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
}

.card-elevated {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-elevated);
  padding: var(--space-md);
}
