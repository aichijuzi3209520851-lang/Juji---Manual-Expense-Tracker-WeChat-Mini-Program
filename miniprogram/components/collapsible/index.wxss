.collapsible {
  border-radius: 24rpx;
  background: var(--color-surface, #ffffff);
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}

.collapsible.is-expanded {
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(0,0,0,0.04));
}

.collapsible-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}

.collapsible-head--hover {
  background: var(--color-primary-container, #f5f5f5);
}

.collapsible-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.collapsible-icon {
  font-size: 32rpx;
  line-height: 1;
}

.collapsible-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text, #1a1a1a);
  line-height: 1.3;
}

.collapsible-meta {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #999);
  margin-left: 8rpx;
}

.collapsible-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.collapsible-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary, #999);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  transform: rotate(0deg);
  display: inline-block;
  line-height: 1;
}

.collapsible-arrow.is-open {
  transform: rotate(90deg);
}

.collapsible-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.collapsible-body-inner {
  padding: 0 28rpx 28rpx 28rpx;
}
