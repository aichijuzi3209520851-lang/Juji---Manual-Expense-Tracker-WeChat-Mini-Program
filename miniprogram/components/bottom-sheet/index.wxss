.sheet-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  pointer-events: auto;
}

.sheet-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.25s ease;
}

.sheet-mask.is-in {
  background: rgba(0, 0, 0, 0.45);
}

.sheet-mask.is-out {
  background: rgba(0, 0, 0, 0);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* v31：组件是 styleIsolation: isolated，页面/app 的类选择器进不来，
     但 **CSS 自定义属性是继承的**，所以直接在这里消费 --lg-fill-strong 即可。
     原来写死的 --color-surface（不透明实白）在玻璃主题下会在记账页底部
     摊出一块「白板」，与整屏玻璃断裂 —— 这是放大截图里最刺眼的一处破材质。
     旧主题没有 --lg-fill-strong（__default 下它退化为 surface 原值），观感不变。 */
  background-color: var(--lg-fill-strong, var(--color-surface, #ffffff));
  background-image: var(--lg-specular, none), var(--lg-refract, none);
  background-repeat: no-repeat, no-repeat;
  background-size: 100% 100%, 100% 100%;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08), var(--lg-edge-card, none);
  outline: var(--lg-rim-width-thin, 0) solid var(--lg-rim-outline, transparent);
  outline-offset: -1rpx;
  -webkit-backdrop-filter: var(--lg-tabbar-blur, none);
  backdrop-filter: var(--lg-tabbar-blur, none);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  max-height: 90vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet.is-open {
  transform: translateY(0);
}

.sheet.is-close {
  transform: translateY(100%);
}

.sheet--small {
  height: 40vh;
}

.sheet--medium {
  height: 60vh;
}

.sheet--large {
  height: 75vh;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: var(--color-border, #e0e0e0);
  border-radius: 4rpx;
  margin: 16rpx auto 0;
  flex-shrink: 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text, #1a1a1a);
}

.sheet-close {
  font-size: 48rpx;
  color: var(--color-text-tertiary, #999);
  line-height: 1;
  padding: 8rpx;
  min-width: 64rpx;
  text-align: center;
}

.sheet-body {
  flex: 1;
  padding: 0 32rpx;
  min-height: 0;
}

.sheet-footer {
  padding: 20rpx 32rpx 28rpx;
  flex-shrink: 0;
  border-top: 1rpx solid var(--color-border, #eee);
}
