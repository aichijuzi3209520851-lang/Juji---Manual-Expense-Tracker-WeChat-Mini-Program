.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.custom-tabbar__shell {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr 1.24fr 1fr 1fr;
  align-items: end;
  gap: 8rpx;
  min-height: 152rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 36rpx;
  background: var(--color-surface, rgba(255, 255, 255, 0.84));
  border: 1rpx solid var(--color-border, rgba(120, 86, 85, 0.1));
  box-shadow: 0 24rpx 46rpx rgba(0, 0, 0, 0.10);
  backdrop-filter: blur(24rpx);
  pointer-events: auto;
}

.custom-tabbar__shell::before {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.72);
}

.custom-tabbar__item,
.custom-tabbar__primary {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.custom-tabbar__item {
  min-height: 106rpx;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.custom-tabbar__item--hover {
  opacity: 0.88;
}

.custom-tabbar__primary--hover .custom-tabbar__primary-button,
.custom-tabbar__item--hover .custom-tabbar__icon-wrap {
  transform: translateY(-2rpx);
}

.custom-tabbar__item.is-active {
  transform: translateY(-6rpx);
}

.custom-tabbar__icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f3f2;
  border: 1rpx solid rgba(120, 86, 85, 0.05);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  transition: background 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
}

.custom-tabbar__item.is-active .custom-tabbar__icon-wrap {
  background: linear-gradient(180deg, rgba(247, 202, 201, 0.94), rgba(244, 227, 224, 0.96));
  border-color: rgba(120, 86, 85, 0.08);
  box-shadow: 0 12rpx 24rpx rgba(120, 86, 85, 0.1);
  transform: translateY(-2rpx);
}

.custom-tabbar__icon {
  width: 46rpx;
  height: 46rpx;
}

.custom-tabbar__label {
  font-size: 21rpx;
  line-height: 1;
  color: #8c7c79;
  font-weight: 500;
  transition: color 0.22s ease;
}

.custom-tabbar__item.is-active .custom-tabbar__label {
  color: #785655;
  font-weight: 600;
}

.custom-tabbar__primary {
  transform: translateY(-20rpx);
}

.custom-tabbar__primary-button {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8d8d7 0%, #efbfbe 100%);
  border: 8rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 32rpx rgba(120, 86, 85, 0.18);
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
}

.custom-tabbar__primary.is-active .custom-tabbar__primary-button {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0 22rpx 38rpx rgba(120, 86, 85, 0.22);
  background: linear-gradient(180deg, #f7caca 0%, #ecb6b5 100%);
}

.custom-tabbar__primary-plus {
  color: #785655;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 300;
  margin-top: -4rpx;
}

.custom-tabbar__label--primary {
  color: #785655;
  font-weight: 700;
}
